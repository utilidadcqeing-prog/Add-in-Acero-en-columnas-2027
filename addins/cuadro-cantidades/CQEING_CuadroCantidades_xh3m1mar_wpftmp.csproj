  <PropertyGroup>
    <AssemblyName>CQEING_CuadroCantidades</AssemblyName>
    <IntermediateOutputPath>obj\Release\</IntermediateOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>C:\Users\PC\Downloads\trabajo1\CQEING-Addins\addins\cuadro-cantidades\obj\</MSBuildProjectExtensionsPath>
    <_TargetAssemblyProjectName>CQEING_CuadroCantidades</_TargetAssemblyProjectName>
    <RootNamespace>CQEING_CuadroCantidades</RootNamespace>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <!-- Año de Revit, framework, API por NuGet y salida bin/<config>/<año>/: addins/Directory.Build.props. -->
  <PropertyGroup>
    <RootNamespace>CQEING_CuadroCantidades</RootNamespace>
    <Version>1.8.0</Version>
    <Company>CQEING</Company>
    <Product>CQEING - Cuadro de cantidades</Product>
    <Copyright>© CQEING</Copyright>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Revit no resuelve runtimes\<rid>\native vía deps.json: fijar el RID copia e_sqlite3.dll junto al add-in. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Resources\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="CQEING_CuadroCantidades.addin" CopyToOutputDirectory="PreserveNewest" />
    <!-- Los documentos de diseño viven junto al código, pero no van en el paquete. -->
    <None Remove="docs\**;prisma\**;*.md" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
