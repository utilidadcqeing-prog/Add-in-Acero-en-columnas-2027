<Window
  x:Class="CQEING_CuadroCantidades.UI.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:CQEING_CuadroCantidades.UI"
  Title="Cuadro de Cantidades"
  Width="1280"
  Height="760"
  MinWidth="980"
  MinHeight="560"
  Background="#F8FAFC"
  WindowStartupLocation="CenterOwner"
>
  <Window.Resources>
    <local:ImagePathToBitmapConverter x:Key="ImagePathToBitmapConverter" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- SPINNER DE CARGA                                     -->
    <!-- ═══════════════════════════════════════════════════ -->
    <ControlTemplate x:Key="SpinnerTemplate">
      <Viewbox Width="40" Height="40">
        <Canvas Width="100" Height="100">
          <Ellipse Width="80" Height="80" Stroke="#E2E8F0" StrokeThickness="8" Canvas.Left="10" Canvas.Top="10" />
          <Path Stroke="#3B82F6" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Canvas.Left="10" Canvas.Top="10"
                Data="M 40,0 A 40,40 0 0,1 80,40">
            <Path.RenderTransform>
              <RotateTransform x:Name="Rotate" CenterX="40" CenterY="40" Angle="0" />
            </Path.RenderTransform>
            <Path.Triggers>
              <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Rotate" Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever" />
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Path.Triggers>
          </Path>
        </Canvas>
      </Viewbox>
    </ControlTemplate>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ESTILO BASE DE BOTONES MODERNOS (TOOLBAR)            -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="ToolbarButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="38" />
      <Setter Property="MinWidth" Value="106" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="btnBorder"
                    Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.06" Color="#000000" />
              </Border.Effect>
              <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
              />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85" />
                <Setter TargetName="btnBorder" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.12" Color="#000000" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="btnBorder" Property="Opacity" Value="0.72" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="btnBorder" Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- TÍTULO DE PANEL                                      -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#1E293B" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ESTILO DE FILAS DEL DATAGRID (BUDGET)                -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="BudgetGridRowStyle" TargetType="DataGridRow">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#F1F5F9" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Style.Triggers>
        <!-- Accordion: Ocultar filas colapsadas -->
        <DataTrigger Binding="{Binding IsRowVisible}" Value="False">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <!-- Capítulo -->
        <DataTrigger Binding="{Binding Type}" Value="CAPITULO">
          <Setter Property="Background" Value="#EFF6FF" />
          <Setter Property="FontWeight" Value="Bold" />
          <Setter Property="Foreground" Value="#1E3A5F" />
          <Setter Property="BorderBrush" Value="#DBEAFE" />
        </DataTrigger>
        <!-- Subcapítulo -->
        <DataTrigger Binding="{Binding Type}" Value="SUBCAPITULO">
          <Setter Property="Background" Value="#F8FAFF" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="Foreground" Value="#2B5278" />
          <Setter Property="BorderBrush" Value="#EDF2F7" />
        </DataTrigger>
        <!-- Actividad -->
        <DataTrigger Binding="{Binding Type}" Value="ACTIVIDAD">
          <Setter Property="Background" Value="White" />
          <Setter Property="Foreground" Value="#334155" />
        </DataTrigger>
        <!-- Hover -->
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#F1F5F9" />
        </Trigger>
        <!-- Selección -->
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#DBEAFE" />
          <Setter Property="Foreground" Value="#1E3A5F" />
        </Trigger>
        <!-- Detalles Row Visibility -->
        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
          <Setter Property="DetailsVisibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
          <Setter Property="DetailsVisibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ESTILO DE CELDAS DEL DATAGRID                        -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="BudgetCellStyle" TargetType="DataGridCell">
      <Setter Property="BorderBrush" Value="#F1F5F9" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Foreground" Value="#1E3A5F" />
          <Setter Property="Background" Value="Transparent" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ESTILO BOTÓN ACCIONES (DETALLES)                     -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="ActionButtonStyle" TargetType="Button">
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Background" Value="#3B82F6" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="actionBorder"
                    Background="{TemplateBinding Background}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="actionBorder" Property="Background" Value="#2563EB" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="actionBorder" Property="Background" Value="#1D4ED8" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ESTILO BOTONES PANEL DERECHO                         -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="StructureButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinWidth" Value="104" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="structBorder"
                    Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="structBorder" Property="Opacity" Value="0.85" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="structBorder" Property="Opacity" Value="0.72" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ESTILO BOTÓN TOGGLE EXPAND/COLLAPSE                  -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="ExpandToggleStyle" TargetType="Button">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="toggleBorder"
                    Background="Transparent"
                    CornerRadius="3"
                    Width="20" Height="20">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="toggleBorder" Property="Background" Value="#E2E8F0" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <DockPanel LastChildFill="True">

      <!-- ═══════════════════════════════════════════════════ -->
      <!-- BARRA DE HERRAMIENTAS                               -->
      <!-- ═══════════════════════════════════════════════════ -->
      <Border
        Margin="16,12,16,0"
        Padding="14,10"
        Background="White"
        CornerRadius="10"
        DockPanel.Dock="Top"
      >
        <Border.Effect>
          <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.06" Color="#000000" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
          <!-- Grupo: Estructura -->
          <Button
            Background="#F59E0B"
            Command="{Binding SelectStructureCommand}"
            Style="{StaticResource ToolbarButtonStyle}"
          >
            <TextBlock LineHeight="15" Text="Cargar" TextAlignment="Center" FontSize="11.5" />
          </Button>
          <Button
            Background="#3B82F6"
            Command="{Binding UpdateStructureCommand}"
            Style="{StaticResource ToolbarButtonStyle}"
          >
            <TextBlock LineHeight="15" Text="Actualizar" TextAlignment="Center" FontSize="11.5" />
          </Button>

          <!-- Separador visual -->
          <Rectangle Width="1" Height="26" Fill="#E2E8F0" Margin="6,0,14,0" VerticalAlignment="Center" />

          <!-- Grupo: Guardar -->
          <Button
            Background="#10B981"
            Command="{Binding SaveModelCommand}"
            Content="Guardar Modelo"
            Style="{StaticResource ToolbarButtonStyle}"
          />

          <!-- Separador visual -->
          <Rectangle Width="1" Height="26" Fill="#E2E8F0" Margin="6,0,14,0" VerticalAlignment="Center" />

          <!-- Grupo: Exportar / Limpiar -->
          <Button
            Background="#3B82F6"
            Command="{Binding ExportStructureCommand}"
            Content="Exportar"
            Style="{StaticResource ToolbarButtonStyle}"
          />
          <Button
            Background="#D97706"
            Command="{Binding ClearElementsCommand}"
            Content="Limpiar Estructura"
            Style="{StaticResource ToolbarButtonStyle}"
          />
          <Button
            Background="#EF4444"
            Command="{Binding ClearStructureCommand}"
            Content="Limpiar Todo"
            Style="{StaticResource ToolbarButtonStyle}"
          />

          <!-- Separador visual -->
          <Rectangle Width="1" Height="26" Fill="#E2E8F0" Margin="6,0,14,0" VerticalAlignment="Center" />

          <!-- Grupo: Vinculación -->
          <Button
            Background="#6366F1"
            Command="{Binding LinkModelCommand}"
            Style="{StaticResource ToolbarButtonStyle}"
            ToolTip="Asociar el modelo de Revit actual a este presupuesto"
          >
            <TextBlock LineHeight="15" Text="Vincular Modelo" TextAlignment="Center" FontSize="11.5" />
          </Button>
          <Button
            Background="#EF4444"
            Command="{Binding UnlinkModelCommand}"
            Style="{StaticResource ToolbarButtonStyle}"
            ToolTip="Desvincular el presupuesto de cualquier modelo de Revit"
          >
            <TextBlock LineHeight="15" Text="Desvincular Modelo" TextAlignment="Center" FontSize="11.5" />
          </Button>
        </StackPanel>
      </Border>

      <!-- ═══════════════════════════════════════════════════ -->
      <!-- BARRA DE VÍNCULO DE PRESUPUESTO-MODELO              -->
      <!-- ═══════════════════════════════════════════════════ -->
      <Border
        Margin="16,10,16,0"
        Padding="14,10"
        Background="White"
        CornerRadius="10"
        DockPanel.Dock="Top"
        Visibility="{Binding IsBudgetLoaded, Converter={StaticResource BooleanToVisibilityConverter}}"
      >
        <Border.Effect>
          <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.06" Color="#000000" />
        </Border.Effect>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          
          <!-- Estado de Vinculación (Izquierda) -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Data="M3.9,12C3.9,10.29 5.29,8.9 7,8.9H11V7H7A5,5 0 0,0 2,12A5,5 0 0,0 7,17H11V15.1H7C5.29,15.1 3.9,13.71 3.9,12M8,13H16V11H8V13M17,7H13V8.9H17C18.71,8.9 20.1,10.29 20.1,12C20.1,13.71 18.71,15.1 17,15.1H13V17H17A5,5 0 0,0 22,12A5,5 0 0,0 17,7Z"
                  Fill="#6366F1" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="Vínculo de Modelo: " Foreground="#1E293B" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ModelBindingStatusText}" Foreground="#475569" FontSize="11.5" VerticalAlignment="Center"/>
          </StackPanel>
          
          <!-- Botones de Acción eliminados de aquí (reubicados en el ribbon superior) -->
        </Grid>
      </Border>

      <!-- ═══════════════════════════════════════════════════ -->
      <!-- BANNER DE ERROR DE RED                              -->
      <!-- ═══════════════════════════════════════════════════ -->
      <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" Padding="12,8" Margin="16,10,16,0" CornerRadius="8" DockPanel.Dock="Top"
              Visibility="{Binding ShowNetworkError, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10,10-4.48,10-10S17.52,2,12,2zm1,15h-2v-2h2v2zm0-4h-2V7h2v6z"
                  Fill="#EF4444" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding NetworkErrorMessage}" Foreground="#DC2626" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
          <Button Grid.Column="1" Content="✕" Command="{Binding DismissNetworkErrorCommand}"
                  Background="Transparent" BorderThickness="0" Foreground="#EF4444" FontWeight="Bold" FontSize="14" Cursor="Hand" Padding="6,2" VerticalAlignment="Center">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="closeBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="closeBorder" Property="Background" Value="#FEE2E2" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </Grid>
      </Border>

      <!-- ═══════════════════════════════════════════════════ -->
      <!-- CONTENIDO PRINCIPAL                                 -->
      <!-- ═══════════════════════════════════════════════════ -->
      <Grid Margin="16,12,16,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" MinWidth="640" />
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="1.45*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- ═════════════════════════════════════════════ -->
        <!-- PANEL IZQUIERDO: ESTRUCTURA DEL PRESUPUESTO  -->
        <!-- ═════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="0">
          <Border.Effect>
            <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.06" Color="#000000" />
          </Border.Effect>
          <DockPanel LastChildFill="True">
            <!-- Header del panel -->
            <Border DockPanel.Dock="Top" Padding="16,12" Background="#FAFBFC" CornerRadius="10,10,0,0" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
              <TextBlock
                Foreground="#1E293B"
                FontSize="13"
                FontWeight="SemiBold"
                Text="{Binding LoadedStructureName, StringFormat=Estructura: {0}}"
              />
            </Border>

            <!-- DataGrid -->
            <DataGrid
              AutoGenerateColumns="False"
              Background="White"
              BorderThickness="0"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserSortColumns="False"
              CellStyle="{StaticResource BudgetCellStyle}"
              FrozenColumnCount="1"
              GridLinesVisibility="None"
              HeadersVisibility="Column"
              IsReadOnly="True"
              ItemsSource="{Binding BudgetRows}"
              RowHeight="30"
              RowStyle="{StaticResource BudgetGridRowStyle}"
              SelectedItem="{Binding SelectedBudgetRow, Mode=TwoWay}"
              VirtualizingPanel.ScrollUnit="Pixel"
            >
              <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                  <Setter Property="Background" Value="#1E3A5F" />
                  <Setter Property="Foreground" Value="White" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="FontSize" Value="12" />
                  <Setter Property="Padding" Value="12,8" />
                  <Setter Property="BorderBrush" Value="#2B5278" />
                  <Setter Property="BorderThickness" Value="0,0,1,0" />
                </Style>
              </DataGrid.ColumnHeaderStyle>
              <DataGrid.Columns>
                <!-- Tipo -->
                <DataGridTemplateColumn Width="110" Header="Tipo">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="#F1F5F9" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Type}" Value="CAPITULO">
                                <Setter Property="Background" Value="#DBEAFE" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Type}" Value="SUBCAPITULO">
                                <Setter Property="Background" Value="#E0E7FF" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Type}" Value="ACTIVIDAD">
                                <Setter Property="Background" Value="#F0FDF4" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="SemiBold">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="#64748B" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Type}" Value="CAPITULO">
                                  <Setter Property="Foreground" Value="#1E3A5F" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Type}" Value="SUBCAPITULO">
                                  <Setter Property="Foreground" Value="#3730A3" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Type}" Value="ACTIVIDAD">
                                  <Setter Property="Foreground" Value="#166534" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Código -->
                <DataGridTextColumn Width="150" Binding="{Binding Code}" Header="Código" />

                <!-- Descripción con Accordion Toggle -->
                <DataGridTemplateColumn Width="2.4*" Header="Descripción">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Botón Expand/Collapse (solo para CAPITULO y SUBCAPITULO) -->
                        <Button
                          Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}"
                        >
                          <Button.Style>
                            <Style BasedOn="{StaticResource ExpandToggleStyle}" TargetType="Button">
                              <Setter Property="Visibility" Value="Visible" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="3">
                                  <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                          <TextBlock FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#64748B" />
                                <Setter Property="Text" Value="▼" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                    <Setter Property="Text" Value="▶" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Button>

                        <!-- Texto de descripción con indentación -->
                        <TextBlock
                          VerticalAlignment="Center"
                          Text="{Binding Description}"
                          TextTrimming="CharacterEllipsis"
                        >
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Margin" Value="0,0,0,0" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="1">
                                  <Setter Property="Margin" Value="18,0,0,0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="2">
                                  <Setter Property="Margin" Value="36,0,0,0" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Unidad -->
                <DataGridTextColumn Width="70" Binding="{Binding Unit}" Header="Und" />

                <!-- Cantidad -->
                <DataGridTextColumn Width="90" Binding="{Binding Quantity}" Header="Cantidad" />

                <!-- Acciones -->
                <DataGridTemplateColumn Width="120" Header="Acciones">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button Content="Detalles" Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                          <Button.Style>
                            <Style BasedOn="{StaticResource ActionButtonStyle}" TargetType="Button">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding CanEdit}" Value="True">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>

              <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                  <!-- Element Preview Container -->
                  <Border x:Name="ElementsPreviewBorder" Background="#F8FAFC" Padding="54,12,16,16" BorderThickness="0"
                          Visibility="Visible">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                      </Grid.RowDefinitions>

                      <!-- Imagen de Vista Previa (Collage) -->
                      <Grid Grid.Row="0" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,16"
                            Visibility="{Binding HasAnyCollageImages, Converter={StaticResource BooleanToVisibilityConverter}}">
                          
                          <!-- Caso 1: Una Sola Imagen -->
                          <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8"
                                  Visibility="{Binding HasSingleCollageImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                              <Image Source="{Binding CollageImage1, Converter={StaticResource ImagePathToBitmapConverter}}" Stretch="Uniform" Margin="4"/>
                          </Border>

                          <!-- Caso 2: Dos Imágenes -->
                          <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="4" Height="240"
                                  Visibility="{Binding Has2CollageImages, Converter={StaticResource BooleanToVisibilityConverter}}">
                              <Grid>
                                  <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*"/>
                                      <ColumnDefinition Width="*"/>
                                  </Grid.ColumnDefinitions>
                                  <Border Grid.Column="0" CornerRadius="4" ClipToBounds="True" Margin="0,0,2,0">
                                      <Image Source="{Binding CollageImage1, Converter={StaticResource ImagePathToBitmapConverter}}" Stretch="Uniform"/>
                                  </Border>
                                  <Border Grid.Column="1" CornerRadius="4" ClipToBounds="True" Margin="2,0,0,0">
                                      <Image Source="{Binding CollageImage2, Converter={StaticResource ImagePathToBitmapConverter}}" Stretch="Uniform"/>
                                  </Border>
                              </Grid>
                          </Border>

                          <!-- Caso 3: Tres Imágenes -->
                          <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="4" Height="300"
                                  Visibility="{Binding Has3CollageImages, Converter={StaticResource BooleanToVisibilityConverter}}">
                              <Grid>
                                  <Grid.RowDefinitions>
                                      <RowDefinition Height="*"/>
                                      <RowDefinition Height="*"/>
                                  </Grid.RowDefinitions>
                                  <Border Grid.Row="0" CornerRadius="4" ClipToBounds="True" Margin="0,0,0,2">
                                      <Image Source="{Binding CollageImage1, Converter={StaticResource ImagePathToBitmapConverter}}" Stretch="Uniform"/>
                                  </Border>
                                  <Grid Grid.Row="1" Margin="0,2,0,0">
                                      <Grid.ColumnDefinitions>
                                          <ColumnDefinition Width="*"/>
                                          <ColumnDefinition Width="*"/>
                                      </Grid.ColumnDefinitions>
                                      <Border Grid.Column="0" CornerRadius="4" ClipToBounds="True" Margin="0,0,2,0">
                                          <Image Source="{Binding CollageImage2, Converter={StaticResource ImagePathToBitmapConverter}}" Stretch="Uniform"/>
                                      </Border>
                                      <Border Grid.Column="1" CornerRadius="4" ClipToBounds="True" Margin="2,0,0,0">
                                          <Image Source="{Binding CollageImage3, Converter={StaticResource ImagePathToBitmapConverter}}" Stretch="Uniform"/>
                                      </Border>
                                  </Grid>
                              </Grid>
                          </Border>

                          <!-- Caso 4: Cuatro o más Imágenes -->
                          <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="4" Height="300"
                                  Visibility="{Binding Has4OrMoreCollageImages, Converter={StaticResource BooleanToVisibilityConverter}}">
                              <Grid>
                                  <Grid.RowDefinitions>
                                      <RowDefinition Height="*"/>
                                      <RowDefinition Height="*"/>
                                  </Grid.RowDefinitions>
                                  <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*"/>
                                      <ColumnDefinition Width="*"/>
                                  </Grid.ColumnDefinitions>
                                  
                                  <Border Grid.Row="0" Grid.Column="0" CornerRadius="4" ClipToBounds="True" Margin="0,0,2,2">
                                      <Image Source="{Binding CollageImage1, Converter={StaticResource ImagePathToBitmapConverter}}" Stretch="Uniform"/>
                                  </Border>
                                  <Border Grid.Row="0" Grid.Column="1" CornerRadius="4" ClipToBounds="True" Margin="2,0,0,2">
                                      <Image Source="{Binding CollageImage2, Converter={StaticResource ImagePathToBitmapConverter}}" Stretch="Uniform"/>
                                  </Border>
                                  <Border Grid.Row="1" Grid.Column="0" CornerRadius="4" ClipToBounds="True" Margin="0,2,2,0">
                                      <Image Source="{Binding CollageImage3, Converter={StaticResource ImagePathToBitmapConverter}}" Stretch="Uniform"/>
                                  </Border>
                                  
                                  <Border Grid.Row="1" Grid.Column="1" CornerRadius="4" ClipToBounds="True" Margin="2,2,0,0">
                                      <Grid>
                                          <Image Source="{Binding CollageImage4, Converter={StaticResource ImagePathToBitmapConverter}}" Stretch="Uniform"/>
                                          <!-- Overlay para +N -->
                                          <Border Background="#99000000" Visibility="{Binding HasMoreThan4CollageImages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                              <TextBlock Text="{Binding MoreImagesText}" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                          </Border>
                                      </Grid>
                                  </Border>
                              </Grid>
                          </Border>

                      </Grid>

                      <!-- Tabla de Elementos -->
                      <Border Grid.Row="1" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Background="White" ClipToBounds="True">
                          <Border.Effect>
                              <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.08" Color="Black"/>
                          </Border.Effect>
                          <DataGrid ItemsSource="{Binding AssignedElementsTable}" 
                                    AutoGenerateColumns="True" IsReadOnly="True"
                                    CanUserSortColumns="False" CanUserReorderColumns="False"
                                    Background="White" BorderThickness="0"
                                    HeadersVisibility="Column" GridLinesVisibility="All" RowHeight="26"
                                    AutoGeneratingColumn="DataGrid_AutoGeneratingColumn"
                                    IsHitTestVisible="False" Focusable="False">
                              <DataGrid.ColumnHeaderStyle>
                                  <Style TargetType="DataGridColumnHeader">
                                      <Setter Property="Background" Value="#F1F5F9"/>
                                      <Setter Property="Foreground" Value="#334155"/>
                                      <Setter Property="FontWeight" Value="SemiBold"/>
                                      <Setter Property="FontSize" Value="11"/>
                                      <Setter Property="Padding" Value="10,6"/>
                                      <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                      <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                  </Style>
                              </DataGrid.ColumnHeaderStyle>
                              <DataGrid.RowStyle>
                                  <Style TargetType="DataGridRow">
                                      <Setter Property="Background" Value="White" />
                                      <Setter Property="Foreground" Value="#475569" />
                                      <Setter Property="FontSize" Value="11" />
                                      <Style.Triggers>
                                          <!-- Resaltar fila de TOTAL -->
                                          <DataTrigger Binding="{Binding [No.]}" Value="TOTAL">
                                              <Setter Property="Background" Value="#F8FAFC" />
                                              <Setter Property="FontWeight" Value="Bold" />
                                              <Setter Property="Foreground" Value="#1E293B" />
                                          </DataTrigger>
                                      </Style.Triggers>
                                  </Style>
                              </DataGrid.RowStyle>
                          </DataGrid>
                      </Border>

                    </Grid>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding AssignedElementsTable}" Value="{x:Null}">
                      <Setter TargetName="ElementsPreviewBorder" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding AssignedElementsTable.Rows.Count}" Value="0">
                      <Setter TargetName="ElementsPreviewBorder" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </DataGrid.RowDetailsTemplate>

            </DataGrid>
          </DockPanel>
        </Border>

        <!-- ═════════════════════════════════════════════ -->
        <!-- PANEL DERECHO: ELEMENTOS NO ASIGNADOS        -->
        <!-- ═════════════════════════════════════════════ -->
        <Border
          Grid.Column="2"
          Padding="16"
          Background="White"
          CornerRadius="10"
        >
          <Border.Effect>
            <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.06" Color="#000000" />
          </Border.Effect>
          <Grid>
            <DockPanel LastChildFill="True">
              <!-- Header -->
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock
                  DockPanel.Dock="Left"
                  Style="{StaticResource PanelTitleStyle}"
                  Text="Elementos no asignados"
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                />
                <Button
                  DockPanel.Dock="Right"
                  HorizontalAlignment="Right"
                  Background="#10B981"
                  Command="{Binding AssignElementsCommand}"
                  Content="Asignar a Actividad"
                  Style="{StaticResource StructureButtonStyle}"
                />
              </DockPanel>

              <!-- ListView de elementos -->
              <Border CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Background="#FAFBFC">
                <ListView
                  x:Name="UnassignedElementsListView"
                  BorderThickness="0"
                  Background="Transparent"
                  ItemsSource="{Binding UnassignedElements}"
                  SelectionMode="Extended"
                  SelectionChanged="ListView_SelectionChanged"
                >
                  <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                      <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                      <Setter Property="Padding" Value="4,2" />
                      <Setter Property="BorderBrush" Value="#F1F5F9" />
                      <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                  </ListView.ItemContainerStyle>
                  <ListView.View>
                    <GridView>
                      <GridViewColumn
                        Width="120"
                        DisplayMemberBinding="{Binding Category}"
                        Header="Categoría"
                      />
                      <GridViewColumn
                        Width="150"
                        DisplayMemberBinding="{Binding Name}"
                        Header="Elemento"
                      />
                      <GridViewColumn Width="70" DisplayMemberBinding="{Binding ElementId}" Header="Id" />
                    </GridView>
                  </ListView.View>
                </ListView>
              </Border>
            </DockPanel>
          </Grid>
        </Border>
      </Grid>
    </DockPanel>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- OVERLAY DE CARGA                                    -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Grid Background="#66000000" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Border Background="White" CornerRadius="12" Padding="32,24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect>
          <DropShadowEffect ShadowDepth="2" BlurRadius="16" Opacity="0.12" Color="#000000" />
        </Border.Effect>
        <StackPanel HorizontalAlignment="Center">
          <ContentControl Template="{StaticResource SpinnerTemplate}" HorizontalAlignment="Center" />
          <TextBlock Text="Cargando y Sincronizando..." Margin="0,14,0,0" FontWeight="SemiBold" Foreground="#334155" FontSize="13" HorizontalAlignment="Center" />
          <TextBlock Text="Por favor espere un momento" Margin="0,4,0,0" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
