<Window
  x:Class="CQEING_CuadroCantidades.UI.Views.SelectStructureWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Seleccionar Estructura"
  Width="600"
  Height="480"
  MinWidth="480"
  MinHeight="380"
  Background="#F8FAFC"
  WindowStartupLocation="CenterOwner"
  Loaded="Window_Loaded"
  PreviewKeyDown="Window_PreviewKeyDown"
  LocationChanged="Window_LocationChanged"
  Deactivated="Window_Deactivated"
>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!-- Modern Button Style -->
    <Style x:Key="ModernButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinWidth" Value="90"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="border" Property="Opacity" Value="0.72"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Search Box Container Style: resalta el borde al recibir el foco -->
    <Style x:Key="SearchContainerStyle" TargetType="Border">
      <Setter Property="Height" Value="38"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="#F8FAFC"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="Background" Value="White"/>
          <Setter Property="BorderBrush" Value="#3B82F6"/>
          <Setter Property="Effect">
            <Setter.Value>
              <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="0.25" Color="#3B82F6"/>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Clear Search Button Style -->
    <Style x:Key="ClearSearchButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="ToolTip" Value="Limpiar búsqueda (Esc)"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="circle" Background="#E2E8F0" CornerRadius="11">
              <Path x:Name="cross"
                    Width="8" Height="8"
                    Data="M0,0 L8,8 M8,0 L0,8"
                    Stroke="#64748B" StrokeThickness="1.6"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="circle" Property="Background" Value="#CBD5E1"/>
                <Setter TargetName="cross" Property="Stroke" Value="#1E293B"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Suggestion Item Style: resaltado suave con barra de acento a la izquierda -->
    <Style x:Key="SuggestionItemStyle" TargetType="ListBoxItem">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="itemBorder" Background="Transparent" CornerRadius="6" Margin="0,1">
              <Grid>
                <Border x:Name="accent" Width="3" CornerRadius="2" Margin="0,6"
                        HorizontalAlignment="Left" Background="#3B82F6" Visibility="Collapsed"/>
                <ContentPresenter Margin="12,7,12,7"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="itemBorder" Property="Background" Value="#F1F5F9"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="itemBorder" Property="Background" Value="#EFF6FF"/>
                <Setter TargetName="accent" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <!-- Card Wrapper -->
    <Border Background="White" CornerRadius="8" Padding="20">
      <Border.Effect>
        <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.08" Color="Black"/>
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock
          Grid.Row="0"
          Margin="0,0,0,14"
          FontSize="15"
          FontWeight="SemiBold"
          Foreground="#1E293B"
          Text="Seleccionar Estructura desde Base de Datos"
        />

        <!-- Search Box with Autocomplete -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
          <Border x:Name="SearchBorder" Style="{StaticResource SearchContainerStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!-- Magnifier Icon -->
              <Path
                Grid.Column="0"
                Width="14"
                Height="14"
                Data="M6.5,0 A6.5,6.5 0 1 1 6.5,13 A6.5,6.5 0 1 1 6.5,0 M11.2,11.2 L16,16"
                Stroke="#94A3B8"
                StrokeThickness="1.8"
                StrokeEndLineCap="Round"
                Stretch="Uniform"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
              />

              <!-- Placeholder -->
              <TextBlock
                Grid.Column="1"
                Margin="2,0,0,0"
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="#94A3B8"
                IsHitTestVisible="False"
                Text="Buscar por código o nombre del presupuesto…"
              >
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>

              <TextBox
                x:Name="SearchBox"
                Grid.Column="1"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                CaretBrush="#3B82F6"
                FontSize="13"
                Foreground="#1E293B"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                PreviewKeyDown="SearchBox_PreviewKeyDown"
                LostKeyboardFocus="SearchBox_LostKeyboardFocus"
              />

              <!-- Clear Button -->
              <Button
                Grid.Column="2"
                Command="{Binding ClearSearchCommand}"
                Style="{StaticResource ClearSearchButtonStyle}"
                Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}"
              />
            </Grid>
          </Border>

          <!-- Autocomplete Suggestions -->
          <Popup
            x:Name="SuggestionsPopup"
            AllowsTransparency="True"
            IsOpen="{Binding IsSuggestionsOpen, Mode=TwoWay}"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=SearchBorder}"
            PopupAnimation="Fade"
            StaysOpen="True"
            VerticalOffset="6"
            Width="{Binding ActualWidth, ElementName=SearchBorder}"
          >
            <Border
              Margin="0,0,0,14"
              Padding="4"
              Background="White"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="8"
            >
              <Border.Effect>
                <DropShadowEffect Direction="270" ShadowDepth="4" BlurRadius="14" Opacity="0.14" Color="#0F172A"/>
              </Border.Effect>
              <StackPanel>
                <TextBlock
                  Margin="12,6,12,4"
                  FontSize="10"
                  FontWeight="SemiBold"
                  Foreground="#94A3B8"
                  Text="SUGERENCIAS"
                />
                <ListBox
                  x:Name="SuggestionsList"
                  MaxHeight="280"
                  Background="Transparent"
                  BorderThickness="0"
                  Focusable="False"
                  ItemContainerStyle="{StaticResource SuggestionItemStyle}"
                  ItemsSource="{Binding Suggestions}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  PreviewMouseLeftButtonUp="SuggestionsList_PreviewMouseLeftButtonUp"
                >
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                          <TextBlock
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="#1E293B"
                            Text="{Binding Code}"
                            TextTrimming="CharacterEllipsis"
                          />
                          <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11.5"
                            Foreground="#64748B"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis"
                          />
                        </StackPanel>
                        <TextBlock
                          Grid.Column="1"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          FontSize="11"
                          Foreground="#94A3B8"
                          Text="{Binding DateText}"
                        />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock
                  Margin="12,4,12,6"
                  FontSize="10.5"
                  Foreground="#94A3B8"
                  Text="↑ ↓ para navegar  ·  Enter para elegir  ·  Esc para cerrar"
                />
              </StackPanel>
            </Border>
          </Popup>
        </Grid>

        <!-- List of saved budgets -->
        <Border Grid.Row="2" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Background="White" ClipToBounds="True">
          <DataGrid
            x:Name="BudgetsGrid"
            AutoGenerateColumns="False"
            Background="White"
            BorderThickness="0"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            GridLinesVisibility="All"
            HeadersVisibility="Column"
            ItemsSource="{Binding BudgetsView}"
            RowHeight="28"
            SelectedItem="{Binding SelectedBudget, Mode=TwoWay}"
            SelectionMode="Single"
            MouseDoubleClick="DataGrid_MouseDoubleClick"
            SelectionChanged="BudgetsGrid_SelectionChanged"
          >
            <DataGrid.ColumnHeaderStyle>
              <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#1E3A5F"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="BorderBrush" Value="#2B5278"/>
                <Setter Property="BorderThickness" Value="0,0,1,0"/>
              </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
              <DataGridTextColumn
                Width="*"
                Binding="{Binding DisplayName}"
                Header="Nombre / Versión de Estructura"
                IsReadOnly="True"
              />
              <DataGridTextColumn
                Width="180"
                Binding="{Binding CreatedAt, StringFormat=\{0:dd/MM/yyyy HH:mm:ss\}}"
                Header="Fecha de Guardado"
                IsReadOnly="True"
              />
            </DataGrid.Columns>
          </DataGrid>
        </Border>

        <!-- Empty Search State -->
        <StackPanel
          Grid.Row="2"
          Margin="0,36,0,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          IsHitTestVisible="False"
          Visibility="{Binding HasNoResults, Converter={StaticResource BooleanToVisibilityConverter}}"
        >
          <Path
            Width="28"
            Height="28"
            HorizontalAlignment="Center"
            Data="M6.5,0 A6.5,6.5 0 1 1 6.5,13 A6.5,6.5 0 1 1 6.5,0 M11.2,11.2 L16,16"
            Stroke="#CBD5E1"
            StrokeThickness="1.4"
            StrokeEndLineCap="Round"
            Stretch="Uniform"
          />
          <TextBlock
            Margin="0,10,0,0"
            HorizontalAlignment="Center"
            FontSize="13"
            FontWeight="SemiBold"
            Foreground="#475569"
            Text="Sin resultados"
          />
          <TextBlock
            Margin="0,4,0,0"
            HorizontalAlignment="Center"
            FontSize="12"
            Foreground="#94A3B8"
          >
            <Run Text="No hay estructuras que coincidan con “" /><Run Text="{Binding SearchText, Mode=OneWay}" /><Run Text="”." />
          </TextBlock>
        </StackPanel>

        <!-- Loading Overlay -->
        <Grid Grid.Row="2" Background="#D8F8FAFC" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Circular Spinner -->
            <Grid Width="40" Height="40" HorizontalAlignment="Center">
              <Ellipse Width="40" Height="40" Stroke="#E2E8F0" StrokeThickness="4" />
              <Ellipse Width="40" Height="40" Stroke="#3B82F6" StrokeThickness="4"
                       StrokeDashArray="3 3">
                <Ellipse.RenderTransform>
                  <RotateTransform x:Name="spinnerRotate" CenterX="20" CenterY="20" />
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="spinnerRotate"
                                         Storyboard.TargetProperty="Angle"
                                         From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever" />
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Ellipse.Triggers>
              </Ellipse>
            </Grid>
            <TextBlock Text="Consultando presupuestos..." Margin="0,16,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#1E3A5F" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>

        <!-- Footer: result summary + action buttons -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock
            Grid.Column="0"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="#94A3B8"
            Text="{Binding ResultSummary}"
          />

          <StackPanel
            Grid.Column="1"
            Orientation="Horizontal"
          >
            <Button
              Background="#94A3B8"
              Command="{Binding CancelCommand}"
              Content="Cancelar"
              Margin="0,0,10,0"
              Style="{StaticResource ModernButtonStyle}"
            />
            <Button
              Background="#3B82F6"
              Command="{Binding ConfirmCommand}"
              Content="Cargar"
              Style="{StaticResource ModernButtonStyle}"
            />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
