<UserControl x:Class="CQEING_CuadroCantidades.UI.Views.FaceSelectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CQEING_CuadroCantidades.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FaceSelectionViewModel}"
             d:DesignWidth="320" d:DesignHeight="520">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Rayado del elemento en planta y en corte -->
        <VisualBrush x:Key="HatchBrush" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute"
                     Viewbox="0,0,8,8" ViewboxUnits="Absolute">
            <VisualBrush.Visual>
                <Canvas Width="8" Height="8" Background="#F1F5F9">
                    <Path Data="M0,8 L8,0" Stroke="#CBD5E1" StrokeThickness="1.5" />
                </Canvas>
            </VisualBrush.Visual>
        </VisualBrush>

        <Style x:Key="ElementShapeStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="{StaticResource HatchBrush}" />
            <Setter Property="Stroke" Value="#64748B" />
            <Setter Property="StrokeThickness" Value="1.5" />
        </Style>

        <!-- Cara: botón transparente que contiene su nombre y su barra -->
        <Style x:Key="FaceButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="ToolTip" Value="{Binding AccessibleName}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            <Setter Property="Command" Value="{Binding ToggleCommand}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barra de la cara: azul si suma, punteada si no, clara si suma solo en algunos elementos -->
        <Style x:Key="FaceBarStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="White" />
            <Setter Property="Stroke" Value="#94A3B8" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeDashArray" Value="2 1.5" />
            <Setter Property="RadiusX" Value="2" />
            <Setter Property="RadiusY" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Fill" Value="#3B82F6" />
                    <Setter Property="Stroke" Value="#3B82F6" />
                    <Setter Property="StrokeDashArray" Value="{x:Null}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="{x:Null}">
                    <Setter Property="Fill" Value="#BFDBFE" />
                    <Setter Property="Stroke" Value="#3B82F6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FaceNameStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Text" Value="{Binding Name}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="#1E293B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FaceDirectionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Text" Value="{Binding Direction}" />
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Margin" Value="10,0,0,6" />
        </Style>

        <Style x:Key="DrawingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="PresetButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ejes globales X e Y -->
        <DataTemplate x:Key="AxesTemplate">
            <Canvas Width="46" Height="46">
                <Path Stroke="#475569" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" Data="M8,38 H36 M31,33 L36,38 L31,43 M8,38 V10 M3,15 L8,10 L13,15" />
                <TextBlock Canvas.Left="38" Canvas.Top="28" Text="X" FontSize="10" FontWeight="Bold" Foreground="#475569" />
                <TextBlock Canvas.Left="14" Canvas.Top="0" Text="Y" FontSize="10" FontWeight="Bold" Foreground="#475569" />
            </Canvas>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,12">

            <DockPanel Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Right" Text="Ejes globales" FontSize="11" Foreground="#64748B" VerticalAlignment="Bottom" />
                <TextBlock Text="{Binding SelectionText}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" TextWrapping="Wrap" />
            </DockPanel>

            <!-- Sin filas seleccionadas: los cambios van a toda la actividad -->
            <TextBlock Margin="0,-4,0,10" TextWrapping="Wrap" FontSize="11.5" Foreground="#475569"
                       Text="Selecciona filas en la tabla para cambiar solo esos elementos."
                       Visibility="{Binding AppliesToWholeActivity, Converter={StaticResource BoolToVisibility}}" />

            <!-- Sin selección -->
            <Border Background="#F1F5F9" CornerRadius="6" Padding="12" Margin="0,0,0,10"
                    Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisibility}}">
                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="#475569"
                           Text="Las filas seleccionadas no son columnas, vigas ni zapatas. Selecciónalas, o quita la selección para trabajar con toda la actividad." />
            </Border>

            <!-- Elementos de distinto tipo a la vez -->
            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"
                    Visibility="{Binding HasMixedSelection, Converter={StaticResource BoolToVisibility}}">
                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="#92400E"
                           Text="Hay elementos de distinto tipo seleccionados. Deja solo columnas, solo vigas o solo zapatas para elegir sus caras." />
            </Border>

            <!-- Columnas: planta con las cuatro caras laterales -->
            <Border Style="{StaticResource DrawingCardStyle}"
                    Visibility="{Binding ShowColumnPlan, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="PLANTA DE LA COLUMNA" />
                    <Canvas Width="280" Height="210" HorizontalAlignment="Center">
                        <Rectangle Canvas.Left="80" Canvas.Top="60" Width="120" Height="90" Style="{StaticResource ElementShapeStyle}" />

                        <Button Canvas.Left="80" Canvas.Top="8" Width="120" Height="50" DataContext="{Binding Y2}" Style="{StaticResource FaceButtonStyle}">
                            <StackPanel VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                    <TextBlock Style="{StaticResource FaceNameStyle}" />
                                    <TextBlock Style="{StaticResource FaceDirectionStyle}" Margin="5,0,0,0" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <Rectangle Width="120" Height="10" Style="{StaticResource FaceBarStyle}" />
                            </StackPanel>
                        </Button>

                        <Button Canvas.Left="80" Canvas.Top="152" Width="120" Height="50" DataContext="{Binding Y1}" Style="{StaticResource FaceButtonStyle}">
                            <StackPanel VerticalAlignment="Top">
                                <Rectangle Width="120" Height="10" Style="{StaticResource FaceBarStyle}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <TextBlock Style="{StaticResource FaceNameStyle}" />
                                    <TextBlock Style="{StaticResource FaceDirectionStyle}" Margin="5,0,0,0" VerticalAlignment="Bottom" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Canvas.Left="0" Canvas.Top="60" Width="78" Height="90" DataContext="{Binding X1}" Style="{StaticResource FaceButtonStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock Style="{StaticResource FaceNameStyle}" HorizontalAlignment="Right" />
                                    <TextBlock Style="{StaticResource FaceDirectionStyle}" HorizontalAlignment="Right" />
                                </StackPanel>
                                <Rectangle Width="10" Height="90" Style="{StaticResource FaceBarStyle}" />
                            </StackPanel>
                        </Button>

                        <Button Canvas.Left="202" Canvas.Top="60" Width="78" Height="90" DataContext="{Binding X2}" Style="{StaticResource FaceButtonStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Rectangle Width="10" Height="90" Style="{StaticResource FaceBarStyle}" />
                                <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
                                    <TextBlock Style="{StaticResource FaceNameStyle}" />
                                    <TextBlock Style="{StaticResource FaceDirectionStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <ContentControl Canvas.Left="4" Canvas.Top="160" Content="" ContentTemplate="{StaticResource AxesTemplate}" Focusable="False" />
                    </Canvas>
                </StackPanel>
            </Border>

            <!-- Vigas: planta para los costados y corte para fondo y cara superior -->
            <Border Style="{StaticResource DrawingCardStyle}"
                    Visibility="{Binding ShowBeamPlan, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="PLANTA · COSTADOS" />
                    <Canvas Width="280" Height="226" HorizontalAlignment="Center">
                        <Grid Canvas.Left="40" Canvas.Top="46" Width="200" Height="26">
                            <Rectangle Style="{StaticResource ElementShapeStyle}" />
                            <Border Background="White" CornerRadius="3" Padding="4,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Viga en X" FontSize="10.5" FontWeight="SemiBold" Foreground="#1E293B" />
                            </Border>
                        </Grid>

                        <Button Canvas.Left="40" Canvas.Top="4" Width="200" Height="40" DataContext="{Binding Y2}" Style="{StaticResource FaceButtonStyle}">
                            <StackPanel VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                                    <TextBlock Style="{StaticResource FaceNameStyle}" FontSize="13" />
                                    <TextBlock Style="{StaticResource FaceDirectionStyle}" Margin="5,0,0,0" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <Rectangle Width="200" Height="8" Style="{StaticResource FaceBarStyle}" />
                            </StackPanel>
                        </Button>

                        <Button Canvas.Left="40" Canvas.Top="74" Width="200" Height="40" DataContext="{Binding Y1}" Style="{StaticResource FaceButtonStyle}">
                            <StackPanel VerticalAlignment="Top">
                                <Rectangle Width="200" Height="8" Style="{StaticResource FaceBarStyle}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                                    <TextBlock Style="{StaticResource FaceNameStyle}" FontSize="13" />
                                    <TextBlock Style="{StaticResource FaceDirectionStyle}" Margin="5,0,0,0" VerticalAlignment="Bottom" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Rectangle Canvas.Left="127" Canvas.Top="124" Width="26" Height="98" Style="{StaticResource ElementShapeStyle}" />
                        <TextBlock Canvas.Left="236" Canvas.Top="160" Text="Viga&#x0a;en Y" FontSize="10.5" FontWeight="SemiBold" Foreground="#1E293B" />

                        <Button Canvas.Left="50" Canvas.Top="124" Width="75" Height="98" DataContext="{Binding X1}" Style="{StaticResource FaceButtonStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock Style="{StaticResource FaceNameStyle}" FontSize="13" HorizontalAlignment="Right" />
                                    <TextBlock Style="{StaticResource FaceDirectionStyle}" HorizontalAlignment="Right" />
                                </StackPanel>
                                <Rectangle Width="8" Height="98" Style="{StaticResource FaceBarStyle}" />
                            </StackPanel>
                        </Button>

                        <Button Canvas.Left="155" Canvas.Top="124" Width="75" Height="98" DataContext="{Binding X2}" Style="{StaticResource FaceButtonStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Rectangle Width="8" Height="98" Style="{StaticResource FaceBarStyle}" />
                                <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
                                    <TextBlock Style="{StaticResource FaceNameStyle}" FontSize="13" />
                                    <TextBlock Style="{StaticResource FaceDirectionStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <ContentControl Canvas.Left="0" Canvas.Top="176" Content="" ContentTemplate="{StaticResource AxesTemplate}" Focusable="False" />
                    </Canvas>

                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="CORTE · ARRIBA Y ABAJO" Margin="10,6,0,6" />
                    <Canvas Width="280" Height="100" HorizontalAlignment="Center">
                        <Rectangle Canvas.Left="70" Canvas.Top="24" Width="46" Height="52" Style="{StaticResource ElementShapeStyle}" />

                        <Button Canvas.Left="70" Canvas.Top="0" Width="200" Height="24" DataContext="{Binding Z2}" Style="{StaticResource FaceButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Rectangle Width="46" Height="8" VerticalAlignment="Bottom" Style="{StaticResource FaceBarStyle}" />
                                <TextBlock Style="{StaticResource FaceNameStyle}" FontSize="13" Margin="10,0,0,0" />
                                <TextBlock Style="{StaticResource FaceDirectionStyle}" Margin="5,0,0,0" VerticalAlignment="Bottom" />
                            </StackPanel>
                        </Button>

                        <Button Canvas.Left="70" Canvas.Top="76" Width="200" Height="24" DataContext="{Binding Z1}" Style="{StaticResource FaceButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <Rectangle Width="46" Height="8" VerticalAlignment="Top" Style="{StaticResource FaceBarStyle}" />
                                <TextBlock Style="{StaticResource FaceNameStyle}" FontSize="13" Margin="10,0,0,0" />
                                <TextBlock Style="{StaticResource FaceDirectionStyle}" Margin="5,0,0,0" VerticalAlignment="Bottom" />
                            </StackPanel>
                        </Button>
                    </Canvas>
                </StackPanel>
            </Border>

            <!-- Zapatas: planta para los costados y corte para fondo y cara superior (con el área de la columna) -->
            <Border Style="{StaticResource DrawingCardStyle}"
                    Visibility="{Binding ShowFootingPlan, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="PLANTA DE LA ZAPATA · COSTADOS" />
                    <Canvas Width="280" Height="210" HorizontalAlignment="Center">
                        <Rectangle Canvas.Left="70" Canvas.Top="50" Width="140" Height="110" Style="{StaticResource ElementShapeStyle}" />
                        <Grid Canvas.Left="122" Canvas.Top="88" Width="36" Height="34">
                            <Rectangle Fill="White" Stroke="#64748B" StrokeThickness="1.5" />
                            <TextBlock Text="Col." FontSize="10.5" FontWeight="SemiBold" Foreground="#1E293B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>

                        <Button Canvas.Left="70" Canvas.Top="0" Width="140" Height="48" DataContext="{Binding Y2}" Style="{StaticResource FaceButtonStyle}">
                            <StackPanel VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                    <TextBlock Style="{StaticResource FaceNameStyle}" />
                                    <TextBlock Style="{StaticResource FaceDirectionStyle}" Margin="5,0,0,0" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <Rectangle Width="140" Height="10" Style="{StaticResource FaceBarStyle}" />
                            </StackPanel>
                        </Button>

                        <Button Canvas.Left="70" Canvas.Top="162" Width="140" Height="48" DataContext="{Binding Y1}" Style="{StaticResource FaceButtonStyle}">
                            <StackPanel VerticalAlignment="Top">
                                <Rectangle Width="140" Height="10" Style="{StaticResource FaceBarStyle}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <TextBlock Style="{StaticResource FaceNameStyle}" />
                                    <TextBlock Style="{StaticResource FaceDirectionStyle}" Margin="5,0,0,0" VerticalAlignment="Bottom" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Canvas.Left="0" Canvas.Top="50" Width="68" Height="110" DataContext="{Binding X1}" Style="{StaticResource FaceButtonStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock Style="{StaticResource FaceNameStyle}" HorizontalAlignment="Right" />
                                    <TextBlock Style="{StaticResource FaceDirectionStyle}" HorizontalAlignment="Right" />
                                </StackPanel>
                                <Rectangle Width="10" Height="110" Style="{StaticResource FaceBarStyle}" />
                            </StackPanel>
                        </Button>

                        <Button Canvas.Left="212" Canvas.Top="50" Width="68" Height="110" DataContext="{Binding X2}" Style="{StaticResource FaceButtonStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Rectangle Width="10" Height="110" Style="{StaticResource FaceBarStyle}" />
                                <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
                                    <TextBlock Style="{StaticResource FaceNameStyle}" />
                                    <TextBlock Style="{StaticResource FaceDirectionStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <ContentControl Canvas.Left="4" Canvas.Top="160" Content="" ContentTemplate="{StaticResource AxesTemplate}" Focusable="False" />
                    </Canvas>

                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="CORTE · ARRIBA Y ABAJO" Margin="10,6,0,6" />
                    <Canvas Width="280" Height="112" HorizontalAlignment="Center">
                        <Rectangle Canvas.Left="62" Canvas.Top="0" Width="36" Height="34" Fill="White" Stroke="#64748B" StrokeThickness="1.5" />
                        <Rectangle Canvas.Left="20" Canvas.Top="44" Width="120" Height="40" Style="{StaticResource ElementShapeStyle}" />

                        <Button Canvas.Left="20" Canvas.Top="20" Width="260" Height="22" DataContext="{Binding Z2}" Style="{StaticResource FaceButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Rectangle Width="120" Height="8" VerticalAlignment="Bottom" Style="{StaticResource FaceBarStyle}" />
                                <TextBlock Style="{StaticResource FaceNameStyle}" FontSize="13" Margin="10,0,0,0" />
                                <TextBlock Style="{StaticResource FaceDirectionStyle}" Margin="5,0,0,0" VerticalAlignment="Bottom" />
                            </StackPanel>
                        </Button>

                        <Button Canvas.Left="20" Canvas.Top="86" Width="260" Height="22" DataContext="{Binding Z1}" Style="{StaticResource FaceButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <Rectangle Width="120" Height="8" VerticalAlignment="Top" Style="{StaticResource FaceBarStyle}" />
                                <TextBlock Style="{StaticResource FaceNameStyle}" FontSize="13" Margin="10,0,0,0" />
                                <TextBlock Style="{StaticResource FaceDirectionStyle}" Margin="5,0,0,0" VerticalAlignment="Bottom" />
                            </StackPanel>
                        </Button>
                    </Canvas>
                    <TextBlock Margin="10,4,10,0" TextWrapping="Wrap" FontSize="11" Foreground="#64748B"
                               Text="La cara superior incluye el área donde nace la columna." />
                </StackPanel>
            </Border>

            <!-- Selección rápida y área de la selección -->
            <ItemsControl ItemsSource="{Binding Presets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}" Command="{Binding ApplyCommand}" Style="{StaticResource PresetButtonStyle}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Caras exteriores según la línea de propiedad: no dependen de si se llaman X1 o X2 -->
            <StackPanel Margin="0,8,0,4"
                        Visibility="{Binding ShowExteriorOptions, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="CARAS EXTERIORES" />
                <TextBlock Text="{Binding BoundaryText}" TextWrapping="Wrap" FontSize="11.5" Foreground="#475569" Margin="0,0,0,6" />
                <WrapPanel>
                    <Button Content="Quitar exteriores" Command="{Binding RemoveExteriorCommand}" Style="{StaticResource PresetButtonStyle}" />
                    <Button Content="Solo exteriores" Command="{Binding OnlyExteriorCommand}" Style="{StaticResource PresetButtonStyle}" />
                </WrapPanel>
                <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,6,0,0"
                        Visibility="{Binding HasBoundaryIssue, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding BoundaryIssueText}" TextWrapping="Wrap" FontSize="11.5" Foreground="#92400E" />
                </Border>
            </StackPanel>

            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,4,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoSelection}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasMixedSelection}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" FontSize="15" FontWeight="Bold" Foreground="#166534">
                        <Run Text="{Binding SelectionAreaText, Mode=OneWay}" /><Run Text=" m²" />
                    </TextBlock>
                    <TextBlock Text="Área de la selección" FontSize="12" Foreground="#166534" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
