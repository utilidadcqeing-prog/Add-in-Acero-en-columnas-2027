<Window x:Class="CQEING_CuadroCantidades.UI.Views.DynamicTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CQEING_CuadroCantidades.UI"
        xmlns:views="clr-namespace:CQEING_CuadroCantidades.UI.Views"
        Title="Detalles de Cuantificación" Height="600" Width="1100"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC">

    <Window.Resources>
        <ui:ImagePathToBitmapConverter x:Key="ImagePathToBitmapConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Pestañas del panel derecho: subrayado azul en la activa -->
        <Style x:Key="PanelTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                <UniformGrid IsItemsHost="True" Rows="1" />
                            </Border>
                            <ContentPresenter ContentSource="SelectedContent" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelTabItemStyle" TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Height="40" Background="White" BorderBrush="Transparent" BorderThickness="0,0,0,2">
                            <ContentPresenter x:Name="header" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontSize="13" TextElement.FontWeight="SemiBold" TextElement.Foreground="#64748B" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="header" Property="TextElement.Foreground" Value="#334155" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6" />
                                <Setter TargetName="header" Property="TextElement.Foreground" Value="#1E293B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar -->
        <Border Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.08" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ActivityTitle}" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Seleccionar Todo" Click="SelectAll_Click"
                        Margin="0,0,8,0" Background="#3B82F6" Style="{StaticResource ModernButtonStyle}"/>
                <Button Grid.Column="2" Content="Quitar Elementos Seleccionados" Command="{Binding RemoveElementsCommand}"
                        Background="#EF4444" Style="{StaticResource ModernButtonStyle}"/>
            </Grid>
        </Border>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="340" MinWidth="260" />
            </Grid.ColumnDefinitions>
            
            <!-- Tabla de datos -->
            <Border Grid.Column="0" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Background="White" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.08" Color="Black"/>
                </Border.Effect>
                <DataGrid x:Name="ElementsDataGrid" ItemsSource="{Binding DynamicData}"
                          AutoGenerateColumns="True" IsReadOnly="{Binding IsReadOnly}"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          BeginningEdit="DataGrid_BeginningEdit"
                          CellEditEnding="DataGrid_CellEditEnding"
                          CanUserSortColumns="False"
                          CanUserReorderColumns="False"
                          Background="White" BorderThickness="0"
                          HeadersVisibility="Column" GridLinesVisibility="All" RowHeight="28"
                          SelectionChanged="DataGrid_SelectionChanged"
                          AutoGeneratingColumn="DataGrid_AutoGeneratingColumn">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1E3A5F"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderBrush" Value="#2B5278"/>
                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                </DataGrid>
            </Border>

            <!-- Separador -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#E2E8F0" Margin="6,0" />

            <!-- Panel derecho: caras para el área (columnas, vigas y zapatas en M2) y galería -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.08" Color="Black"/>
                </Border.Effect>
                <TabControl Style="{StaticResource PanelTabControlStyle}" SelectedIndex="{Binding RightPanelTabIndex, Mode=TwoWay}">
                    <TabItem Header="Caras para el área" Style="{StaticResource PanelTabItemStyle}"
                             Visibility="{Binding IsFaceSelectionAvailable, Converter={StaticResource BoolToVisibility}}">
                        <views:FaceSelectorPanel DataContext="{Binding FaceSelection}" />
                    </TabItem>

                    <TabItem Header="Galería de Capturas" Style="{StaticResource PanelTabItemStyle}">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="200" />  <!-- Imagen grande -->
                                <RowDefinition Height="*" />    <!-- Lista de miniaturas -->
                                <RowDefinition Height="Auto" /> <!-- Selección de Vista -->
                                <RowDefinition Height="Auto" /> <!-- Botones -->
                            </Grid.RowDefinitions>

                            <!-- Visor de imagen grande -->
                            <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
                                <Grid>
                                    <!-- Mostrar imagen seleccionada -->
                                    <Image Source="{Binding SelectedPreviewImage}"
                                           Stretch="Uniform" Margin="4" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <!-- Placeholder si no hay imagen -->
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSnapshot}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Sin Vista Previa" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" FontSize="12" />
                                        <TextBlock Text="Tome una captura del modelo actual." Foreground="#94A3B8" FontSize="10" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Lista de miniaturas / snapshots -->
                            <ListBox Grid.Row="1" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}" 
                                     Background="Transparent" BorderThickness="0" Margin="0,0,0,10"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="White" Margin="0,0,0,6" Padding="8">
                                            <Border.Effect>
                                                <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="0.05" Color="Black"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F1F5F9" Height="40" CornerRadius="4" Margin="0,0,8,0">
                                                    <Image Source="{Binding Converter={StaticResource ImagePathToBitmapConverter}}" Stretch="UniformToFill" />
                                                </Border>
                                                <!-- Captura propia: fecha y "Captura de Modelo 3D". Del add-in de imágenes: código · nombre, origen y fecha -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding CapturedAt, StringFormat=\{0:dd/MM/yyyy HH:mm:ss\}}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFromImagesAddin}" Value="True">
                                                                        <Setter Property="Text">
                                                                            <Setter.Value>
                                                                                <MultiBinding StringFormat="{}{0} · {1}">
                                                                                    <Binding Path="AddinImageCode" />
                                                                                    <Binding Path="AddinImageName" />
                                                                                </MultiBinding>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Setter Property="ToolTip" Value="{Binding AddinImageName}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock FontSize="10" Foreground="#64748B">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Captura de Modelo 3D" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFromImagesAddin}" Value="True">
                                                                        <Setter Property="Text" Value="{Binding CapturedAt, StringFormat='Add-in de imágenes · {0:dd/MM/yyyy HH:mm}'}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <CheckBox Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0"
                                                          IsChecked="{Binding IsSelectedForPublication, Mode=TwoWay}"
                                                          Click="ImageSelection_Click" ToolTip="Seleccionar para publicación (máx. 3)" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Selección de Vista -->
                            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                                <TextBlock Text="Vista de Revit para Capturar" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding RevitViews}"
                                          SelectedItem="{Binding SelectedRevitView}"
                                          DisplayMemberPath="Name"
                                          Height="30"
                                          VerticalContentAlignment="Center"
                                          Background="White"
                                          BorderBrush="#E2E8F0"
                                          BorderThickness="1">
                                    <ComboBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4" />
                                        </Style>
                                    </ComboBox.Resources>
                                </ComboBox>
                            </StackPanel>

                            <!-- Fila de Botones -->
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Actualizar Preview" Command="{Binding GeneratePreviewCommand}" 
                                        Margin="0,0,4,0" Background="#10B981" Style="{StaticResource ModernButtonStyle}"/>
                                <!-- Deshabilitado para las imágenes del add-in de imágenes: el aviso se ve aunque esté deshabilitado -->
                                <Button Grid.Column="1" Content="Eliminar" Command="{Binding DeleteSnapshotCommand}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Margin="4,0,0,0" Background="#EF4444">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSnapshot.IsFromImagesAddin}" Value="True">
                                                    <Setter Property="ToolTip" Value="Esta imagen es del add-in de imágenes y la usan otras PCs: se borra desde ese add-in. Aquí solo se marca o desmarca para publicar." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>
