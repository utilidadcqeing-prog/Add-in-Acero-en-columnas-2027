<Window x:Class="practicacq.Vistas.VentanaColumnetas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:practicacq.Vistas"
        Title="Columnetas y Viguetas"
        Height="560" Width="640"
        MinHeight="520" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{x:Static local:Paleta.Fondo}">

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Estilos.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style TargetType="TextBlock" x:Key="Etiqueta">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3" />
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Panel de controles -->
        <DockPanel Grid.Column="0">

            <Button DockPanel.Dock="Top"
                    x:Name="BotonSeleccionar"
                    Content="Seleccionar Muros"
                    Height="30"
                    Background="{StaticResource Primario}" Foreground="White"
                    FontWeight="Bold" BorderThickness="0"
                    Click="BotonSeleccionar_Click" />

            <Button DockPanel.Dock="Bottom"
                    x:Name="BotonGenerar"
                    Content="Generar Columnetas y Viguetas"
                    Height="34" Margin="0,12,0,0"
                    Background="{StaticResource Exito}" Foreground="White"
                    FontWeight="Bold" BorderThickness="0"
                    Click="BotonGenerar_Click" />

            <StackPanel>
                <TextBlock Text="Muros Seleccionados:" Style="{StaticResource Etiqueta}" />

                <DataGrid x:Name="TablaMuros"
                          Height="120"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          Background="{StaticResource Superficie}"
                          RowHeight="20">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
                        <DataGridTextColumn Header="Nivel" Binding="{Binding Nivel}" Width="65" />
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Tipo de Columneta (Pilar Estructural):" Style="{StaticResource Etiqueta}" />
                <ComboBox x:Name="ComboColumnetas"
                          Height="24"
                          DisplayMemberPath="Etiqueta"
                          SelectionChanged="Opciones_Cambiadas" />

                <TextBlock Text="Tipo de Vigueta (Armazón Estructural):" Style="{StaticResource Etiqueta}" />
                <ComboBox x:Name="ComboViguetas"
                          Height="24"
                          DisplayMemberPath="Etiqueta"
                          SelectionChanged="Opciones_Cambiadas" />

                <TextBlock Text="Elementos a generar:" Style="{StaticResource Etiqueta}" />
                <CheckBox x:Name="ChkColumnetas" Content="Generar Columnetas"
                          IsChecked="True" Click="Opciones_Cambiadas" />
                <CheckBox x:Name="ChkViguetasSup" Content="Generar Viguetas Superiores"
                          IsChecked="True" Click="Opciones_Cambiadas" />
                <CheckBox x:Name="ChkViguetasInf" Content="Generar Viguetas Inferiores"
                          IsChecked="True" Click="Opciones_Cambiadas" />

                <TextBlock Text="Separación máxima entre columnetas (m):" Style="{StaticResource Etiqueta}" />
                <TextBox x:Name="CampoSeparacion" Text="3.00" Height="22"
                         TextChanged="Opciones_Cambiadas" />

                <TextBlock Text="Posición de la Vigueta Superior:" Style="{StaticResource Etiqueta}" />
                <CheckBox x:Name="ChkDesfase" Content="Aplicar desfase vertical"
                          Click="ChkDesfase_Click" />

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="EtiquetaDesfase"
                               Grid.Column="0"
                               Text="Desfase desde la parte superior del muro (m):"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextoSecundario}"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="CampoDesfase"
                             Grid.Column="1"
                             Text="0.00" Height="22"
                             IsEnabled="False"
                             VerticalAlignment="Center"
                             TextChanged="Opciones_Cambiadas" />
                </Grid>
            </StackPanel>
        </DockPanel>

        <!-- Panel de esquema -->
        <Border Grid.Column="2"
                BorderBrush="{StaticResource Borde}" BorderThickness="1"
                Background="{StaticResource Superficie}">
            <Grid>
                <Canvas x:Name="Esquema" ClipToBounds="True"
                        SizeChanged="Esquema_SizeChanged" />
                <TextBlock x:Name="TextoEsquema"
                           Text="Esquema del muro tipo"
                           Foreground="{StaticResource TextoApagado}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,8,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
