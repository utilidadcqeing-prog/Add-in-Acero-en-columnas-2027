<UserControl x:Class="practicacq.Vistas.PanelFiltros3D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Vista previa 3D en Revit (#123): el botón que la abre y los filtros
         que pidió Carlos. Va arriba de la pestaña «Vista previa». -->
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="Grupo">
            <Setter Property="Width" Value="62" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,2,10,2" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,2,10,2" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="Button" x:Key="Atajo">
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <Expander Header="Vista 3D en Revit" IsExpanded="True" Margin="0,0,0,8">
        <StackPanel Margin="4,4,0,0">
            <DockPanel>
                <Button x:Name="BotonVer3D" Content="Ver en 3D" Padding="10,2" DockPanel.Dock="Left"
                        ToolTip="Abre la vista «CQEING Columnas 3D» con el armado de esta columna, sin crearlo en el modelo."
                        Click="BotonVer3D_Click" />
                <TextBlock x:Name="TextoEstado" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           FontSize="11" Foreground="#555555"
                           Text="Se actualiza sola con cada cambio. No crea nada en el modelo." />
            </DockPanel>

            <WrapPanel Margin="0,6,0,2">
                <Button Content="Todo" Style="{StaticResource Atajo}" Click="AtajoTodo_Click" />
                <Button Content="Solo longitudinales" Style="{StaticResource Atajo}" Click="AtajoLongitudinales_Click" />
                <Button Content="Solo estribos (con menores)" Style="{StaticResource Atajo}" Click="AtajoEstribos_Click" />
                <Button Content="Solo ganchos" Style="{StaticResource Atajo}" Click="AtajoGanchos_Click" />
                <Button Content="Solo traslapos" Style="{StaticResource Atajo}" Click="AtajoTraslapos_Click" />
            </WrapPanel>

            <WrapPanel>
                <TextBlock Text="Piezas" Style="{StaticResource Grupo}" />
                <CheckBox x:Name="CasillaLongitudinales" Content="Longitudinales" IsChecked="True" />
                <CheckBox x:Name="CasillaEstribos" Content="Estribos" IsChecked="True" />
                <CheckBox x:Name="CasillaMenores" Content="Estribos menores" IsChecked="True" />
            </WrapPanel>
            <WrapPanel>
                <TextBlock Text="Mostrar" Style="{StaticResource Grupo}" />
                <RadioButton x:Name="RadioTodo" GroupName="Partes3D" Content="Barras enteras" IsChecked="True" />
                <RadioButton x:Name="RadioGanchos" GroupName="Partes3D" Content="Solo ganchos" />
                <RadioButton x:Name="RadioTraslapos" GroupName="Partes3D" Content="Solo traslapos" />
            </WrapPanel>
            <WrapPanel>
                <TextBlock Text="Tipo" Style="{StaticResource Grupo}" />
                <CheckBox x:Name="CasillaA" Content="A" IsChecked="True" />
                <CheckBox x:Name="CasillaB" Content="B" IsChecked="True" />
                <TextBlock Text="Posición" Style="{StaticResource Grupo}" Margin="12,0,0,0" />
                <CheckBox x:Name="CasillaEsquinas" Content="Esquinas" IsChecked="True" />
                <CheckBox x:Name="CasillaCaraX" Content="Cara X" IsChecked="True" />
                <CheckBox x:Name="CasillaCaraY" Content="Cara Y" IsChecked="True" />
            </WrapPanel>
            <WrapPanel>
                <TextBlock Text="Diámetro" Style="{StaticResource Grupo}" />
                <WrapPanel x:Name="CasillasDiametro">
                    <TextBlock Text="(aparecen al ver en 3D)" FontSize="11" Foreground="#888888" VerticalAlignment="Center" />
                </WrapPanel>
            </WrapPanel>
            <WrapPanel>
                <TextBlock Text="Zona" Style="{StaticResource Grupo}" />
                <CheckBox x:Name="CasillaConfinada" Content="Confinada" IsChecked="True" />
                <CheckBox x:Name="CasillaNoConfinada" Content="No confinada" IsChecked="True" />
                <CheckBox x:Name="CasillaTramoActivo" Content="Solo el tramo activo" Margin="12,2,0,2" />
            </WrapPanel>
        </StackPanel>
    </Expander>
</UserControl>
