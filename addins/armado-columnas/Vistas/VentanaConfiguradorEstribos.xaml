<Window x:Class="practicacq.Vistas.VentanaConfiguradorEstribos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:practicacq.Vistas"
        Title="Acero en columnas"
        Height="780" Width="1180"
        MinHeight="660" MinWidth="1000"
        WindowStartupLocation="CenterOwner"
        Background="{x:Static local:Paleta.Fondo}">

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Estilos.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <!-- "4 (2 + 2)" en las listas de cantidad de barras por cara. -->
        <local:ConvertidorBarrasPorCara x:Key="BarrasPorCara" />
        <DataTemplate x:Key="PlantillaBarrasPorCara">
            <TextBlock Text="{Binding Converter={StaticResource BarrasPorCara}}" />
        </DataTemplate>

        <!-- Lista de columnetas (issue #33). Sin casilla de tildar: desde la
             reunión del 11-sep lo que se genera no se tilda, se acepta en el
             panel del tramo (issue #56); el ✓ de la izquierda lo muestra. -->
        <DataTemplate x:Key="PlantillaNodo">
            <!-- La sangría de los tramos es un margen, no espacios en el texto. -->
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EsColumna}" Value="False">
                                <Setter Property="Margin" Value="14,1,0,1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <!-- #168: el color dice el estado (verde, ámbar, gris) y un clic lo saca. -->
                <TextBlock Text="{Binding Chulito}" Foreground="{Binding ColorChulito}" FontWeight="Bold"
                           ToolTip="{Binding AyudaChulito}" Background="Transparent"
                           PreviewMouseLeftButtonDown="ChulitoLista_MouseLeftButtonDown"
                           VerticalAlignment="Center" Width="12" Margin="0,0,2,0" />
                <TextBlock Text="{Binding Etiqueta}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Etiqueta}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsColumna}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Banner de modo simulado (se oculta cuando corre contra Revit real) -->
        <Border x:Name="BannerSimulado" Grid.Row="0" Style="{StaticResource CajaAviso}" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock Text="MODO DE PRUEBA — datos simulados, no hay conexión a Revit." Style="{StaticResource TextoAviso}" FontSize="12" FontWeight="Bold" />
        </Border>

        <!-- Barra superior. Ya no hay botones: el paso de "aplicar" desapareció
             (issue #56, reunión del 11-sep) y todo se decide con Aceptar, en el
             panel del tramo. -->
        <TextBlock Grid.Row="1" Margin="0,0,0,8"
                   Text="1. Elige la columna en la planta (Ctrl o arrastre para varias).   2. Configura el tramo y aprieta Aceptar (o Enter).   3. Genera el armado. Solo se generan los tramos con ✓; clic en un ✓ para sacarlo."
                   TextWrapping="Wrap" Foreground="{StaticResource TextoSecundario}" VerticalAlignment="Center" />

        <!-- Cuerpo: planta | elevación | configuración. El panel de tramos que
             había en el medio se fue con el issue #56: era redundante con la
             elevación y sus flechitas ("me sigue generando ruido,
             redundancia", William 11-sep). Su ancho se repartió entre los
             otros dos. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Elegir la columna: la planta, con la marca de ubicación del
                 pilar de cada una como etiqueta (issue #62). La lista enorme de
                 columnas se fue con ese mismo issue ("esa lista enorme también
                 desaparecería, no la veo", William 11-sep); la de columnetas se
                 queda porque son delgadas y suelen estar juntas, y pincharlas
                 en la planta es incómodo (issue #33; se oculta sola si el
                 modelo no tiene ninguna). -->
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource EncabezadoSeccion}">
                        <TextBlock Text="Columnas" Style="{StaticResource TituloSeccion}" />
                    </Border>

                    <TabControl x:Name="PestanasSeleccion" BorderThickness="0" Background="Transparent"
                                SelectionChanged="PestanasSeleccion_SelectionChanged">
                        <TabItem Header="Planta">
                            <local:PanelPlantaColumnas x:Name="PanelPlanta" />
                        </TabItem>
                        <TabItem x:Name="PestanaColumnetas" Header="Columnetas">
                            <ListBox x:Name="ListaColumnetas" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     HorizontalContentAlignment="Stretch"
                                     SelectionMode="Extended"
                                     ItemTemplate="{StaticResource PlantillaNodo}"
                                     SelectionChanged="ListaSeleccion_SelectionChanged" />
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>

            <!-- Elevación de detalle -->
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource EncabezadoSeccion}">
                        <TextBlock Text="Elevación (detalle)" Style="{StaticResource TituloSeccion}" />
                    </Border>

                    <!-- Lo que LectorContexto no pudo determinar solo, o dejó como
                         constancia (zapata, sin vigas que la toquen, sección que
                         cambia entre elementos). Vacío la mayoría de las veces. -->
                    <Border x:Name="PanelAvisos" DockPanel.Dock="Top" Style="{StaticResource CajaAviso}" Margin="0,0,0,8" Visibility="Collapsed">
                        <TextBlock x:Name="TextoAvisos" Style="{StaticResource TextoAviso}" />
                    </Border>

                    <TabControl x:Name="PestanasElevacion" BorderThickness="0" Background="Transparent">
                        <TabItem Header="Tramos">
                            <DockPanel>
                                <!-- Leyenda. WrapPanel y no StackPanel: en una sola fila
                                     no entran las cuatro entradas. -->
                                <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Rectangle Width="14" Height="14" Fill="{StaticResource Nudo}" Margin="0,0,4,0" />
                                    <TextBlock Text="nudo" Style="{StaticResource TextoLeyenda}" />
                                    <Rectangle Width="14" Height="14" Fill="{StaticResource Zapata}" Margin="0,0,4,0" />
                                    <TextBlock Text="contra zapata" Style="{StaticResource TextoLeyenda}" />
                                    <Rectangle Width="14" Height="14" Fill="{StaticResource ExitoFondo}" Stroke="{StaticResource ExitoClaro}" StrokeThickness="2" Margin="0,0,4,0" />
                                    <TextBlock Text="tramo activo" Style="{StaticResource TextoLeyenda}" />
                                    <TextBlock Text="✓" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Exito}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="se genera (clic para sacarlo)" Style="{StaticResource TextoLeyenda}" />
                                    <!-- #168 -->
                                    <TextBlock Text="✓" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AvisoBorde}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="cambiado, vuelve a aceptar" Style="{StaticResource TextoLeyenda}" />
                                    <TextBlock Text="✓" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextoApagado}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="ya generado" Style="{StaticResource TextoLeyenda}" />
                                </WrapPanel>

                                <!-- Flechas verticales y pegadas entre sí, no horizontales a los costados
                                     del texto: la elevación de abajo también es vertical (de piso a
                                     techo), así que "siguiente" sube (▲) y "anterior" baja (▼). -->
                                <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="TextoTramoActivo" Text="—" HorizontalAlignment="Left"
                                               VerticalAlignment="Center" FontSize="11" />
                                    <StackPanel Grid.Column="1">
                                        <Button x:Name="BotonSiguiente" Content="▲" Style="{StaticResource BotonFlecha}"
                                                ToolTip="Tramo de arriba" Click="BotonSiguiente_Click" />
                                        <Button x:Name="BotonAnterior" Content="▼" Style="{StaticResource BotonFlecha}"
                                                ToolTip="Tramo de abajo" Margin="0,2,0,0" Click="BotonAnterior_Click" />
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Canvas x:Name="CanvasElevacion" Width="350" Height="460" Background="Transparent" />
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>
                        <!-- Tipo A y tipo B con todas sus medidas, recalculado con
                             cada cambio del acero longitudinal (pedido de Luciano, 17-oct). -->
                        <TabItem Header="Traslapos">
                            <local:PanelTraslapos x:Name="PanelDeTraslapos" />
                        </TabItem>
                        <!-- La columna desde arriba, de frente y de costado, con los
                             colores por diámetro (pedido de Luciano, 20-oct). -->
                        <TabItem Header="Vista previa">
                            <DockPanel>
                                <!-- La vista 3D en Revit y sus filtros (#123). -->
                                <local:PanelFiltros3D x:Name="PanelDe3D" DockPanel.Dock="Top" />
                                <local:PanelVistaPrevia x:Name="PanelDeVistaPrevia" />
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>

            <!-- Panel del tramo activo -->
            <Border Grid.Column="4" Style="{StaticResource Panel}">
              <DockPanel>
                <!-- La fila de Aceptar va FUERA del ScrollViewer, pegada abajo:
                     es la acción principal de toda la ventana (issue #56) y no
                     puede depender de hasta dónde scrolleó el usuario. Los dos
                     botones de "aplicar al resto" son contextuales al tipo del
                     tramo activo (issue #57): el texto, el conteo y si se ven
                     los pone ActualizarBotonesDeAceptar. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Border Height="1" Background="{StaticResource Separador}" Margin="0,0,0,8" />
                    <Button x:Name="BotonAceptar" Content="✓  Aceptar este tramo" Height="32" IsDefault="True"
                            Style="{StaticResource BotonPrincipal}" Click="BotonAceptar_Click" />
                    <Button x:Name="BotonAceptarMismoTipo" ToolTip="Acepta este tramo y copia su configuración a los demás tramos del mismo tipo." Height="26" Style="{StaticResource BotonSecundario}" Margin="0,4,0,0"
                            Click="BotonAceptarMismoTipo_Click" Visibility="Collapsed" />
                    <Button x:Name="BotonAceptarColumna" ToolTip="Acepta este tramo y copia su configuración a todos los tramos de la columna." Height="26" Style="{StaticResource BotonSecundario}" Margin="0,4,0,0"
                            Click="BotonAceptarColumna_Click" Visibility="Collapsed" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Configuraciones guardadas (pedido de Luciano, 10-sep):
                         elegir una CARGA el panel; de ahí sale hacia los tramos
                         cuando se aprieta Aceptar. Se guardan dentro del modelo
                         de Revit, así que viajan con el proyecto. -->
                    <Border Style="{StaticResource EncabezadoSeccion}">
                        <TextBlock Text="Configuración guardada" Style="{StaticResource TituloSeccion}" />
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" x:Name="ComboConfiguraciones"
                                  ToolTip="Elige una configuración guardada: se carga en la columna activa y en las que abras después que todavía no tengan nada propio."
                                  SelectionChanged="ComboConfiguraciones_SelectionChanged" />
                        <!-- #178: volver a aplicarla (con una sola en la lista no se puede "volver a elegir"). -->
                        <Button Grid.Column="1" x:Name="BotonAplicarConfiguracion" Content="Aplicar" Style="{StaticResource BotonSecundario}" IsEnabled="False"
                                ToolTip="Carga la configuración elegida en todos los tramos de la columna activa, aunque ya tenga la suya. No acepta nada."
                                Height="24" Margin="6,0,0,0" Click="BotonAplicarConfiguracion_Click" />
                        <Button Grid.Column="2" x:Name="BotonBorrarConfiguracion" ToolTip="Elimina del modelo la configuración elegida en la lista (pregunta antes)." Content="Eliminar" Style="{StaticResource BotonPeligro}"
                                IsEnabled="False" Height="24" Margin="6,0,0,0" Click="BotonBorrarConfiguracion_Click" />
                    </Grid>
                    <!-- #179: si el panel se apartó de la configuración elegida, y guardar esos cambios en ella. -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="TextoCambiosSinGuardar" Style="{StaticResource TextoAyuda}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Visibility="Collapsed" />
                        <Button Grid.Column="1" x:Name="BotonGuardarCambios" Content="Guardar cambios" Style="{StaticResource BotonSecundario}" IsEnabled="False"
                                ToolTip="Reemplaza la configuración elegida con lo que hay ahora en el panel (pregunta antes)."
                                Height="24" Margin="6,0,0,0" Click="BotonGuardarCambios_Click" />
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="CampoNombreConfiguracion" ToolTip="Nombre de la configuración nueva. Enter = Guardar como nueva." KeyDown="CampoNombreConfiguracion_KeyDown"
                                 VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" x:Name="BotonGuardarComoNueva" ToolTip="Guarda el panel entero (tramo + acero longitudinal) dentro del modelo, como una configuración nueva con este nombre." Content="Guardar como nueva" Style="{StaticResource BotonSecundario}"
                                Height="24" Margin="6,0,0,0" Click="BotonGuardarComoNueva_Click" />
                    </Grid>
                    <TextBlock Text="Guarda el panel entero (tramo + acero longitudinal) con un nombre nuevo."
                               Style="{StaticResource TextoAyuda}" Margin="0,3,0,0" />

                    <Border Style="{StaticResource SeparadorSeccion}" />

                    <Border Style="{StaticResource EncabezadoSeccion}">
                        <TextBlock Text="Tramo activo" Style="{StaticResource TituloSeccion}" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                        <RadioButton x:Name="RadioUniforme" ToolTip="El mismo espaciado de estribos en todo el tramo." Content="Uniforme" GroupName="Modo" IsChecked="True" Margin="0,0,20,0" />
                        <RadioButton x:Name="RadioConfinado" ToolTip="Estribos más juntos cerca de los extremos (largo L1) y más separados en el centro." Content="Confinado" GroupName="Modo" />
                    </StackPanel>
                    <!-- Issue #58: en el nudo el confinamiento queda deshabilitado,
                         y hay que decir por qué: un control gris sin explicación
                         se lee como un error de la ventana. -->
                    <TextBlock x:Name="TextoModoFijo" Visibility="Collapsed" Margin="0,0,0,6"
                               Text="En los nudos el estribo va siempre uniforme: no se permite confinamiento dentro del canto de la viga."
                               Style="{StaticResource TextoAyuda}" />

                    <TextBlock Text="Barra de estribos:" Style="{StaticResource Etiqueta}" />
                    <ComboBox x:Name="ComboTipoBarra" ToolTip="Barra con la que se arman los estribos. Solo aparecen las que el cuadro de la empresa permite doblar como estribo." />
                    <!-- #64: solo se ofrecen las barras cuyo doblado coincide con el
                         cuadro. Una línea de resumen, y el detalle (cuáles y por
                         qué) plegado: en una plantilla grande son decenas de
                         líneas que tapaban el panel (Luciano, 20-oct). -->
                    <Expander x:Name="NotaBarrasEstribo" Margin="0,2,0,0" Visibility="Collapsed" IsExpanded="False">
                        <Expander.Header>
                            <TextBlock x:Name="ResumenBarrasEstribo" Style="{StaticResource TextoAviso}" />
                        </Expander.Header>
                        <TextBlock x:Name="DetalleBarrasEstribo" Style="{StaticResource TextoAviso}" Margin="18,2,0,0" />
                    </Expander>

                    <!-- Oculto a propósito (reunión 10-sep): el gancho del
                         estribo es siempre el de 135° de estilo estribo/tirante,
                         así que se fija por defecto y no se pregunta. El combo
                         se queda en el árbol, con su valor puesto, porque es de
                         donde lo lee LeerConfigDelPanel. -->
                    <TextBlock x:Name="EtiquetaTipoGancho" Text="Tipo de gancho:" Style="{StaticResource Etiqueta}" Visibility="Collapsed" />
                    <ComboBox x:Name="ComboTipoGancho" Visibility="Collapsed" />

                    <!-- Modo Uniforme -->
                    <StackPanel x:Name="PanelUniforme">
                        <TextBlock Text="Espaciado (m):" Style="{StaticResource Etiqueta}" />
                        <TextBox x:Name="CampoEspaciadoUniforme" ToolTip="Separación entre estribos, en metros (por ejemplo 0.20)." Text="0.20" />
                    </StackPanel>

                    <!-- Modo Confinado -->
                    <StackPanel x:Name="PanelConfinado" Visibility="Collapsed">
                        <TextBlock Text="Longitud de confinamiento L1 (m):" Style="{StaticResource Etiqueta}" />
                        <TextBox x:Name="CampoL1" ToolTip="Largo de la zona confinada en cada extremo del tramo, en metros." Text="0.50" />

                        <TextBlock Text="Espaciado confinado (m):" Style="{StaticResource Etiqueta}" />
                        <TextBox x:Name="CampoEspaciadoConfinado" ToolTip="Separación entre estribos dentro de la zona confinada, en metros." Text="0.07" />

                        <TextBlock Text="Espaciado no confinado (m):" Style="{StaticResource Etiqueta}" />
                        <TextBox x:Name="CampoEspaciadoNoConfinado" ToolTip="Separación entre estribos en el centro del tramo, en metros." Text="0.14" />
                        <TextBlock Text="Se sugiere el doble del confinado. Si lo cambias a mano, se respeta hasta que cambies de tramo."
                                   Style="{StaticResource TextoAyuda}" Margin="0,2,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="TextoValidacion" Style="{StaticResource TextoError}"
                               Margin="0,10,0,0" />

                    <Border Style="{StaticResource SeparadorSeccion}" />

                    <!-- Un solo recubrimiento para toda la columna, aunque sus piezas
                         tengan valores distintos en Revit: estribos y longitudinal
                         salen alineados de abajo a arriba. -->
                    <Border Style="{StaticResource EncabezadoSeccion}">
                        <TextBlock Text="Recubrimiento (toda la columna)" Style="{StaticResource TituloSeccion}" />
                    </Border>
                    <ComboBox x:Name="ComboRecubrimiento" ToolTip="Distancia del borde de la columna al acero. Solo se usa para dibujar; no cambia la columna en Revit." SelectionChanged="ComboRecubrimiento_SelectionChanged" />
                    <TextBlock Text="Se usa solo para dibujar el acero; no cambia el recubrimiento de las columnas en Revit."
                               Style="{StaticResource TextoAyuda}" Margin="0,2,0,0" />

                    <Border Style="{StaticResource SeparadorSeccion}" />

                    <!-- L4: acero longitudinal, es por columna entera; no cambia con el tramo activo -->
                    <Border Style="{StaticResource EncabezadoSeccion}">
                        <TextBlock Text="Acero longitudinal (toda la columna)" Style="{StaticResource TituloSeccion}" />
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="N. barras X:" Style="{StaticResource Etiqueta}" />
                            <ComboBox x:Name="ComboBarrasX" ToolTip="Barras intermedias en las dos caras X, sin contar las esquinas. «4 (2 + 2)» son 2 en cada cara." ItemTemplate="{StaticResource PlantillaBarrasPorCara}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="N. barras Y:" Style="{StaticResource Etiqueta}" />
                            <ComboBox x:Name="ComboBarrasY" ToolTip="Barras intermedias en las dos caras Y, sin contar las esquinas. «4 (2 + 2)» son 2 en cada cara." ItemTemplate="{StaticResource PlantillaBarrasPorCara}" />
                        </StackPanel>
                    </Grid>

                    <!-- El número de barra se elige por posición. La alternancia
                         A/B de los traslapos sigue, pero no decide el número
                         (Luciano, 19-oct). -->
                    <TextBlock Text="Tipo barra cara X:" Style="{StaticResource Etiqueta}" />
                    <ComboBox x:Name="ComboBarraCaraX" ToolTip="Número de varilla de las barras intermedias de las caras X." />

                    <TextBlock Text="Tipo barra cara Y:" Style="{StaticResource Etiqueta}" />
                    <ComboBox x:Name="ComboBarraCaraY" ToolTip="Número de varilla de las barras intermedias de las caras Y." />

                    <TextBlock Text="Tipo barra esquinas:" Style="{StaticResource Etiqueta}" />
                    <ComboBox x:Name="ComboBarraEsquinas" ToolTip="Número de varilla de las cuatro barras de las esquinas." />
                    <TextBlock Text="Los traslapos se alternan (una barra sí, una no): A y B traslapan en tramos distintos."
                               Style="{StaticResource TextoAyuda}" Margin="0,2,0,0" />

                    <TextBlock Text="Longitud de barra comercial (m):" Style="{StaticResource Etiqueta}" />
                    <ComboBox x:Name="ComboLongitudBarra" ToolTip="Largo de la barra que se compra (6 o 12 m): ninguna varilla cortada lo supera." />

                    <TextBlock Text="Redondeo de varillas:" Style="{StaticResource Etiqueta}" />
                    <ComboBox x:Name="ComboRedondeo" ToolTip="Cada varilla mide un múltiplo exacto de este valor; los traslapos se alargan lo necesario." ItemStringFormat="0.00 m" />

                    <TextBlock Text="Solape mínimo de los traslapos:" Style="{StaticResource Etiqueta}" />
                    <ComboBox x:Name="ComboSolape" ToolTip="Solape mínimo del cuadro de la empresa: el del diámetro de cada barra, o el mayor de la columna para todas." />
                    <TextBlock Text="Largos de varillas y traslapos: pestaña «Traslapos» de la elevación."
                               Style="{StaticResource TextoAyuda}" Margin="0,2,0,0" />

                    <!-- Igual que el del estribo: el anclaje en la zapata es
                         siempre el de 90° de estilo estándar. -->
                    <TextBlock x:Name="EtiquetaGanchoLongitudinal" Text="Gancho de anclaje en zapata:" Style="{StaticResource Etiqueta}" Visibility="Collapsed" />
                    <ComboBox x:Name="ComboGanchoLongitudinal" Visibility="Collapsed" />

                    <Button x:Name="BotonEstribosMenores" ToolTip="Grapas y estribos interiores de la sección (se dibujan sobre las barras)." Content="Editar estribos menores…" Height="28" Style="{StaticResource BotonSecundario}" Margin="0,12,0,0"
                            Click="BotonEstribosMenores_Click" />
                    <TextBlock x:Name="TextoEstribosMenores" Style="{StaticResource TextoAyuda}" Margin="0,4,0,0" />

                    <!-- #142: el cuadro de ganchos y traslapos, solo de consulta. -->
                    <Button x:Name="BotonCuadroVarillas" ToolTip="Muestra el cuadro de ganchos y traslapos de la empresa (solo consulta)." Content="Ver cuadro de varillas…" Height="28" Style="{StaticResource BotonSecundario}" Margin="0,8,0,0"
                            Click="BotonCuadroVarillas_Click" />
                </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Border>
        </Grid>

        <!-- Pie -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <!-- Sin las casillas de tildar hace falta decir en números qué
                     se va a armar, si no el botón de generar es una caja negra
                     (issue #56). -->
                <TextBlock x:Name="TextoResumenGeneracion" Foreground="{StaticResource ExitoTexto}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <!-- #168: sacar todos los ✓ de una vez, y volver atrás si fue sin querer. -->
                <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                    <Button x:Name="BotonQuitarTodos" Content="Quitar todos los ✓" Style="{StaticResource BotonSecundario}" Height="22" Padding="8,0"
                            ToolTip="Saca de la generación todos los tramos aceptados. Su configuración queda cargada."
                            Visibility="Collapsed" Click="BotonQuitarTodos_Click" />
                    <Button x:Name="BotonDeshacerQuitar" Content="Deshacer" Style="{StaticResource BotonSecundario}" Height="22" Padding="8,0" Margin="6,0,0,0"
                            ToolTip="Vuelve a poner los ✓ que se acaban de quitar."
                            Visibility="Collapsed" Click="BotonDeshacerQuitar_Click" />
                </StackPanel>
                <TextBlock x:Name="TextoEstado" Foreground="{StaticResource TextoSecundario}" TextWrapping="Wrap" />
            </StackPanel>
            <!-- #145: lo que generó el add-in antes se reemplaza siempre; la casilla
                 es solo para el acero ajeno (se conserva aunque #61 pedía sacarla).
                 Borra armado del modelo: se destaca como opción peligrosa (#118). -->
            <Border Grid.Column="1" Style="{StaticResource CajaPeligro}" VerticalAlignment="Center" Margin="0,0,12,0">
                <CheckBox x:Name="CheckBorrarAjeno" Content="Borrar también el armado que no generó el add-in en estas columnas"
                          ToolTip="El acero que generó el add-in en estas columnas se reemplaza siempre al generar. Esto borra además el modelado a mano o con otro add-in, en toda la columna."
                          Style="{StaticResource CasillaPeligro}" />
            </Border>
            <Button Grid.Column="2" x:Name="BotonGenerar" Content="Generar armado en Revit"
                    Height="32" Style="{StaticResource BotonAccionFinal}" Click="BotonGenerar_Click" />
        </Grid>
    </Grid>
</Window>
