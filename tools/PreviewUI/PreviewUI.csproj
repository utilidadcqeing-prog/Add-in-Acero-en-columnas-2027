<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Vista previa de la interfaz SIN Revit.

    La ventana del add-in no tiene ninguna dependencia de Revit: vive de
    IProveedorContexto/IProveedorTipos y ya trae un "modo de prueba". Este
    proyecto aprovecha eso para abrirla como una aplicaciÃ³n WPF normal, con los
    proveedores falsos, y poder mirar y criticar la interfaz sin depender de que
    Revit abra.

    NO es parte del add-in: practicacq.csproj excluye esta carpeta
    (DefaultItemExcludes) y acÃ¡ no hay ninguna referencia a RevitAPI.
    Los archivos se enlazan (Link) en vez de copiarse: hay una sola copia de
    cada uno, la del add-in.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>practicacq.PreviewUI</RootNamespace>
    <AssemblyName>PreviewUI</AssemblyName>
  </PropertyGroup>

  <!--
    Del Modelo entra todo MENOS lo que sÃ­ referencia Revit (EstandarCQ,
    MuroSeleccionado, OpcionesGeneracion, TipoFamilia): son el cuadro de la
    empresa y los tipos del comando de muros, que la ventana no usa.
  -->
  <ItemGroup>
    <Compile Include="..\..\addins\armado-columnas\Modelo\*.cs"
             Exclude="..\..\addins\armado-columnas\Modelo\EstandarCQ.cs;..\..\addins\armado-columnas\Modelo\MuroSeleccionado.cs;..\..\addins\armado-columnas\Modelo\OpcionesGeneracion.cs;..\..\addins\armado-columnas\Modelo\TipoFamilia.cs">
      <Link>Modelo\%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

