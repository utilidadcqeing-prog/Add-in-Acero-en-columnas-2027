<Window x:Class="practicacq.Imagenes.Vistas.VisorImagen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CQEING · Imagen"
        Width="1100" Height="760" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Background="#F3F6F9" Foreground="#16212C">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Imagen en grande, con flechas para pasar a las otras imágenes de la actividad -->
        <Border Background="White" BorderBrush="#D4DBE4" BorderThickness="0,0,1,0">
            <Grid>
                <Image x:Name="ImgGrande" Stretch="Uniform" Margin="16"/>
                <TextBlock x:Name="TxtSinArchivo" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#586777" TextWrapping="Wrap" TextAlignment="Center" Margin="40"
                           Text="El archivo de esta imagen no está en esta PC."/>
                <Button x:Name="BtnAnterior" Content="‹" FontSize="28" Width="44" Height="64" HorizontalAlignment="Left"
                        Margin="8,0,0,0" Background="#CC1D3852" Foreground="White" BorderThickness="0"
                        ToolTip="Imagen anterior (←)" Click="BtnAnterior_Click"/>
                <Button x:Name="BtnSiguiente" Content="›" FontSize="28" Width="44" Height="64" HorizontalAlignment="Right"
                        Margin="0,0,8,0" Background="#CC1D3852" Foreground="White" BorderThickness="0"
                        ToolTip="Imagen siguiente (→)" Click="BtnSiguiente_Click"/>
            </Grid>
        </Border>

        <!-- Datos de la imagen -->
        <DockPanel Grid.Column="1" Margin="16">
            <StackPanel DockPanel.Dock="Bottom">
                <Button x:Name="BtnAbrirCloudinary" Content="Abrir en el navegador" Padding="10,6" Margin="0,0,0,8"
                        Background="#2A68DE" Foreground="White" BorderBrush="#2A68DE" Click="BtnAbrirCloudinary_Click"/>
                <Button Content="Abrir la carpeta en esta PC" Padding="10,6" Background="White" BorderBrush="#D4DBE4"
                        Click="BtnAbrirCarpeta_Click"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="TxtPosicion" Foreground="#586777" FontSize="12"/>
                    <TextBlock x:Name="TxtCodigo" FontFamily="Consolas" FontWeight="Bold" FontSize="16" Foreground="#2A68DE" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TxtNombre" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtDescripcion" Foreground="#586777" TextWrapping="Wrap" Margin="0,4,0,12"/>

                    <TextBlock Text="MODELO" FontSize="11" FontWeight="SemiBold" Foreground="#586777"/>
                    <TextBlock x:Name="TxtModelo" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,10"/>

                    <TextBlock Text="VISTA DE REVIT" FontSize="11" FontWeight="SemiBold" Foreground="#586777"/>
                    <TextBlock x:Name="TxtVista" TextWrapping="Wrap" Margin="0,2,0,10"/>

                    <TextBlock Text="COLORES" FontSize="11" FontWeight="SemiBold" Foreground="#586777"/>
                    <ItemsControl x:Name="LstColores" Margin="0,4,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Width="14" Height="14" CornerRadius="3" Background="{Binding ColorHex}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding NombreTipo}" TextWrapping="Wrap" MaxWidth="240"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="GUARDADA" FontSize="11" FontWeight="SemiBold" Foreground="#586777"/>
                    <TextBlock x:Name="TxtFecha" Margin="0,2,0,2"/>
                    <TextBlock x:Name="TxtSubida" Foreground="#0F8660"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
