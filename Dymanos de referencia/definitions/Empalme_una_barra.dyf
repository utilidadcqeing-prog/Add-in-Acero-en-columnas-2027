    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "4408813f4d824b9fa3b28d1eee1d06c8",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "d6a36c95c71448818b4fc5b0f4fed77f",
          "Name": "item",
          "Description": "El elemento que se debe repetir.\n\nvar[]..[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a6a508f1a4a14eb2a4abb5da93d566b3",
          "Name": "amount",
          "Description": "El número de veces que se debe repetir.\n\nint",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "4715839bd7384462ab6c8c105e384e95",
          "Name": "list",
          "Description": "Lista de elementos repetidos.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "DSCore.List.OfRepeatedItem@var[]..[],int",
      "Replication": "Auto",
      "Description": "Crea una lista que contiene el elemento especificado el número de veces indicado.\n\nList.OfRepeatedItem (item: var[]..[], amount: int): var[]..[]"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# SCRIPT 1: FABRICANTE DE GEOMETRÍA (CORREGIDO)\r\nimport clr\r\nfrom System.Collections.Generic import List\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB.Structure import RebarSpliceGeometry\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.GeometryConversion) \r\n\r\n# ENTRADAS\r\ninput_puntos = IN[0]\r\ninput_vectores = IN[1]\r\n\r\n# --- GUARDIA: Si falta algo, devuelve lista vacía ---\r\nif input_puntos is None or input_vectores is None:\r\n    OUT = []\r\n\r\nelse:\r\n    # --- LA CORRECCIÓN: FUERZA BRUTA ---\r\n    # Preguntamos directamente: ¿Eres una lista de Python?\r\n    # Si SI: Te usamos tal cual.\r\n    # Si NO: Te metemos dentro de corchetes [] para convertirte en lista de 1 elemento.\r\n    \r\n    if isinstance(input_puntos, list):\r\n        puntos = input_puntos\r\n    else:\r\n        puntos = [input_puntos]\r\n        \r\n    if isinstance(input_vectores, list):\r\n        vectores = input_vectores\r\n    else:\r\n        vectores = [input_vectores]\r\n\r\n    # Preparamos la lista contenedora de Revit\r\n    lista_geometrias = List[RebarSpliceGeometry]()\r\n\r\n    # --- BUCLE ---\r\n    # Ahora es seguro usar 'zip' porque GARANTIZAMOS que ambos son listas\r\n    for p, v in zip(puntos, vectores):\r\n        try:\r\n            # 1. Traducir a Revit (XYZ)\r\n            p_xyz = p.ToXyz()\r\n            v_xyz = v.ToXyz()\r\n            \r\n            # 2. Crear objeto\r\n            geom = RebarSpliceGeometry(p_xyz, v_xyz)\r\n            \r\n            # 3. Añadir a la lista final\r\n            lista_geometrias.Add(geom)\r\n        except:\r\n            pass\r\n\r\n    OUT = lista_geometrias",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "8bbfb52410ba4020b8c20f9ee599a440",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "875adacf69a94f88943122db869e7c51",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "bd9ea3ff625241589bdc733f84677eba",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "6db4eb5fea3145f5908759f67d64da45",
          "Name": "OUT",
          "Description": "Resultado de la secuencia de comandos de Python",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Ejecuta una secuencia de comandos de Python incrustada."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# SCRIPT 2: CONFIGURADOR DE OPCIONES (MÚLTIPLE)\r\nimport clr\r\nfrom System.Collections.Generic import List\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB.Structure import RebarSpliceOptions, RebarSplicePosition\r\n\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Función ayuda para listas\r\ndef to_list(obj):\r\n    if hasattr(obj, '__iter__') and not isinstance(obj, str):\r\n        return obj\r\n    else:\r\n        return [obj]\r\n\r\n# ENTRADAS\r\ninput_tipos = IN[0] # Puede ser uno o varios tipos\r\n\r\nif not input_tipos:\r\n    OUT = []\r\nelse:\r\n    tipos = to_list(input_tipos)\r\n    lista_opciones = []\r\n    \r\n    for tipo in tipos:\r\n        # Extraemos ID\r\n        t_id = UnwrapElement(tipo).Id\r\n        # Creamos la opción\r\n        opt = RebarSpliceOptions(doc, t_id, RebarSplicePosition.Middle)\r\n        lista_opciones.append(opt)\r\n\r\n    OUT = lista_opciones",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "5a7f9ab3bd224e53a9f2e3767623918b",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "8c2a28e549e74a1881d143cb369824d8",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "2998699bab774523b4335d6f7149a3ec",
          "Name": "OUT",
          "Description": "Resultado de la secuencia de comandos de Python",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Ejecuta una secuencia de comandos de Python incrustada."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# SCRIPT 3: EJECUTOR FINAL (HÍBRIDO Y ROBUSTO)\r\nimport clr\r\nfrom System.Collections.Generic import List\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import ElementId, XYZ\r\nfrom Autodesk.Revit.DB.Structure import RebarSpliceUtils, RebarSpliceGeometry, MultiplanarOption\r\n\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# ENTRADAS\r\nbarra_input = IN[0]\r\nopciones_in = IN[1]  \r\nentrada_mixta = IN[2] # Puede ser Puntos o Geometría\r\n\r\ndef to_list(obj):\r\n    if isinstance(obj, list): return obj\r\n    else: return [obj]\r\n\r\n# --- GUARDIA ---\r\nif not barra_input or not opciones_in or not entrada_mixta:\r\n    OUT = [\"Faltan datos de entrada\"]\r\n\r\nelse:\r\n    # 1. Manejo seguro de la barra\r\n    raw_barra = UnwrapElement(barra_input)\r\n    if isinstance(raw_barra, list):\r\n        barra = raw_barra[0]\r\n    else:\r\n        barra = raw_barra\r\n\r\n    opts_py = to_list(opciones_in)\r\n    lista_entrada = to_list(entrada_mixta) \r\n\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n    doc.Regenerate()\r\n    resultado = []\r\n    \r\n    try:\r\n        # Preparar datos para la curva guía (solo si necesitamos proyectar puntos)\r\n        curvas_barra = barra.GetCenterlineCurves(False, False, False, MultiplanarOption.IncludeAllMultiplanarCurves, 0)\r\n        curva_guia = curvas_barra[0] \r\n\r\n        # --- PREPARAR GEOMETRÍA ---\r\n        lista_geoms_cs = List[RebarSpliceGeometry]()\r\n        \r\n        conteo_puntos = 0\r\n        conteo_geoms = 0\r\n\r\n        for item in lista_entrada:\r\n            if not item: continue\r\n            obj = UnwrapElement(item)\r\n            \r\n            # --- CASO A: VIENE DEL SCRIPT 1 COMO GEOMETRÍA YA HECHA ---\r\n            # Si ya es un RebarSpliceGeometry, lo usamos directo y confiamos en él.\r\n            if isinstance(obj, RebarSpliceGeometry):\r\n                lista_geoms_cs.Add(obj)\r\n                conteo_geoms += 1\r\n                \r\n            # --- CASO B: VIENE COMO PUNTO (XYZ) ---\r\n            # Si es un punto, aplicamos la corrección de precisión (Imantado)\r\n            elif isinstance(obj, XYZ): # O tiene coordenadas\r\n                proyeccion = curva_guia.Project(obj)\r\n                if proyeccion:\r\n                    pt_perfecto = proyeccion.XYZPoint\r\n                    geom_splice = RebarSpliceGeometry(barra.Id, pt_perfecto)\r\n                    lista_geoms_cs.Add(geom_splice)\r\n                    conteo_puntos += 1\r\n                else:\r\n                    resultado.append(\"Aviso: Un punto estaba demasiado lejos.\")\r\n            \r\n            else:\r\n                 # Intento final por si es un punto de Dynamo envuelto\r\n                 try:\r\n                    pt_xyz = obj.ToXyz() # Método común en Dynamo\r\n                    proyeccion = curva_guia.Project(pt_xyz)\r\n                    if proyeccion:\r\n                        geom_splice = RebarSpliceGeometry(barra.Id, proyeccion.XYZPoint)\r\n                        lista_geoms_cs.Add(geom_splice)\r\n                 except:\r\n                    pass\r\n\r\n        # --- EJECUCIÓN ---\r\n        opcion_a_usar = opts_py[0]\r\n        \r\n        if lista_geoms_cs.Count > 0:\r\n            ids_creados = RebarSpliceUtils.SpliceRebar(doc, barra.Id, opcion_a_usar, lista_geoms_cs)\r\n            \r\n            if ids_creados and ids_creados.Count > 0:\r\n                resultado.append(f\"ÉXITO: Se crearon {ids_creados.Count} empalmes.\")\r\n                resultado.append(f\"Info: Se usaron {conteo_geoms} geometrías directas y {conteo_puntos} puntos corregidos.\")\r\n            else:\r\n                resultado.append(\"FALLO GEOMÉTRICO: Revit aceptó los datos pero no cortó.\")\r\n                resultado.append(\"Consejo: Si estás usando geometrías directas (Script 1), asegúrate de que sus puntos toquen PERFECTAMENTE la barra.\")\r\n        else:\r\n            resultado.append(\"Error: No hay geometrías válidas para procesar.\")\r\n\r\n    except Exception as e:\r\n        import traceback\r\n        resultado.append(\"Error de API: \" + str(e))\r\n    \r\n    TransactionManager.Instance.TransactionTaskDone()\r\n    \r\n    OUT = resultado",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "d8a86aaf73af48a88d07835a6ba77c15",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "5110980e988141f8a2b3a86bafe6ca7b",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
