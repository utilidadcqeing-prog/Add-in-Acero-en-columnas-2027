{
  "Uuid": "89421bf2-55fb-4942-8414-0b5ac84154da",
  "IsCustomNode": true,
  "Category": "Geometry",
  "Description": "Obtienen las caras lejanas entre sí, paralelas conectadas por una misma linea. IN[0] = Surfaces , IN[1] = Linea",
  "Name": "Caras_Lejanas_Dirección",
  "ElementResolver": {
    "ResolutionMap": {
      "List.Count": {
        "Key": "List",
        "Value": "BuiltIn.ds"
      }
    }
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# IN[0]: lista de superficies (surfaces)\r\n# IN[1]: línea (line)\r\nsurfaces = IN[0]\r\nline = IN[1]\r\n\r\n# Lista para almacenar superficies que intersectan\r\nintersected_surfaces = []\r\n\r\nfor s in surfaces:\r\n    try:\r\n        # Intenta obtener el punto o curva de intersección\r\n        intersection = s.Intersect(line)\r\n        # Si no es None ni está vacía, hay intersección\r\n        if intersection and len(intersection) > 0:\r\n            intersected_surfaces.append(s)\r\n    except:\r\n        # Si ocurre algún error, simplemente pasa\r\n        pass\r\n\r\nOUT = intersected_surfaces\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "76d60e607abc40f5ad5120d6de5d66cd",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "a1b900115061452788a32e512baec12d",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "48b148a1f1f14858aed0eac5a301ab4d",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
