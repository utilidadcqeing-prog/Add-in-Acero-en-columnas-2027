{
  "Uuid": "aa8dc611-b3c6-4fe6-8320-130723353e19",
  "IsCustomNode": true,
  "Category": "01_Nodos_CQING",
  "Description": "Obtiene la CenterLine de una barra recta",
  "Name": "Rebar_CenterLine",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import Rebar, RebarInSystem, MultiplanarOption\r\n\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\n\r\ndef as_list(x):\r\n    return x if isinstance(x, list) else ([] if x is None else [x])\r\n\r\ndef curves_rebar_all_positions(r):\r\n    \"\"\"Rebar suelto: iterar todas las posiciones usando el overload transformado con índice.\"\"\"\r\n    curves_per_pos = []\r\n    try:\r\n        n = r.NumberOfBarPositions\r\n    except:\r\n        n = 1\r\n    for i in range(max(1, n)):\r\n        # Rebar tiene overload con MultiplanarOption + index\r\n        crvs = r.GetTransformedCenterlineCurves(\r\n            False,   # adjustForSelfIntersection\r\n            False,   # suppressHooks\r\n            False,   # suppressBendRadius\r\n            MultiplanarOption.IncludeOnlyPlanarCurves,\r\n            i        # barPositionIndex\r\n        )\r\n        curves_per_pos.append([c.ToProtoType() for c in crvs])\r\n    return curves_per_pos\r\n\r\ndef curves_rebarinsystem_all_positions(ris):\r\n    \"\"\"RebarInSystem: en 2026 el método transformado exige índice -> iterar 0..N-1.\"\"\"\r\n    curves_per_pos = []\r\n    try:\r\n        n = ris.NumberOfBarPositions\r\n    except:\r\n        n = 1\r\n    for i in range(max(1, n)):\r\n        # OJO: en RIS el overload transformado (2026) no pide MultiplanarOption, sí índice\r\n        crvs = ris.GetTransformedCenterlineCurves(\r\n            False,   # adjustForSelfIntersection\r\n            False,   # suppressHooks\r\n            False,   # suppressBendRadius\r\n            i        # barPositionIndex (0..N-1)\r\n        )\r\n        curves_per_pos.append([c.ToProtoType() for c in crvs])\r\n    return curves_per_pos\r\n\r\ndef curves_any(wrapped):\r\n    r = UnwrapElement(wrapped)\r\n    if r is None:\r\n        return []\r\n    # Rebar individual\r\n    if isinstance(r, Rebar):\r\n        return curves_rebar_all_positions(r)\r\n    # Rebar en sistema (set)\r\n    if isinstance(r, RebarInSystem):\r\n        return curves_rebarinsystem_all_positions(r)\r\n    # Fallback genérico: intenta un GetCenterlineCurves sin índice (primera barra)\r\n    try:\r\n        crvs = r.GetCenterlineCurves(False, False, False, MultiplanarOption.IncludeOnlyPlanarCurves)\r\n        return [[c.ToProtoType() for c in crvs]]\r\n    except:\r\n        return []\r\n\r\nitems = as_list(IN[0])\r\nOUT = [curves_any(x) for x in items]\r\n",
      "Engine": "CPython3",
