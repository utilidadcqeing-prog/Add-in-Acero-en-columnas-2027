    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Dynamo CPython 3 – Revit 2026.3\r\nimport clr\r\n\r\n# Revit API\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\n\r\n# RevitServices\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n# RevitNodes (ToRevitType)\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\nfrom System.Collections.Generic import List\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# ---------------- utilidades ----------------\r\ndef ensure_list(x):\r\n    if isinstance(x, list): return x\r\n    return [] if x is None else [x]\r\n\r\ndef ds_vector_to_xyz(v):\r\n    \"\"\"Acepta DS.Vector, XYZ o [x,y,z] y devuelve XYZ.\"\"\"\r\n    if v is None:\r\n        return None\r\n    if isinstance(v, XYZ):\r\n        return v\r\n    if hasattr(v, \"ToRevitType\"):\r\n        return v.ToRevitType()\r\n    try:\r\n        return XYZ(float(v[0]), float(v[1]), float(v[2]))\r\n    except:\r\n        raise Exception(\"IN[8] (vector) debe ser DS.Vector, XYZ o [x,y,z].\")\r\n\r\ndef flatten_db_curves_from_any(any_curves):\r\n    \"\"\"\r\n    Convierte una curva/colección (DS o DB) en List[DB.Curve].\r\n    Soporta DS.PolyCurve/NurbsCurve descomponiéndolas.\r\n    \"\"\"\r\n    def add_curve(c, acc):\r\n        if c is None: return\r\n        if isinstance(c, Curve):\r\n            acc.Add(c); return\r\n        # DS PolyCurve tiene Curves()\r\n        if hasattr(c, \"Curves\"):\r\n            try:\r\n                for sc in c.Curves():\r\n                    add_curve(sc, acc)\r\n                return\r\n            except:\r\n                pass\r\n        # Cualquier DS curve con ToRevitType\r\n        if hasattr(c, \"ToRevitType\"):\r\n            db_c = c.ToRevitType()\r\n            if isinstance(db_c, Curve):\r\n                acc.Add(db_c); return\r\n            try:\r\n                for sc in db_c:\r\n                    add_curve(sc, acc)\r\n                return\r\n            except:\r\n                pass\r\n        raise Exception(\"No se pudo convertir una curva a Autodesk.Revit.DB.Curve.\")\r\n    acc = List[Curve]()\r\n    if isinstance(any_curves, list):\r\n        for c in any_curves: add_curve(c, acc)\r\n    else:\r\n        add_curve(any_curves, acc)\r\n    return acc\r\n\r\ndef pick_by_index(lst, i):\r\n    \"\"\"Devuelve lst[i] si existe; si no, el primero (para usar uno para todos).\"\"\"\r\n    return lst[i] if len(lst) > 1 else lst[0]\r\n\r\n# ---------------- mapas de enums ----------------\r\nbar_style_map = {0: RebarStyle.Standard, 1: RebarStyle.StirrupTie}\r\nhook_orient_map = {0: RebarHookOrientation.Left, 1: RebarHookOrientation.Right}\r\n\r\n# ---------------- Entradas ----------------\r\ncurvas_por_rebar = ensure_list(IN[0])                 # cada item: curva o lista de curvas (DS o DB)\r\nrebar_bar_type    = UnwrapElement(IN[1])              # RebarBarType\r\nbar_style_in      = IN[2]\r\nstart_hook_type   = UnwrapElement(IN[3]) if IN[3] else None\r\nend_hook_type     = UnwrapElement(IN[4]) if IN[4] else None\r\nstart_hook_or_in  = IN[5]\r\nend_hook_or_in    = IN[6]\r\nhosts_in          = ensure_list(UnwrapElement(IN[7])) # Element(s)\r\nvectors_in        = ensure_list(IN[8])                # DS.Vector/XYZ/[x,y,z]\r\n\r\n# Normalizar enums si vienen como enteros\r\nbar_style = bar_style_map.get(bar_style_in, bar_style_in if isinstance(bar_style_in, RebarStyle) else RebarStyle.Standard)\r\nstart_hook_orient = hook_orient_map.get(start_hook_or_in, start_hook_or_in if isinstance(start_hook_or_in, RebarHookOrientation) else RebarHookOrientation.Left)\r\nend_hook_orient   = hook_orient_map.get(end_hook_or_in, end_hook_or_in if isinstance(end_hook_or_in, RebarHookOrientation) else RebarHookOrientation.Left)\r\n\r\n# Normalizar vectores\r\nvectors_xyz = [ds_vector_to_xyz(v) for v in vectors_in if v is not None]\r\nif not vectors_xyz:\r\n    raise Exception(\"Debes proporcionar al menos un vector en IN[8].\")\r\n\r\n# ---------------- Crear barras ----------------\r\nrebars = []\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\ntry:\r\n    for i, item in enumerate(curvas_por_rebar):\r\n        host  = pick_by_index(hosts_in, i)\r\n        norm  = pick_by_index(vectors_xyz, i)\r\n        # cada 'item' puede ser curva suelta o lista de curvas\r\n        curves_list = item if isinstance(item, list) else [item]\r\n        db_curves = flatten_db_curves_from_any(curves_list)\r\n        if db_curves.Count == 0:\r\n            continue\r\n        rb = Rebar.CreateFromCurves(\r\n            doc,\r\n            bar_style,\r\n            rebar_bar_type,\r\n            start_hook_type,\r\n            end_hook_type,\r\n            host,\r\n            norm,\r\n            db_curves,\r\n            start_hook_orient,\r\n            end_hook_orient,\r\n            True,   # useExistingShapeIfPossible\r\n            True    # createNewShape\r\n        )\r\n        rebars.append(rb)\r\nfinally:\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = rebars\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "7387f1376e9244c99eed67a3b1a31517",
      "NodeType": "PythonScriptNode",
