    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Dynamo CPython 3 – Revit 2026.3\r\nimport clr\r\n\r\n# Revit API\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\n\r\n# RevitServices\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n# RevitNodes (para ToRevitType)\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.GeometryConversion)  # ToRevitType() en DS Geometry\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\nfrom System.Collections.Generic import List\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# -------------------- utilidades --------------------\r\ndef ensure_list(x):\r\n    if isinstance(x, list): return x\r\n    return [] if x is None else [x]\r\n\r\ndef ds_vector_to_xyz(v):\r\n    \"\"\"Acepta DS.Vector o [x,y,z] o XYZ y devuelve XYZ.\"\"\"\r\n    if v is None:\r\n        return None\r\n    # Ya es XYZ\r\n    if isinstance(v, XYZ):\r\n        return v\r\n    # DS.Vector\r\n    if hasattr(v, \"ToRevitType\"):\r\n        return v.ToRevitType()\r\n    # Lista/tupla\r\n    try:\r\n        return XYZ(float(v[0]), float(v[1]), float(v[2]))\r\n    except:\r\n        raise Exception(\"IN[8] (vector) debe ser DS.Vector, [x,y,z] o XYZ.\")\r\n\r\ndef flatten_db_curves_from_any(curves_any):\r\n    \"\"\"\r\n    Convierte una entrada que puede ser:\r\n      - DS.Curve, DS.PolyCurve, DS.NurbsCurve, etc.\r\n      - Autodesk.Revit.DB.Curve\r\n      - lista mixta de lo anterior\r\n    en List[Autodesk.Revit.DB.Curve]\r\n    \"\"\"\r\n    def add_curve(c, acc):\r\n        if c is None: \r\n            return\r\n        # Ya es curva DB\r\n        if isinstance(c, Curve):\r\n            acc.Add(c)\r\n            return\r\n        # DS PolyCurve -> iterar subcurvas\r\n        if hasattr(c, \"Curves\"):\r\n            try:\r\n                for sc in c.Curves():\r\n                    add_curve(sc, acc)\r\n                return\r\n            except:\r\n                pass\r\n        # Cualquier DS.Curve con ToRevitType()\r\n        if hasattr(c, \"ToRevitType\"):\r\n            db_c = c.ToRevitType()\r\n            # Algunos retornan directamente Curve, otros listas\r\n            if isinstance(db_c, Curve):\r\n                acc.Add(db_c)\r\n                return\r\n            # Si fuera una colección, intentar iterarla\r\n            try:\r\n                for sc in db_c:\r\n                    add_curve(sc, acc)\r\n                return\r\n            except:\r\n                pass\r\n        # Último recurso: rechazar\r\n        raise Exception(\"No se pudo convertir una curva a Autodesk.Revit.DB.Curve.\")\r\n\r\n    acc = List[Curve]()\r\n    # Si viene una sola curva\r\n    if not isinstance(curves_any, list):\r\n        add_curve(curves_any, acc)\r\n        return acc\r\n    # Lista de curvas\r\n    for c in curves_any:\r\n        add_curve(c, acc)\r\n    return acc\r\n\r\n# -------------------- mapas de enums --------------------\r\nbar_style_map = {\r\n    0: RebarStyle.Standard,\r\n    1: RebarStyle.StirrupTie\r\n}\r\nhook_orientation_map = {\r\n    0: RebarHookOrientation.Left,\r\n    1: RebarHookOrientation.Right\r\n}\r\n\r\n# -------------------- Entradas --------------------\r\ncurvas_in          = IN[0]                             # curva / lista / lista de listas (DS o DB)\r\nrebar_bar_type     = UnwrapElement(IN[1])              # RebarBarType\r\nbar_style          = bar_style_map.get(IN[2], RebarStyle.Standard)\r\nstart_hook_type    = UnwrapElement(IN[3]) if IN[3] else None  # RebarHookType o None\r\nend_hook_type      = UnwrapElement(IN[4]) if IN[4] else None  # RebarHookType o None\r\nstart_hook_orient  = hook_orientation_map.get(IN[5], RebarHookOrientation.Left)\r\nend_hook_orient    = hook_orientation_map.get(IN[6], RebarHookOrientation.Left)\r\nhosts_in           = ensure_list(UnwrapElement(IN[7]))  # Element o lista\r\nvectors_in         = ensure_list(IN[8])                 # DS.Vector/XYZ/[x,y,z] o lista\r\n\r\n# Normalizar vectores a XYZ\r\nvectors_xyz = [ds_vector_to_xyz(v) for v in vectors_in if v is not None]\r\nif not vectors_xyz:\r\n    raise Exception(\"Debes proporcionar al menos un vector (IN[8]).\")\r\n\r\nrebars = []\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\ntry:\r\n    # Caso 1: lista de listas (varias barras independientes)\r\n    if isinstance(curvas_in, list) and curvas_in and isinstance(curvas_in[0], list):\r\n        for i, subcurvas in enumerate(curvas_in):\r\n            host = hosts_in[i] if len(hosts_in) > 1 else hosts_in[0]\r\n            norm = vectors_xyz[i] if len(vectors_xyz) > 1 else vectors_xyz[0]\r\n            db_curves = flatten_db_curves_from_any(subcurvas)\r\n            if db_curves.Count == 0:\r\n                continue\r\n            rb = Rebar.CreateFromCurves(\r\n                doc,\r\n                bar_style,\r\n                rebar_bar_type,\r\n                start_hook_type,\r\n                end_hook_type,\r\n                host,\r\n                norm,\r\n                db_curves,\r\n                start_hook_orient,\r\n                end_hook_orient,\r\n                True,   # useExistingShapeIfPossible\r\n                True    # createNewShape\r\n            )\r\n            rebars.append(rb)\r\n\r\n    # Caso 2: lista de curvas (una sola barra con varias líneas/arcos)\r\n    elif isinstance(curvas_in, list) and curvas_in:\r\n        host = hosts_in[0]\r\n        norm = vectors_xyz[0]\r\n        db_curves = flatten_db_curves_from_any(curvas_in)\r\n        rb = Rebar.CreateFromCurves(\r\n            doc, bar_style, rebar_bar_type,\r\n            start_hook_type, end_hook_type,\r\n            host, norm, db_curves,\r\n            start_hook_orient, end_hook_orient,\r\n            True, True\r\n        )\r\n        rebars.append(rb)\r\n\r\n    # Caso 3: una sola curva\r\n    else:\r\n        host = hosts_in[0]\r\n        norm = vectors_xyz[0]\r\n        db_curves = flatten_db_curves_from_any([curvas_in])\r\n        rb = Rebar.CreateFromCurves(\r\n            doc, bar_style, rebar_bar_type,\r\n            start_hook_type, end_hook_type,\r\n            host, norm, db_curves,\r\n            start_hook_orient, end_hook_orient,\r\n            True, True\r\n        )\r\n        rebars.append(rb)\r\n\r\nfinally:\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = rebars\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "30da08ef9e3648d09312f20390423dfc",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "96a270da8e274512a8a8cf53901aba01",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "7f7a5995647946c0a4415ac6fc2e839c",
