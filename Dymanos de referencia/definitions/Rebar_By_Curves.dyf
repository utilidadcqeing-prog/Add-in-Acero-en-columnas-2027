    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\n\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\n\r\nimport System\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\ndef ensure_list(x):\r\n    if isinstance(x, list):\r\n        return x\r\n    elif x is None:\r\n        return []\r\n    else:\r\n        return [x]\r\n\r\n# -- Entradas --\r\ncurvas_por_rebar = ensure_list(IN[0])\r\nrebar_bar_type = UnwrapElement(IN[1])\r\nbar_style = IN[2]\r\nstart_hook_type = UnwrapElement(IN[3]) if IN[3] else None\r\nend_hook_type = UnwrapElement(IN[4]) if IN[4] else None\r\nstart_hook_orientation_enum = IN[5]\r\nend_hook_orientation_enum = IN[6]\r\nhosts = ensure_list(UnwrapElement(IN[7]))\r\nvectores = ensure_list(IN[8])\r\n\r\n# Convertir vectores a XYZ solo si no son None\r\nvectores = [v.ToRevitType() for v in vectores if v is not None]\r\n\r\nrebars = []\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor curva, host, vector in zip(curvas_por_rebar, hosts, vectores):\r\n    rebar = Rebar.CreateFromCurves(\r\n        doc,\r\n        bar_style,\r\n        rebar_bar_type,\r\n        start_hook_type,\r\n        end_hook_type,\r\n        host,\r\n        vector,\r\n        [curva],  # cada curva debe ir en lista\r\n        start_hook_orientation_enum,\r\n        end_hook_orientation_enum,\r\n        True,\r\n        True\r\n    )\r\n    rebars.append(rebar)\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = rebars\r\n",
      "Engine": "CPython3",
