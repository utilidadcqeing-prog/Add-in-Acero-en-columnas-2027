    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\n\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\ndef ensure_list(x):\r\n    if isinstance(x, list):\r\n        return x\r\n    elif x is None:\r\n        return []\r\n    else:\r\n        return [x]\r\n\r\n# Mapas de enums válidos\r\nbar_style_map = {\r\n    0: RebarStyle.Standard,\r\n    1: RebarStyle.StirrupTie\r\n}\r\nhook_orientation_map = {\r\n    0: RebarHookOrientation.Left,\r\n    1: RebarHookOrientation.Right\r\n}\r\n\r\n# --- Entradas desde Dynamo ---\r\ncurvas_in = IN[0]\r\nrebar_bar_type = UnwrapElement(IN[1])\r\nbar_style = bar_style_map.get(IN[2], RebarStyle.Standard)\r\nstart_hook_type = UnwrapElement(IN[3]) if IN[3] else None\r\nend_hook_type = UnwrapElement(IN[4]) if IN[4] else None\r\nstart_hook_orientation_enum = hook_orientation_map.get(IN[5], RebarHookOrientation.Left)\r\nend_hook_orientation_enum = hook_orientation_map.get(IN[6], RebarHookOrientation.Left)\r\nhost_in = IN[7]\r\nvector_in = IN[8]\r\n\r\nhosts = ensure_list(UnwrapElement(host_in))\r\nvectores = ensure_list(vector_in)\r\nvectores = [v.ToRevitType() for v in vectores if v is not None]\r\n\r\nrebars = []\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n# --- Caso 1: lista de listas (varias barras independientes)\r\nif isinstance(curvas_in, list) and len(curvas_in) > 0 and isinstance(curvas_in[0], list):\r\n    for i, subcurvas in enumerate(curvas_in):\r\n        h = hosts[i] if len(hosts) > 1 else hosts[0]\r\n        v = vectores[i] if len(vectores) > 1 else vectores[0]\r\n        rebar = Rebar.CreateFromCurves(\r\n            doc,\r\n            bar_style,\r\n            rebar_bar_type,\r\n            start_hook_type,\r\n            end_hook_type,\r\n            h,\r\n            v,\r\n            subcurvas,\r\n            start_hook_orientation_enum,\r\n            end_hook_orientation_enum,\r\n            True,\r\n            True\r\n        )\r\n        rebars.append(rebar)\r\n# --- Caso 2: lista de curvas (una sola barra con varias líneas unidas)\r\nelif isinstance(curvas_in, list) and len(curvas_in) > 0:\r\n    h = hosts[0]\r\n    v = vectores[0]\r\n    rebar = Rebar.CreateFromCurves(\r\n        doc,\r\n        bar_style,\r\n        rebar_bar_type,\r\n        start_hook_type,\r\n        end_hook_type,\r\n        h,\r\n        v,\r\n        curvas_in,\r\n        start_hook_orientation_enum,\r\n        end_hook_orientation_enum,\r\n        True,\r\n        True\r\n    )\r\n    rebars.append(rebar)\r\n# --- Caso 3: solo una curva (crear una barra con una línea)\r\nelse:\r\n    h = hosts[0]\r\n    v = vectores[0]\r\n    rebar = Rebar.CreateFromCurves(\r\n        doc,\r\n        bar_style,\r\n        rebar_bar_type,\r\n        start_hook_type,\r\n        end_hook_type,\r\n        h,\r\n        v,\r\n        [curvas_in],\r\n        start_hook_orientation_enum,\r\n        end_hook_orientation_enum,\r\n        True,\r\n        True\r\n    )\r\n    rebars.append(rebar)\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = rebars\r\n",
      "Engine": "CPython3",
