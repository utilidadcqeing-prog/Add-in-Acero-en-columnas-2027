    {
      "ConcreteType": "DSRevitNodesUI.Categories, DSRevitNodesUI",
      "SelectedIndex": 32,
      "SelectedString": "OST_Rebar",
      "Id": "2a06fb413eed47998daf0ae540fc5e01",
      "NodeType": "ExtensionNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "19c35545b5e9473989f6ac9e83d3ce44",
          "Name": "Category",
          "Description": "La categoría seleccionada",
          "UsingDefaultValue": false,
