    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# --- SCRIPT EMPALMES REVIT 2026 (CPYTHON) ---\r\n# Versión: 5.3 (Input Debugger)\r\n# Objetivo: Diagnosticar por qué el script recibe \"nada\" o filtra todo.\r\n# Muestra conteos de entradas y estado de validez de cada elemento.\r\n\r\nimport clr\r\nimport sys\r\nfrom System.Collections.Generic import List\r\n\r\n# --- IMPORTACIONES REVIT ---\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitServices\")\r\nclr.AddReference(\"RevitNodes\")\r\n\r\nfrom Autodesk.Revit.DB import (\r\n    XYZ, ElementId, Line, BuiltInParameter, \r\n    Transaction, Element, BuiltInCategory\r\n)\r\nfrom Autodesk.Revit.DB.Structure import (\r\n    Rebar, RebarSpliceOptions, RebarSpliceUtils, \r\n    RebarSplicePosition, RebarSpliceError, RebarSpliceGeometry,\r\n    RebarLayoutRule\r\n)\r\n\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# --- INPUTS ---\r\nrun_script = IN[0]\r\ninput_rebars = IN[1]\r\ninput_types  = IN[2]\r\ninput_planes = IN[3]\r\n\r\nMETROS_A_PIES = 3.280839895\r\n\r\n# --- HELPERS ---\r\ndef to_list(obj):\r\n    if isinstance(obj, list):\r\n        flat = []\r\n        for item in obj: flat.extend(to_list(item))\r\n        return flat\r\n    else: return [obj]\r\n\r\ndef to_feet(val): return val * METROS_A_PIES\r\ndef to_meters(val): return val / METROS_A_PIES\r\n\r\ndef dynamo_plane_to_revit(plano_dyn):\r\n    try:\r\n        if hasattr(plano_dyn, \"Origin\") and hasattr(plano_dyn, \"Normal\"):\r\n            o = plano_dyn.Origin\r\n            n = plano_dyn.Normal\r\n            origin = XYZ(to_feet(o.X), to_feet(o.Y), to_feet(o.Z))\r\n            normal = XYZ(n.X, n.Y, n.Z).Normalize()\r\n            return origin, normal\r\n    except: return None, None\r\n    return None, None\r\n\r\ndef validate_splice_type(elem):\r\n    if not elem: return None\r\n    if isinstance(elem, Element):\r\n        if elem.Category:\r\n            try: cat_val = elem.Category.Id.Value\r\n            except: \r\n                try: cat_val = elem.Category.Id.IntegerValue\r\n                except: return None\r\n            if cat_val == int(BuiltInCategory.OST_RebarSpliceType):\r\n                return elem.Id\r\n    return None\r\n\r\ndef get_best_intersection(rebar, plane_origin):\r\n    try:\r\n        accessor = rebar.GetShapeDrivenAccessor()\r\n        curves = accessor.ComputeDrivingCurves()\r\n        candidates = []\r\n        for i, c in enumerate(curves):\r\n            if isinstance(c, Line):\r\n                p0, p1 = c.GetEndPoint(0), c.GetEndPoint(1)\r\n                vec_bar = p1.Subtract(p0)\r\n                len_sq = vec_bar.GetLength()**2\r\n                if len_sq < 1e-9: continue\r\n                vec_plane = plane_origin.Subtract(p0)\r\n                t = vec_plane.DotProduct(vec_bar) / len_sq\r\n                if -0.5 <= t <= 1.5:\r\n                    pt = p0.Add(vec_bar.Multiply(t))\r\n                    candidates.append((vec_bar.GetLength(), pt, vec_bar, t))\r\n        if not candidates: return None, None, 0, \"No Intersect\"\r\n        candidates.sort(key=lambda x: x[0], reverse=True)\r\n        best = candidates[0]\r\n        return best[1], best[2], best[3], f\"SegLen={round(to_meters(best[0]),2)}m\"\r\n    except Exception as e: return None, None, 0, str(e)\r\n\r\n# --- CORE LOGIC ---\r\ndef perform_splice(doc, bar_id, type_id, point, vec):\r\n    offsets = [0, 0.164, -0.164]\r\n    positions = [RebarSplicePosition.Middle, RebarSplicePosition.End1, RebarSplicePosition.End2]\r\n    \r\n    for pos in positions:\r\n        for off in offsets:\r\n            try:\r\n                pt = point if off == 0 else point.Add(vec.Multiply(off))\r\n                geom = RebarSpliceGeometry(pt, vec)\r\n                opts = RebarSpliceOptions(doc, type_id, pos)\r\n                \r\n                if RebarSpliceUtils.CanRebarBeSpliced(doc.GetElement(bar_id), opts, geom) == RebarSpliceError.Success:\r\n                    g_list = List[RebarSpliceGeometry]()\r\n                    g_list.Add(geom)\r\n                    res = RebarSpliceUtils.SpliceRebar(doc, bar_id, opts, g_list)\r\n                    if res and len(res) > 0:\r\n                        geom.Dispose()\r\n                        return list(res), f\"OK_{pos}\"\r\n                geom.Dispose()\r\n            except: pass\r\n    return [], \"ZeroIDs\"\r\n\r\ndef robust_workflow(doc, bar, type_id, pt, tan):\r\n    # Captura\r\n    try: \r\n        acc = bar.GetShapeDrivenAccessor()\r\n        qty = bar.Quantity\r\n        arr_len = acc.ArrayLength\r\n        is_set = qty > 1\r\n        \r\n        # Intentamos cortar normal\r\n        new_ids, status = perform_splice(doc, bar.Id, type_id, pt, tan.Normalize())\r\n        \r\n        if new_ids: return new_ids, f\"EXITO: {status}\"\r\n        \r\n        # Fallback Single\r\n        if is_set:\r\n            try:\r\n                acc.SetLayoutAsFixedNumber(1, arr_len, True, True, True)\r\n                doc.Regenerate()\r\n                new_ids, s2 = perform_splice(doc, bar.Id, type_id, pt, tan.Normalize())\r\n                \r\n                # Restaurar (Siempre, incluso si falla)\r\n                if new_ids:\r\n                    # Restaurar las nuevas a MaxSpacing (Aproximado seguro)\r\n                    for nid in new_ids:\r\n                        nbar = doc.GetElement(nid)\r\n                        if nbar: nbar.GetShapeDrivenAccessor().SetLayoutAsMaximumSpacing(0.656, arr_len, True, True, True)\r\n                    return new_ids, f\"EXITO_SINGLE: {s2}\"\r\n                else:\r\n                    # Restaurar original\r\n                    acc.SetLayoutAsFixedNumber(qty, arr_len, True, True, True) # O MaxSpacing si se pudiera leer parametro facil\r\n                    return [], f\"FAIL_SINGLE: {s2}\"\r\n            except Exception as e:\r\n                return [], f\"ERR_SINGLE: {str(e)}\"\r\n        \r\n        return [], f\"FAIL: {status}\"\r\n    except Exception as ex: return [], f\"ERR_MAIN: {str(ex)}\"\r\n\r\n# --- DIAGNOSTIC MAIN ---\r\ndef execute_debug(rebars_in, types_in, planes_in):\r\n    # 1. Analisis Inputs Raw\r\n    raw_rebars = to_list(rebars_in)\r\n    raw_types = to_list(types_in)\r\n    raw_planes = to_list(planes_in)\r\n    \r\n    debug_logs = []\r\n    debug_logs.append(f\"Inputs Recibidos: Rebars={len(raw_rebars)}, Tipos={len(raw_types)}, Planos={len(raw_planes)}\")\r\n    \r\n    # 2. Unwrap y Validacion\r\n    valid_rebars = []\r\n    for i, r in enumerate(raw_rebars):\r\n        unwrapped = UnwrapElement(r)\r\n        if unwrapped and unwrapped.IsValidObject:\r\n            valid_rebars.append(unwrapped)\r\n        else:\r\n            debug_logs.append(f\"Rebar[{i}] INVÁLIDA o NULA (Posiblemente borrada)\")\r\n            \r\n    debug_logs.append(f\"Rebars Válidas para procesar: {len(valid_rebars)}\")\r\n    \r\n    if not valid_rebars: return [], debug_logs\r\n    \r\n    # 3. Validar Tipos\r\n    valid_types = []\r\n    for t in raw_types:\r\n        tid = validate_splice_type(UnwrapElement(t))\r\n        valid_types.append(tid)\r\n    \r\n    # 4. Proceso\r\n    num = min(len(valid_types), len(raw_planes))\r\n    if num == 0: debug_logs.append(\"Cero cortes a procesar (Faltan tipos o planos)\")\r\n    \r\n    pool = [r.Id for r in valid_rebars]\r\n    \r\n    for i in range(num):\r\n        p_org, _ = dynamo_plane_to_revit(raw_planes[i])\r\n        tid = valid_types[i]\r\n        \r\n        if not p_org: \r\n            debug_logs.append(f\"Corte {i}: Plano Malo\")\r\n            continue\r\n        if not tid:\r\n            debug_logs.append(f\"Corte {i}: Tipo Malo\")\r\n            continue\r\n            \r\n        next_pool = []\r\n        cut_happened = False\r\n        \r\n        current_list = list(pool)\r\n        for bid in current_list:\r\n            bar = doc.GetElement(bid)\r\n            if not bar: continue\r\n            \r\n            pt, tan, t, info = get_best_intersection(bar, p_org)\r\n            \r\n            if pt:\r\n                new_ids, msg = robust_workflow(doc, bar, tid, pt, tan)\r\n                if new_ids:\r\n                    next_pool.extend(new_ids)\r\n                    cut_happened = True\r\n                else:\r\n                    next_pool.append(bid)\r\n                    debug_logs.append(f\"Corte {i} ID {bid}: {msg} [{info}]\")\r\n            else:\r\n                next_pool.append(bid)\r\n                debug_logs.append(f\"Corte {i} ID {bid}: No Intersecta\")\r\n        \r\n        pool = next_pool\r\n        if cut_happened: doc.Regenerate()\r\n        \r\n    return pool, debug_logs\r\n\r\nif run_script:\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n    try:\r\n        f_ids, f_logs = execute_debug(input_rebars, input_types, input_planes)\r\n        TransactionManager.Instance.TransactionTaskDone()\r\n        \r\n        final_msg = \"V5.3 Debugger Completado\"\r\n        if not f_ids: final_msg = \"ALERTA: Pool Final Vacío\"\r\n        \r\n        OUT = [[str(i.Value) for i in f_ids], f_logs, final_msg]\r\n    except Exception as e:\r\n        TransactionManager.Instance.ForceCloseTransaction()\r\n        OUT = [[], [str(e)], \"Crash\"]\r\nelse:\r\n    OUT = [[], [\"Script Off\"], \"Off\"]",
      "Engine": "CPython3",
