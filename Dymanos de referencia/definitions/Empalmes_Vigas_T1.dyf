    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# IN[0]: lista de textos (opc. vacío)\r\n# IN[1]: lista de números (opc. vacío)\r\nimport math\r\n\r\ndef as_list(x):\r\n    return x if isinstance(x, list) else ([] if x is None else [x])\r\n\r\ndef canon(val):\r\n    # normaliza a float y redondea para comparar\r\n    try:\r\n        return round(float(val), 9)\r\n    except:\r\n        return None\r\n\r\ntexts = as_list(IN[0])\r\nnums  = as_list(IN[1])\r\n\r\ntext_vals = set()\r\nfor t in texts:\r\n    c = canon(t)\r\n    if c is not None:\r\n        text_vals.add(c)\r\n\r\nresult = []\r\nfor n in nums:\r\n    c = canon(n)\r\n    result.append(c in text_vals if c is not None else False)\r\n\r\nOUT = result\r\n",
