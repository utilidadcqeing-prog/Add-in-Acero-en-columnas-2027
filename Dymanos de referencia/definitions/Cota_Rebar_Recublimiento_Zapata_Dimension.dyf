    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "14e255b9e7d242828166c2b66ad142b6",
      "NodeType": "CodeBlockNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "efe16a7311844aea9f4fd1eeaa1ebdbc",
          "Name": "integer",
          "Description": "3",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Permite creación directa de código de DesignScript",
      "Code": "3;"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# Importar bibliotecas principales de Revit API\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# Importar Servicios de Documentos\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\n# Importar bibliotecas de Dynamo para conversión de geometría\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# --- GESTIÓN ROBUSTA DE ENTRADAS ---\r\ninput_elements = UnwrapElement(IN[0])\r\ninput_views = UnwrapElement(IN[1]) # Nueva entrada para vistas\r\n\r\n# 1. Normalizar Elementos a lista\r\nif isinstance(input_elements, list):\r\n    elements = input_elements\r\nelse:\r\n    elements = [input_elements]\r\n\r\n# 2. Normalizar Vistas a lista alineada con los elementos\r\nif isinstance(input_views, list):\r\n    views = input_views\r\n    # Nota: Si la lista de vistas es más corta que la de elementos, \r\n    # el bucle 'zip' se detendrá en el más corto.\r\nelse:\r\n    # Si es una sola vista, repetirla para cada elemento\r\n    views = [input_views] * len(elements)\r\n\r\ndef get_separated_references(element, specific_view):\r\n    \"\"\"\r\n    Extrae referencias separando Superficies de Líneas/Curvas.\r\n    Usa la vista específica proporcionada para la geometría dependiente de vista.\r\n    \"\"\"\r\n    # Listas para Superficies (Faces)\r\n    s_refs = []\r\n    s_geoms = []\r\n    \r\n    # Listas para Líneas (Edges, Curves, Points)\r\n    c_refs = []\r\n    c_geoms = []\r\n    \r\n    # Definir configuraciones de extracción\r\n    options_list = []\r\n    \r\n    # 1. Configuración de Modelo (Geometría 3D pura, independiente de la vista)\r\n    opt_model = Options()\r\n    opt_model.ComputeReferences = True\r\n    opt_model.DetailLevel = ViewDetailLevel.Fine\r\n    opt_model.IncludeNonVisibleObjects = True \r\n    options_list.append(opt_model)\r\n    \r\n    # 2. Configuración de Vista Específica (Geometría proyectada/dependiente)\r\n    if specific_view:\r\n        try:\r\n            opt_view = Options()\r\n            opt_view.ComputeReferences = True\r\n            opt_view.IncludeNonVisibleObjects = True\r\n            # Asignamos la vista específica pasada por argumento\r\n            opt_view.View = specific_view\r\n            options_list.append(opt_view)\r\n        except:\r\n            pass # Si la vista no es válida, ignoramos esta opción\r\n\r\n    def process_geometry_object(g):\r\n        \r\n        # --- CASO A: SÓLIDOS ---\r\n        if isinstance(g, Solid):\r\n            # Caras -> Lista de Superficies\r\n            if g.Faces:\r\n                for face in g.Faces:\r\n                    if face.Reference:\r\n                        s_refs.append(face.Reference)\r\n                        s_geoms.append(face.ToProtoType())\r\n            # Bordes -> Lista de Curvas\r\n            if g.Edges:\r\n                for edge in g.Edges:\r\n                    if edge.Reference:\r\n                        c = edge.AsCurve()\r\n                        if c:\r\n                            c_refs.append(edge.Reference)\r\n                            c_geoms.append(c.ToProtoType())\r\n\r\n        # --- CASO B: CURVAS ---\r\n        elif isinstance(g, Curve):\r\n            if g.Reference:\r\n                c_refs.append(g.Reference)\r\n                c_geoms.append(g.ToProtoType())\r\n\r\n        # --- CASO C: PUNTOS ---\r\n        elif isinstance(g, Point):\r\n            if g.Reference:\r\n                c_refs.append(g.Reference)\r\n                c_geoms.append(g.ToProtoType())\r\n                \r\n        # --- CASO D: POLILÍNEAS ---\r\n        elif isinstance(g, PolyLine):\r\n             try:\r\n                 pass \r\n             except:\r\n                 pass\r\n\r\n        # --- CASO E: INSTANCIAS ---\r\n        elif isinstance(g, GeometryInstance):\r\n            inst_geo = g.GetInstanceGeometry()\r\n            if inst_geo:\r\n                for sub_g in inst_geo:\r\n                    process_geometry_object(sub_g)\r\n\r\n    # Ejecutar la extracción para cada configuración\r\n    for opt in options_list:\r\n        try:\r\n            geom_elem = element.get_Geometry(opt)\r\n            if geom_elem:\r\n                for geom_obj in geom_elem:\r\n                    process_geometry_object(geom_obj)\r\n        except Exception:\r\n            continue\r\n            \r\n    return s_refs, s_geoms, c_refs, c_geoms\r\n\r\n# Listas maestras de salida\r\nout_surf_refs = []  # OUT[0]\r\nout_surf_geoms = [] # OUT[1]\r\nout_curve_refs = [] # OUT[2]\r\nout_curve_geoms = []# OUT[3]\r\n\r\n# Procesar pares (Elemento, Vista)\r\n# Usamos 'zip' para iterar ambas listas simultáneamente\r\nfor elem, view in zip(elements, views):\r\n    try:\r\n        sr, sg, cr, cg = get_separated_references(elem, view)\r\n        \r\n        out_surf_refs.append(sr)\r\n        out_surf_geoms.append(sg)\r\n        out_curve_refs.append(cr)\r\n        out_curve_geoms.append(cg)\r\n    except Exception:\r\n        # Si falla, mantenemos la estructura de la lista con listas vacías\r\n        out_surf_refs.append([])\r\n        out_surf_geoms.append([])\r\n        out_curve_refs.append([])\r\n        out_curve_geoms.append([])\r\n\r\n# Estructura de salida ordenada\r\nOUT = [out_surf_refs, out_surf_geoms, out_curve_refs, out_curve_geoms]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
