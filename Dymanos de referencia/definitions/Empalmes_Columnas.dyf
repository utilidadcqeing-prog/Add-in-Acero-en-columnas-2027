      "Description": "Filtra una secuencia mediante la búsqueda de los índices correspondientes en una lista separada de booleanos.\n\nList.FilterByBoolMask (list: var[]..[], mask: var[]..[]): var[]..[]"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "4cc150e3b3524d23a8300925ee9c2103",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "8cfe6e6e587946449f836a847e6b945f",
          "Name": "list",
          "Description": "Lista de la que se debe obtener el primer elemento.\n\nvar[]..[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "b6248b4293844679b541bd05708644ba",
          "Name": "item",
          "Description": "Primer elemento de la lista.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "DSCore.List.FirstItem@var[]..[]",
      "Replication": "Auto",
      "Description": "Devuelve el primer elemento de una lista.\n\nList.FirstItem (list: var[]..[]): var[]..[]"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport sys\r\nfrom System import Enum\r\nimport math\r\n\r\n# --- IMPORTACIONES ---\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitServices\")\r\nclr.AddReference(\"RevitNodes\")\r\n\r\nfrom Autodesk.Revit.DB import XYZ, Element, BuiltInParameter, Line\r\nfrom Autodesk.Revit.DB.Structure import (\r\n    Rebar,\r\n    RebarSpliceOptions,\r\n    RebarSpliceUtils,\r\n    RebarSplicePosition,\r\n    RebarSpliceError,\r\n    RebarSpliceGeometry\r\n)\r\n\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nfrom System.Collections.Generic import List\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# --- INPUTS ---\r\nrun_script = IN[0]\r\nrebars_in  = IN[1]\r\ntypes_in   = IN[2]\r\nplanes_in  = IN[3]\r\n\r\n# --- CONFIGURACIÓN ---\r\nMAX_RETRIES = 10 \r\nMETROS_A_PIES = 3.280839895\r\nPIES_A_METROS = 0.3048\r\n\r\n# --- HELPERS ---\r\ndef flatten_inputs(input_obj):\r\n    flat = []\r\n    if isinstance(input_obj, list):\r\n        for i in input_obj: flat.extend(flatten_inputs(i))\r\n    else: flat.append(input_obj)\r\n    return flat\r\n\r\ndef to_list(obj):\r\n    if isinstance(obj, list): return obj\r\n    return [obj]\r\n\r\ndef to_api_units(v): return v * METROS_A_PIES\r\n\r\ndef get_id_str(element_id):\r\n    try: return str(element_id.Value)\r\n    except:\r\n        try: return str(element_id.IntegerValue)\r\n        except: return str(element_id)\r\n\r\ndef get_geometry_args(dynamo_plane):\r\n    origin, normal = None, None\r\n    if hasattr(dynamo_plane, \"Origin\") and hasattr(dynamo_plane, \"Normal\"):\r\n        o, n = dynamo_plane.Origin, dynamo_plane.Normal\r\n        origin = XYZ(to_api_units(o.X), to_api_units(o.Y), to_api_units(o.Z))\r\n        normal = XYZ(n.X, n.Y, n.Z).Normalize()\r\n    elif hasattr(dynamo_plane, \"PointAtParameter\") and hasattr(dynamo_plane, \"NormalAtParameter\"):\r\n        pt, nv = dynamo_plane.PointAtParameter(0.5, 0.5), dynamo_plane.NormalAtParameter(0.5, 0.5)\r\n        origin = XYZ(to_api_units(pt.X), to_api_units(pt.Y), to_api_units(pt.Z))\r\n        normal = XYZ(nv.X, nv.Y, nv.Z).Normalize()\r\n    return origin, normal\r\n\r\ndef get_intersection_point_on_bar(rebar, plane_z):\r\n    try:\r\n        curves = rebar.GetShapeDrivenAccessor().ComputeDrivingCurves()\r\n        for c in curves:\r\n            if isinstance(c, Line):\r\n                p0 = c.GetEndPoint(0)\r\n                p1 = c.GetEndPoint(1)\r\n                z_min, z_max = min(p0.Z, p1.Z), max(p0.Z, p1.Z)\r\n                if z_min - 0.01 <= plane_z <= z_max + 0.01:\r\n                    if abs(p1.Z - p0.Z) < 1e-9: return (p0 + p1) / 2.0\r\n                    t = (plane_z - p0.Z) / (p1.Z - p0.Z)\r\n                    return XYZ(p0.X + t * (p1.X - p0.X), p0.Y + t * (p1.Y - p0.Y), plane_z)\r\n        return None\r\n    except: return None\r\n\r\ndef try_splice_low_level(doc, rebar_id, type_id, geom, opts):\r\n    try:\r\n        rebar = doc.GetElement(rebar_id)\r\n        if not rebar or not rebar.IsValidObject: return False, [], \"Barra Inválida\"\r\n        \r\n        check = RebarSpliceUtils.CanRebarBeSpliced(rebar, opts, geom)\r\n        if check == RebarSpliceError.Success:\r\n            g_list = List[RebarSpliceGeometry]()\r\n            g_list.Add(geom)\r\n            res_ids = RebarSpliceUtils.SpliceRebar(doc, rebar_id, opts, g_list)\r\n            return True, list(res_ids), \"OK\"\r\n        \r\n        err_str = str(check)\r\n        if str(check) == \"7\" or \"DoesNotIntersect\" in str(check): err_str = \"Err7(No Intersecta)\"\r\n        elif \"TooShort\" in str(check): err_str = \"Muy Corto\"\r\n        return False, [], err_str\r\n    except Exception as e:\r\n        return False, [], str(e)\r\n\r\ndef process_single_bar_v38(bar_data, planes, splice_types):\r\n    root_rebar = bar_data['element']\r\n    if not root_rebar.IsValidObject: return False, [], [\"ID Eliminado\"]\r\n\r\n    active_pool = [root_rebar.Id]\r\n    any_modification = False\r\n    error_log = []\r\n    \r\n    total_planes = len(planes)\r\n    num_types = len(splice_types)\r\n    \r\n    # CORRECCIÓN V38: Iteramos por índice para asegurar que se procesen TODOS los planos\r\n    for i in range(total_planes):\r\n        plane = planes[i]\r\n        \r\n        # Reciclamos el tipo de empalme si hay menos tipos que planos\r\n        s_type = splice_types[i % num_types]\r\n        \r\n        raw_origin, normal = get_geometry_args(plane)\r\n        if not raw_origin: \r\n            error_log.append(f\"Corte {i+1}: Geom Nula\")\r\n            continue\r\n            \r\n        # --- LÓGICA DE POSICIÓN ---\r\n        target = \"Middle\"\r\n        if i == total_planes - 1: # Último plano\r\n            target = \"Bottom\"\r\n        else: # Planos anteriores\r\n            target = \"Middle\"\r\n\r\n        # ESTRATEGIAS\r\n        strategies = []\r\n        if target == \"Bottom\":\r\n            strategies.append({'n': normal, 'p': RebarSplicePosition.End2, 'tag': 'End2(Std)'})\r\n            strategies.append({'n': normal.Negate(), 'p': RebarSplicePosition.End1, 'tag': 'End1(Inv)'})\r\n            strategies.append({'n': normal, 'p': RebarSplicePosition.End1, 'tag': 'End1(Fallback)'})\r\n        else:\r\n            strategies.append({'n': normal, 'p': RebarSplicePosition.Middle, 'tag': 'Mid'})\r\n            strategies.append({'n': normal.Negate(), 'p': RebarSplicePosition.Middle, 'tag': 'Mid(Inv)'})\r\n\r\n        cut_success = False\r\n        candidates = list(active_pool)\r\n        \r\n        for cand_id in candidates:\r\n            try: \r\n                current_rebar = doc.GetElement(cand_id)\r\n                if not current_rebar: continue\r\n                snapped_origin = get_intersection_point_on_bar(current_rebar, raw_origin.Z)\r\n                final_origin = snapped_origin if snapped_origin else raw_origin\r\n            except: final_origin = raw_origin\r\n            \r\n            cand_errors = []\r\n            \r\n            for strat in strategies:\r\n                geom = None\r\n                try:\r\n                    geom = RebarSpliceGeometry(final_origin, strat['n'])\r\n                    opts = RebarSpliceOptions(doc, s_type.Id, strat['p'])\r\n                    \r\n                    success, res_ids, msg = try_splice_low_level(doc, cand_id, s_type.Id, geom, opts)\r\n                    \r\n                    if success:\r\n                        if cand_id in active_pool: active_pool.remove(cand_id)\r\n                        for rid in res_ids: \r\n                            if rid not in active_pool: active_pool.append(rid)\r\n                        any_modification = True\r\n                        doc.Regenerate()\r\n                        cut_success = True\r\n                        break \r\n                    else:\r\n                        cand_errors.append(f\"{strat['tag']}:{msg}\")\r\n                except Exception as ex:\r\n                    pass\r\n                finally:\r\n                    if geom: geom.Dispose()\r\n            \r\n            if cut_success: break # Ya cortamos un fragmento con este plano, pasamos al siguiente plano\r\n\r\n        if not cut_success:\r\n            error_log.append(f\"Corte {i+1} Falló. Detalles: \" + \" | \".join(cand_errors))\r\n\r\n    return any_modification, active_pool, error_log\r\n\r\n# --- EJECUCIÓN ---\r\nif not run_script:\r\n    OUT = [\"PAUSA\", [], [], []]\r\nelse:\r\n    raw_inputs = flatten_inputs(rebars_in)\r\n    \r\n    out_input_ids = []\r\n    out_traceability = []\r\n    out_failed_ids = []\r\n    out_debug_log = []\r\n    \r\n    valid_bars_queue = []\r\n    \r\n    for item in raw_inputs:\r\n        if item:\r\n            try:\r\n                u = UnwrapElement(item)\r\n                if isinstance(u, Rebar) and u.IsValidObject:\r\n                    sid = get_id_str(u.Id)\r\n                    out_input_ids.append(sid)\r\n                    entry = {'element': u, 'id': sid, 'done': False, 'logs': []}\r\n                    valid_bars_queue.append(entry)\r\n            except: pass\r\n\r\n    splice_types = []\r\n    for t in to_list(types_in):\r\n        if t:\r\n            u = UnwrapElement(t)\r\n            if isinstance(u, Element): splice_types.append(u)\r\n    planes = to_list(planes_in)\r\n\r\n    if not valid_bars_queue:\r\n        OUT = [out_input_ids, [\"No valid bars\"], [], [\"IN[1] Vacío\"]]\r\n    elif not splice_types: # Corrección de seguridad\r\n        OUT = [out_input_ids, [\"Error: No Splice Types\"], [], [\"IN[2] Vacío\"]]\r\n    elif not planes:\r\n        OUT = [out_input_ids, [\"Error: No Planes\"], [], [\"IN[3] Vacío\"]]\r\n    else:\r\n        TransactionManager.Instance.EnsureInTransaction(doc)\r\n        \r\n        pending_queue = valid_bars_queue\r\n        retry_count = 0\r\n        final_results = {}\r\n        \r\n        while len(pending_queue) > 0 and retry_count < MAX_RETRIES:\r\n            next_round = []\r\n            for entry in pending_queue:\r\n                try:\r\n                    mod, final_pool, logs = process_single_bar_v38(entry, planes, splice_types)\r\n                    entry['logs'] = logs\r\n                    \r\n                    if mod:\r\n                        final_results[entry['id']] = final_pool\r\n                        entry['done'] = True\r\n                    else:\r\n                        if entry['element'].IsValidObject: next_round.append(entry)\r\n                        else: final_results[entry['id']] = None\r\n                except Exception as e:\r\n                    entry['logs'].append(str(e))\r\n                    next_round.append(entry)\r\n            \r\n            pending_queue = next_round\r\n            if not pending_queue: break\r\n            doc.Regenerate()\r\n            retry_count += 1\r\n        \r\n        TransactionManager.Instance.TransactionTaskDone()\r\n        \r\n        global_counter = 1\r\n        for entry in valid_bars_queue:\r\n            oid = entry['id']\r\n            if oid in final_results and final_results[oid]:\r\n                for child_id in final_results[oid]:\r\n                    cid_str = get_id_str(child_id)\r\n                    out_traceability.append(f\"Barra {global_counter} - ID actual: {cid_str} - ID barra anterior: {oid}\")\r\n                    global_counter += 1\r\n            else:\r\n                out_failed_ids.append(oid)\r\n                reasons = \" || \".join(entry['logs'])\r\n                out_debug_log.append(f\"ID {oid}: {reasons}\")\r\n\r\n        OUT = [out_input_ids, out_traceability, out_failed_ids, out_debug_log]",
      "Engine": "CPython3",
