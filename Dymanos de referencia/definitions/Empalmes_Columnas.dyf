{
  "Uuid": "bc05eb84-87aa-4d49-8d78-9a915835b167",
  "IsCustomNode": true,
  "Category": "01_Nodos_CQING",
  "Description": "Crea empalmes en barras verticales. Rebar, Número de empalmes, Planos de empalmes, Longitudes de empalmes, Tipo de barra.",
  "Name": "Empalmes_Columnas",
  "ElementResolver": {
    "ResolutionMap": {}
  },
