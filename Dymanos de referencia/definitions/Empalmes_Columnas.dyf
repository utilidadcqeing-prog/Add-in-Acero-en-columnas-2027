          "Name": "",
          "Description": "Boolean",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Permite la selección entre \"True\" (verdadero) y \"False\" (falso).",
      "InputValue": true
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitServices\")\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\nfrom Autodesk.Revit.DB import FilteredElementCollector, BuiltInCategory, BuiltInParameter\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\ndef safe_name(e):\r\n    for getter in (\r\n        lambda: e.Name,\r\n        lambda: e.get_Parameter(BuiltInParameter.ALL_MODEL_TYPE_NAME).AsString(),\r\n        lambda: e.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM).AsString()\r\n    ):\r\n        try:\r\n            v = getter()\r\n            if v:\r\n                return v\r\n        except:\r\n            pass\r\n    return \"<sin nombre>\"\r\n\r\ndef safe_id(eid):\r\n    # Maneja distintos bindings de ElementId\r\n    for attr in (\"IntegerValue\", \"Value\"):\r\n        try:\r\n            v = getattr(eid, attr)\r\n            v = v() if callable(v) else v\r\n            return int(v)\r\n        except:\r\n            pass\r\n    try:\r\n        return int(str(eid))\r\n    except:\r\n        return None\r\n\r\nif doc is None:\r\n    OUT = \"No hay documento Revit.\"\r\nelif not hasattr(BuiltInCategory, \"OST_RebarSpliceType\"):\r\n    OUT = \"Tu Revit no expone la categoría RebarSpliceType (requiere 2025+).\"\r\nelse:\r\n    types = list(\r\n        FilteredElementCollector(doc)\r\n        .OfCategory(BuiltInCategory.OST_RebarSpliceType)\r\n        .WhereElementIsElementType()\r\n    )\r\n    if not types:\r\n        OUT = \"No hay tipos de empalme en el modelo.\"\r\n    else:\r\n        sorted_types = sorted(types, key=lambda t: safe_name(t))\r\n        names = [safe_name(t) for t in sorted_types]\r\n        ids = [safe_id(t.Id) for t in sorted_types]\r\n        elements_ds = [t.ToDSType(True) for t in sorted_types]\r\n\r\n        items = [{\"name\": n, \"id\": i, \"element\": e} for n, i, e in zip(names, ids, elements_ds)]\r\n\r\n        OUT = {\r\n            \"names\": names,\r\n            \"ids\": ids,\r\n            \"elements\": elements_ds,  # úsalo directo en GetParameterByName\r\n            \"items\": items\r\n        }\r\n",
