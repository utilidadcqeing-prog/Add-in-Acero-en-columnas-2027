    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitServices\")\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\nfrom Autodesk.Revit.DB import BuiltInParameter, ElementType, FilteredElementCollector\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Entradas\r\ncount_in = IN[0]\r\nvalues_in = IN[1]\r\nprefix = IN[2] if IN[2] is not None else \"\"\r\nbase_type = UnwrapElement(IN[3])\r\n\r\ndef divisor_from_prefix(txt):\r\n    t = (txt or \"\").lower()\r\n    if \"#10\" in t: return 1.9348\r\n    if \"#9\"  in t: return 1.7205\r\n    if \"#8\"  in t: return 1.524\r\n    if \"#7\"  in t: return 1.3335\r\n    if \"#6\"  in t: return 1.143\r\n    if \"#5\"  in t: return 0.9525\r\n    if \"#4\"  in t: return 0.762\r\n    if \"#3\"  in t: return 0.5715\r\n    return 0.762  # fallback\r\n\r\ndivisor = divisor_from_prefix(prefix)\r\n\r\ndef safe_name(e):\r\n    for getter in (\r\n        lambda: e.Name,\r\n        lambda: e.get_Parameter(BuiltInParameter.ALL_MODEL_TYPE_NAME).AsString(),\r\n        lambda: e.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM).AsString()\r\n    ):\r\n        try:\r\n            v = getter()\r\n            if v:\r\n                return v\r\n        except:\r\n            pass\r\n    return None\r\n\r\ndef get_lap_param(t):\r\n    for bip in (BuiltInParameter.REBAR_SPLICE_LAP_LENGTH_MULTIPLIER,):\r\n        try:\r\n            p = t.get_Parameter(bip)\r\n            if p: return p\r\n        except: pass\r\n    return t.LookupParameter(\"Multiplicador de longitudes de solape\")\r\n\r\ndef find_existing(name, category_id):\r\n    try:\r\n        for et in FilteredElementCollector(doc).WhereElementIsElementType():\r\n            try:\r\n                if et.Category and et.Category.Id == category_id:\r\n                    if safe_name(et) == name:\r\n                        return et\r\n            except:\r\n                continue\r\n    except:\r\n        pass\r\n    return None\r\n\r\n# Validaciones\r\nerrors = []\r\ntry:\r\n    count = int(count_in)\r\nexcept:\r\n    count = 0\r\n    errors.append(\"IN[0] debe ser entero > 0\")\r\n\r\nvals = values_in if isinstance(values_in, list) else ([values_in] if values_in is not None else [])\r\nif count <= 0:\r\n    errors.append(\"IN[0] debe ser entero > 0\")\r\nif len(vals) != count:\r\n    errors.append(\"IN[1] debe tener exactamente {} valores\".format(count))\r\nif base_type is None or not isinstance(base_type, ElementType):\r\n    errors.append(\"IN[3] debe ser un ElementType de empalme\")\r\n\r\nif errors:\r\n    OUT = {\"created\": [], \"names\": [], \"multipliers\": [], \"errors\": errors}\r\nelse:\r\n    created, names, multipliers, errs = [], [], [], []\r\n\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n    cat_id = base_type.Category.Id if base_type.Category else None\r\n\r\n    for v in vals:\r\n        try:\r\n            v_num = float(v)\r\n        except:\r\n            errs.append(\"Valor no numérico: {}\".format(v))\r\n            continue\r\n\r\n        new_name = \"{} - {}\".format(prefix, v_num)\r\n        target_val = (60.0 * v_num) / divisor\r\n\r\n        existing = find_existing(new_name, cat_id) if cat_id else None\r\n        if existing:\r\n            new_type = existing\r\n            param = get_lap_param(new_type)\r\n            val = None\r\n            try:\r\n                if param: val = param.AsDouble()\r\n            except:\r\n                pass\r\n            multipliers.append(val)\r\n            errs.append(\"Reusado '{}' (ya existía, no se modificó)\".format(new_name))\r\n        else:\r\n            try:\r\n                new_type = base_type.Duplicate(new_name)\r\n            except Exception as e:\r\n                errs.append(\"No se pudo duplicar '{}': {}\".format(new_name, e))\r\n                continue\r\n\r\n            param = get_lap_param(new_type)\r\n            if param and not param.IsReadOnly:\r\n                try:\r\n                    param.Set(target_val)\r\n                    multipliers.append(target_val)\r\n                except Exception as e:\r\n                    errs.append(\"No se pudo asignar valor en '{}': {}\".format(new_name, e))\r\n                    multipliers.append(None)\r\n            else:\r\n                errs.append(\"Parámetro no encontrado o de solo lectura en '{}'\".format(new_name))\r\n                multipliers.append(None)\r\n\r\n        created.append(new_type.ToDSType(True))\r\n        names.append(new_name)\r\n\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n\r\n    OUT = {\r\n        \"created\": created,\r\n        \"names\": names,\r\n        \"multipliers\": multipliers,\r\n        \"errors\": errs\r\n    }\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "7cf9e2c470e34a4f8076d77d416e37e1",
