    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "4a94456e14f2407e8a53fd4a2d377200",
      "NodeType": "CodeBlockNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "a6d3a1e1513a494da214523e44bb8e08",
          "Name": "",
          "Description": "Valor de la expresión en la línea 1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Permite creación directa de código de DesignScript",
      "Code": "0.5;"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.DesignScript.Geometry import Surface\r\nimport math\r\n\r\ndef get_center(surface):\r\n    bbox = surface.BoundingBox\r\n    pt_min = bbox.MinPoint\r\n    pt_max = bbox.MaxPoint\r\n    return [(pt_min.X + pt_max.X)/2.0, (pt_min.Y + pt_max.Y)/2.0, (pt_min.Z + pt_max.Z)/2.0]\r\n\r\ndef extremos_superficies(surfaces):\r\n    if not surfaces or len(surfaces) < 2:\r\n        return surfaces\r\n    centers = [get_center(s) for s in surfaces]\r\n    max_dist = -1\r\n    idx_a, idx_b = 0, 0\r\n    for i, c1 in enumerate(centers):\r\n        for j, c2 in enumerate(centers):\r\n            dist = math.sqrt(sum([(a - b)**2 for a, b in zip(c1, c2)]))\r\n            if dist > max_dist:\r\n                max_dist = dist\r\n                idx_a, idx_b = i, j\r\n    vec_dir = [b - a for a, b in zip(centers[idx_a], centers[idx_b])]\r\n    norm = math.sqrt(sum([x**2 for x in vec_dir]))\r\n    dir_norm = [x / norm for x in vec_dir]\r\n    def proyectar(c, origen, dir_norm):\r\n        return sum([(ci - oi)*di for ci, oi, di in zip(c, origen, dir_norm)])\r\n    origen = centers[idx_a]\r\n    proyecciones = [proyectar(c, origen, dir_norm) for c in centers]\r\n    orden = sorted(range(len(proyecciones)), key=lambda k: proyecciones[k])\r\n    return [surfaces[orden[0]], surfaces[orden[-1]]]\r\n\r\ndef deep_process(item):\r\n    if isinstance(item, list):\r\n        return [deep_process(subitem) for subitem in item] if item and isinstance(item[0], list) else extremos_superficies(item)\r\n    else:\r\n        return item\r\n\r\nOUT = deep_process(IN[0])\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "0e972b0d1c8d405dbbf71b97e213e754",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "0d3e702523f64a058777e177378b722d",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "fb32b0cf7cf64e18b6cc4470c43ec532",
          "Name": "OUT",
          "Description": "Resultado de la secuencia de comandos de Python",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Ejecuta una secuencia de comandos de Python incrustada."
    },
