{
  "Uuid": "dc40f1a5-601c-4b3f-b83e-3dc4832faba5",
  "IsCustomNode": true,
  "Category": "01_Nodos_CQING",
  "Description": "Rota el gancho de la barra de armadura",
  "Name": "Set_Hook_Rotation_Angle_Rebar",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ==== ENTRADAS DE DYNAMO ====\r\nrebars = IN[0]\r\nrot_inicio = IN[1]      # Grados (fuera del plano) en extremo inicial, o None\r\nrot_final = IN[2]       # Grados (fuera del plano) en extremo final, o None\r\n\r\nimport clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nimport math\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\ndef tolist(x):\r\n    if isinstance(x, list): return x\r\n    else: return [x]\r\n\r\ndef rotar_gancho(rebar, ang_inicio, ang_final):\r\n    rvt_rebar = UnwrapElement(rebar)\r\n    cambios = False\r\n    # Rota gancho de inicio si aplica\r\n    if ang_inicio is not None and rvt_rebar.GetHookTypeId(0) != ElementId.InvalidElementId:\r\n        rvt_rebar.SetHookRotationAngle(math.radians(ang_inicio), 0)\r\n        cambios = True\r\n    # Rota gancho de final si aplica\r\n    if ang_final is not None and rvt_rebar.GetHookTypeId(1) != ElementId.InvalidElementId:\r\n        rvt_rebar.SetHookRotationAngle(math.radians(ang_final), 1)\r\n        cambios = True\r\n    return rebar if cambios else None\r\n\r\nrebars = tolist(rebars)\r\noutput = []\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\nfor rb in rebars:\r\n    resultado = rotar_gancho(rb, rot_inicio, rot_final)\r\n    output.append(resultado)\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = output if len(output) > 1 else output[0]\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
