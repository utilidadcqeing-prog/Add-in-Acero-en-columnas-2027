  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Entradas\r\nIni = IN[0]\r\nFin = IN[1]\r\nres1 = IN[2]  # Primera condición: Ini = True, Fin = True\r\nres2 = IN[3]  # Segunda condición: Ini = True, Fin = False\r\nres3 = IN[4]  # Tercera condición: Ini = False, Fin = True\r\nres4 = IN[5]  # Cuarta condición: Ini = False, Fin = False\r\n\r\n# Lógica anidada\r\nif Ini == True:\r\n    if Fin == True:\r\n        OUT = res1  # Primera condición\r\n    else:\r\n        OUT = res2  # Segunda condición\r\nelse:\r\n    if Fin == True:\r\n        OUT = res3  # Tercera condición\r\n    else:\r\n        OUT = res4  # Cuarta condición\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "7ffb7b7d9bc44386ba63bc79772fe43c",
      "NodeType": "PythonScriptNode",
