    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nsurfaces = IN[0]  # Lista plana de surfaces (ya aplanada con List.Flatten)\r\nline = IN[1]      # Línea a verificar\r\n\r\nintersected_surfaces = []\r\ndebug = []\r\n\r\nfor s in surfaces:\r\n    try:\r\n        intersection = s.Intersect(line)\r\n        debug.append(intersection)\r\n        if intersection and hasattr(intersection, \"__len__\") and len(intersection) > 0:\r\n            intersected_surfaces.append(s)\r\n    except Exception as e:\r\n        debug.append(\"Error: \" + str(e))\r\n\r\nOUT = (intersected_surfaces)\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "5bff121ac62b45c095584f1e6944e710",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "cf688548e97a433cbae49649fe1081d2",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "4ff59dfa9bb14f23b329a276e5a77137",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
