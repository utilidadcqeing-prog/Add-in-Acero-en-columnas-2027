          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "DSCore.List.FilterByBoolMask@var[]..[],var[]..[]",
      "Replication": "Auto",
      "Description": "Filtra una secuencia mediante la búsqueda de los índices correspondientes en una lista separada de booleanos.\n\nList.FilterByBoolMask (list: var[]..[], mask: var[]..[]): var[]..[]"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport sys\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# IN[0] = surfaces\r\nsurfaces = IN[0]\r\n\r\ndef surface_center(surface):\r\n    # Calcula el punto central en parámetros UV (0.5, 0.5)\r\n    return surface.PointAtParameter(0.5, 0.5)\r\n\r\nmax_dist = -1\r\npair = (None, None)\r\n\r\nn = len(surfaces)\r\nfor i in range(n):\r\n    center_i = surface_center(surfaces[i])\r\n    for j in range(i+1, n):\r\n        center_j = surface_center(surfaces[j])\r\n        dist = center_i.DistanceTo(center_j)\r\n        if dist > max_dist:\r\n            max_dist = dist\r\n            pair = (surfaces[i], surfaces[j])\r\n\r\nOUT = pair, max_dist\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "0f01d7456ae3405197b528f9c3b31f6d",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "126116ec09bd4ad89ed4de431dad60aa",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "d9d382fbf9c84a088b250fe084b4a6b1",
          "Name": "OUT",
          "Description": "Resultado de la secuencia de comandos de Python",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Ejecuta una secuencia de comandos de Python incrustada."
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "dac68df76bfc408b940be244f285fcff",
