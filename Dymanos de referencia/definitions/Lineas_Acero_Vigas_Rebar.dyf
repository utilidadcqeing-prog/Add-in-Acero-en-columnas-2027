    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "32de332c67874681ba2c7bfeea13a679",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "6633244253dd44d7adae55ac57518d82",
          "Name": "element",
          "Description": "Revit.Elements.Element",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "bee828985b494aada2bdd5d50dcc890d",
          "Name": "Element[]",
          "Description": "Todos los elementos cuya geometría está unida al elemento especificado.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "Revit.Elements.Element.GetJoinedElements",
      "Replication": "Auto",
      "Description": "Busca los elementos cuya geometría está unida al elemento especificado.\n\nElement.GetJoinedElements ( ): Element[]"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitServices')\r\nfrom Autodesk.Revit.DB import *\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nviga_sel = UnwrapElement(IN[0])\r\nvigas = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_StructuralFraming).WhereElementIsNotElementType().ToElements()\r\n\r\ndef get_id_val(obj):\r\n    # Si es int, devuelve directo\r\n    if type(obj) == int:\r\n        return obj\r\n    # Si es un ElementId (CPython3)\r\n    if obj.__class__.__name__ == \"ElementId\":\r\n        return int(str(obj))\r\n    # Si es un elemento Revit, accede a su Id\r\n    if hasattr(obj, 'Id'):\r\n        return get_id_val(obj.Id)\r\n    # Si es string, intenta convertir\r\n    try:\r\n        return int(obj)\r\n    except:\r\n        raise Exception(\"No se puede extraer IntegerValue del objeto (tipo {}): {}\".format(type(obj), obj))\r\n\r\ndef extremos_y_direccion(viga):\r\n    loc = viga.Location\r\n    if hasattr(loc, \"Curve\"):\r\n        curva = loc.Curve\r\n        p0 = curva.GetEndPoint(0)\r\n        p1 = curva.GetEndPoint(1)\r\n        vec = XYZ(p1.X - p0.X, p1.Y - p0.Y, p1.Z - p0.Z)\r\n        mag = vec.GetLength()\r\n        if mag == 0:\r\n            return [p0, p1], None\r\n        dir_norm = XYZ(vec.X/mag, vec.Y/mag, vec.Z/mag)\r\n        return [p0, p1], dir_norm\r\n    return [], None\r\n\r\ntolerancia = 0.001\r\numbral_direccion = 0.01\r\n\r\next_sel, dir_sel = extremos_y_direccion(viga_sel)\r\nvisitadas = set([get_id_val(viga_sel)])\r\ncola = [(viga_sel, ext_sel, dir_sel)]\r\nresultado = [viga_sel]\r\n\r\nwhile cola:\r\n    actual, extremos_act, dir_act = cola.pop(0)\r\n    for viga in vigas:\r\n        if get_id_val(viga) in visitadas:\r\n            continue\r\n        ext_viga, dir_viga = extremos_y_direccion(viga)\r\n        if dir_viga is None:\r\n            continue\r\n        dot = abs(dir_act.X * dir_viga.X + dir_act.Y * dir_viga.Y + dir_act.Z * dir_viga.Z)\r\n        paralelo = abs(dot - 1.0) < umbral_direccion\r\n        if paralelo:\r\n            conectado = False\r\n            for p1 in extremos_act:\r\n                for p2 in ext_viga:\r\n                    if p1.DistanceTo(p2) < tolerancia:\r\n                        conectado = True\r\n                        break\r\n                if conectado:\r\n                    break\r\n            if conectado:\r\n                visitadas.add(get_id_val(viga))\r\n                resultado.append(viga)\r\n                cola.append((viga, ext_viga, dir_viga))\r\n\r\nOUT = resultado\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "706c2a939d34424ea14f9a1acf08ce5c",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "41cb59973ffe46e694961d09f34dfbfb",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "ba9520d37f2847bbbafb599fd8d45f93",
          "Name": "OUT",
          "Description": "Resultado de la secuencia de comandos de Python",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Ejecuta una secuencia de comandos de Python incrustada."
    },
