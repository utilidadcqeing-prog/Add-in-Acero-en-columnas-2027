  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\n\r\nclr.AddReference(\"System\")\r\nfrom System.Collections.Generic import List\r\n\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\ndef get_input(idx, default=None):\r\n    try:\r\n        val = IN[idx]\r\n        if val is None:\r\n            return default\r\n        return val\r\n    except IndexError:\r\n        return default\r\n\r\ndef ensure_list(x):\r\n    if isinstance(x, list):\r\n        return x\r\n    else:\r\n        return [x]\r\n\r\n# Entradas\r\nrebarElements = ensure_list(UnwrapElement(get_input(0)))\r\nspacing = get_input(1, 0)\r\narrayLengths = ensure_list(get_input(2, 0))  # Puede ser lista o escalar\r\nbarsOnNormalSide = get_input(3, True)\r\ninclFirstBar = bool(get_input(4, True))\r\ninclLastBar = bool(get_input(5, True))\r\nconvertUnits = get_input(6, False)\r\n\r\nif spacing == 0 or not rebarElements or not arrayLengths:\r\n    OUT = \"Error: Entrada(s) inválida(s).\"\r\nelse:\r\n    # Conversión de unidades si aplica\r\n    if convertUnits:\r\n        spacing /= 304.8\r\n        arrayLengths = [x/304.8 for x in arrayLengths]\r\n    else:\r\n        arrayLengths = [float(x) for x in arrayLengths]\r\n\r\n    # Si sólo hay un valor de longitud, repetir para todos\r\n    if len(arrayLengths) == 1 and len(rebarElements) > 1:\r\n        arrayLengths = arrayLengths * len(rebarElements)\r\n\r\n    # Si las longitudes y barras no coinciden, error\r\n    if len(arrayLengths) != len(rebarElements):\r\n        OUT = \"Error: El número de barras y longitudes no coincide.\"\r\n    else:\r\n        TransactionManager.Instance.EnsureInTransaction(doc)\r\n        outList = []\r\n        for i, rebarElement in enumerate(rebarElements):\r\n            if rebarElement is None:\r\n                outList.append(\"Elemento nulo\")\r\n                continue\r\n            sda = rebarElement.GetShapeDrivenAccessor()\r\n            RebarShapeDrivenAccessor.SetLayoutAsMaximumSpacing(\r\n                sda, spacing, arrayLengths[i], barsOnNormalSide, inclFirstBar, inclLastBar\r\n            )\r\n            outList.append(rebarElement)\r\n        TransactionManager.Instance.TransactionTaskDone()\r\n        doc.Regenerate()\r\n        uidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\r\n        uidoc.RefreshActiveView()\r\n        OUT = outList\r\n",
      "Engine": "CPython3",
