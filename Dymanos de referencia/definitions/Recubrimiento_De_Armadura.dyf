      "FunctionSignature": "DSCore.List.Flatten@var[]..[],int",
      "Replication": "Auto",
      "Description": "Aplana una lista anidada de listas aplicando el valor especificado.\n\nList.Flatten (list: var[]..[], amount: int = -1): var[]..[]"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "def limpiar_nulls(input_data):\r\n    # Si es una lista, filtra los nulls (None en Python)\r\n    if isinstance(input_data, list):\r\n        return [x for x in input_data if x is not None]\r\n    else:\r\n        # Si no es lista, revisa si es null, si no lo es lo devuelve\r\n        return None if input_data is None else input_data\r\n\r\nOUT = limpiar_nulls(IN[0])\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "299a55067bfc4f90abb5c24876f32097",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "1907159553e54ccc88e9915d784ea572",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
