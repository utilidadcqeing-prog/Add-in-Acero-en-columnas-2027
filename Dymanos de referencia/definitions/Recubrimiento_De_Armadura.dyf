      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "def limpiar_nulls(input_data):\r\n    # Si es una lista, filtra los nulls (None en Python)\r\n    if isinstance(input_data, list):\r\n        return [x for x in input_data if x is not None]\r\n    else:\r\n        # Si no es lista, revisa si es null, si no lo es lo devuelve\r\n        return None if input_data is None else input_data\r\n\r\nOUT = limpiar_nulls(IN[0])\r\n",
      "Engine": "CPython3",
