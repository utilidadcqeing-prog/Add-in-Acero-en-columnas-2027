          "Description": "valor de retorno",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "7078f5583ce5469b88969b8cd38efa8b",
          "Name": "Stirrup/Tie Seismic - 135 deg.",
          "Description": "valor de retorno",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Auto",
      "Description": "Obtiene las formas de gancho de armaduras"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\n\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\n\r\nimport System\r\nfrom System.Collections.Generic import List\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# ENTRADAS\r\nrevit_curves = IN[0]                 # Lista de Autodesk.Revit.DB.Curve (ya lista y plana)\r\nhost = UnwrapElement(IN[1])          # Elemento host (viga, columna, etc.)\r\nrebar_type = UnwrapElement(IN[2])    # Tipo de barra (RebarBarType)\r\nhook_type = UnwrapElement(IN[3])     # Tipo de gancho 135° (RebarHookType)\r\nnorm_in = IN[4]                      # Vector normal (puede ser Vector de Dynamo o XYZ de Revit)\r\n\r\n# --- Conversión del vector normal ---\r\nif hasattr(norm_in, \"ToXyz\"):\r\n    norm = norm_in.ToXyz()  # Vector de Dynamo a XYZ de Revit\r\nelif isinstance(norm_in, XYZ):\r\n    norm = norm_in          # Ya es un XYZ\r\nelse:\r\n    norm = None\r\n\r\n# Validación rápida de la normal\r\nif not norm or not hasattr(norm, \"X\"):\r\n    OUT = \"Error: El vector normal (IN[4]) está vacío o no es Autodesk.Revit.DB.XYZ\"\r\nelse:\r\n    rebar_style = RebarStyle.StirrupTie\r\n    useExistingShapeIfPossible = False\r\n    createNewShape = True\r\n\r\n    bar_terminations = BarTerminationsData(doc)\r\n    bar_terminations.HookTypeIdAtStart = hook_type.Id\r\n    bar_terminations.HookTypeIdAtEnd = hook_type.Id\r\n\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n    try:\r\n        rebar = Rebar.CreateFromCurves(\r\n            doc,\r\n            rebar_style,\r\n            rebar_type,\r\n            host,\r\n            norm,\r\n            List[Curve](revit_curves),\r\n            bar_terminations,\r\n            useExistingShapeIfPossible,\r\n            createNewShape\r\n        )\r\n        OUT = rebar.ToDSType(False)\r\n    except Exception as e:\r\n        OUT = \"Error: {}\".format(e)\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "c930a0a48cf24e88b81a8757338ca5c5",
