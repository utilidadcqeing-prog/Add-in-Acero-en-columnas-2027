    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "from Autodesk.Revit.DB import XYZ\r\n\r\nnorm_in = IN[0]  # <-- ¡No olvides esta línea!\r\nnorm = None\r\ntry:\r\n    # Si es un Vector de Dynamo\r\n    norm = norm_in.ToXyz()\r\nexcept:\r\n    try:\r\n        # Si ya es un XYZ de Revit\r\n        _ = norm_in.X\r\n        norm = norm_in\r\n    except:\r\n        try:\r\n            # Si es una lista/tupla de 3 números\r\n            if isinstance(norm_in, (list, tuple)) and len(norm_in) == 3:\r\n                norm = XYZ(*norm_in)\r\n        except:\r\n            norm = None\r\n\r\nOUT = norm\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "922ffaae92af4b0c9115b9530a8f0702",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "7109a28ea47942ab912c5c4607bad630",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "cee7dd85af88440fb4b602b98718d87c",
          "Name": "OUT",
          "Description": "Resultado de la secuencia de comandos de Python",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
