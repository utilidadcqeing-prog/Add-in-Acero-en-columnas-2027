    {
      "ConcreteType": "Dynamo.Graph.Nodes.CustomNodes.Function, DynamoCore",
      "FunctionSignature": "9ff5740d-4b04-4133-87bb-bbbfb80cf046",
      "FunctionType": "Graph",
      "Id": "7b1235cd252a4e07bf4069babe464ef8",
