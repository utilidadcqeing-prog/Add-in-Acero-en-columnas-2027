      "Replication": "Disabled",
      "Description": "Ejecuta una secuencia de comandos de Python incrustada."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import Curve, XYZ, Line\r\n\r\n# IN[0]: Lista de Autodesk.Revit.DB.Curve (loop)\r\n# IN[1]: Vector normal deseado (Autodesk.Revit.DB.XYZ)\r\ncurves = IN[0]\r\ndesired_norm = IN[1]\r\nTOL = 1e-7\r\n\r\ndef points_equal(p1, p2, tol=TOL):\r\n    return (abs(p1.X - p2.X) < tol) and (abs(p1.Y - p2.Y) < tol) and (abs(p1.Z - p2.Z) < tol)\r\n\r\ndef reorder_curves(curves):\r\n    # Ordena las curvas para que cada final coincida con el inicio de la siguiente\r\n    if not curves: return []\r\n    ordered = [curves[0]]\r\n    curves_left = list(curves[1:])\r\n    while curves_left:\r\n        end_pt = ordered[-1].GetEndPoint(1)\r\n        found = False\r\n        for idx, c in enumerate(curves_left):\r\n            if points_equal(end_pt, c.GetEndPoint(0)):\r\n                ordered.append(c)\r\n                del curves_left[idx]\r\n                found = True\r\n                break\r\n            elif points_equal(end_pt, c.GetEndPoint(1)):\r\n                # Invierte la curva si está al revés\r\n                if hasattr(c, \"CreateReversed\"):\r\n                    c_rev = c.CreateReversed()\r\n                    ordered.append(c_rev)\r\n                else:\r\n                    c_rev = Line.CreateBound(c.GetEndPoint(1), c.GetEndPoint(0))\r\n                    ordered.append(c_rev)\r\n                del curves_left[idx]\r\n                found = True\r\n                break\r\n        if not found:\r\n            # No se pudo cerrar, aborta\r\n            break\r\n    return ordered\r\n\r\ndef adjust_curve_loop_points(curves, tol=TOL):\r\n    # Ajusta los finales de líneas para que coincidan con el inicio de la siguiente\r\n    n = len(curves)\r\n    fixed = []\r\n    for i in range(n):\r\n        c = curves[i]\r\n        p_start = c.GetEndPoint(0)\r\n        p_end = c.GetEndPoint(1)\r\n        p_next = curves[(i+1)%n].GetEndPoint(0)\r\n        # Solo para líneas, ajusta el punto final\r\n        if not points_equal(p_end, p_next, tol) and isinstance(c, Line):\r\n            fixed.append(Line.CreateBound(p_start, p_next))\r\n        else:\r\n            fixed.append(c)\r\n    return fixed\r\n\r\ndef force_close_loop(curves, tol=TOL):\r\n    # Si el último punto no coincide con el primero, corrige la última curva\r\n    n = len(curves)\r\n    if n < 2:\r\n        return curves\r\n    first_pt = curves[0].GetEndPoint(0)\r\n    last_curve = curves[-1]\r\n    last_pt_start = last_curve.GetEndPoint(0)\r\n    last_pt_end = last_curve.GetEndPoint(1)\r\n    if not points_equal(last_pt_end, first_pt, tol):\r\n        # Si la última curva es una línea, la recrea para que termine justo en el inicio\r\n        if isinstance(last_curve, Line):\r\n            curves[-1] = Line.CreateBound(last_pt_start, first_pt)\r\n    return curves\r\n\r\ndef get_loop_normal(curves):\r\n    # Usa los tres primeros puntos para calcular el plano\r\n    if len(curves) < 2:\r\n        return None\r\n    p0 = curves[0].GetEndPoint(0)\r\n    p1 = curves[0].GetEndPoint(1)\r\n    p2 = curves[1].GetEndPoint(1)\r\n    v1 = XYZ(p1.X - p0.X, p1.Y - p0.Y, p1.Z - p0.Z)\r\n    v2 = XYZ(p2.X - p1.X, p2.Y - p1.Y, p2.Z - p1.Z)\r\n    nx = v1.Y * v2.Z - v1.Z * v2.Y\r\n    ny = v1.Z * v2.X - v1.X * v2.Z\r\n    nz = v1.X * v2.Y - v1.Y * v2.X\r\n    mag = (nx**2 + ny**2 + nz**2)**0.5\r\n    if mag == 0:\r\n        return None\r\n    return XYZ(nx/mag, ny/mag, nz/mag)\r\n\r\ndef same_direction(vec1, vec2):\r\n    dot = vec1.X*vec2.X + vec1.Y*vec2.Y + vec1.Z*vec2.Z\r\n    return dot >= 0\r\n\r\n# 1. Reordena para cerrar el loop\r\ncurves_ordered = reorder_curves(curves)\r\n# 2. Ajusta puntos finales para cerrar perfectamente\r\ncurves_closed = adjust_curve_loop_points(curves_ordered, TOL)\r\n# 3. Fuerza cierre perfecto del loop\r\ncurves_closed = force_close_loop(curves_closed, TOL)\r\n# 4. Calcula la normal\r\nloop_norm = get_loop_normal(curves_closed)\r\n# 5. Orienta según la normal deseada\r\nif loop_norm and desired_norm:\r\n    if not same_direction(loop_norm, desired_norm):\r\n        curves_closed = curves_closed[::-1]\r\n        # Forzar de nuevo el cierre después de invertir\r\n        curves_closed = adjust_curve_loop_points(curves_closed, TOL)\r\n        curves_closed = force_close_loop(curves_closed, TOL)\r\n\r\n# Última validación\r\ndef is_curve_loop(curves, tol=TOL):\r\n    n = len(curves)\r\n    for i in range(n):\r\n        p_end = curves[i].GetEndPoint(1)\r\n        p_next = curves[(i+1)%n].GetEndPoint(0)\r\n        if not points_equal(p_end, p_next, tol):\r\n            return False\r\n    return True\r\n\r\nif is_curve_loop(curves_closed, TOL):\r\n    OUT = curves_closed\r\nelse:\r\n    OUT = \"Error: Las curvas aún NO forman un CurveLoop válido.\"\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "d413dccb72524ee98e4c0680180fac7d",
      "NodeType": "PythonScriptNode",
