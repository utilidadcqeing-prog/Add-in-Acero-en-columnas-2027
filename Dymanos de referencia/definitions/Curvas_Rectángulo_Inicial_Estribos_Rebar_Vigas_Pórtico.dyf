    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "870061069c3147278b1f2bc01c02f725",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "fc3ffe0964b7452fbf881769460f2bd3",
          "Name": "object",
          "Description": "Un objeto.\n\nvar",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "18d98e03596a4113a878fea8b2799b6f",
          "Name": "object",
          "Description": "El mismo objeto",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "DSCore.Object.Identity@var",
      "Replication": "Auto",
      "Description": "Devuelve lo que se le pasa, sin hacer nada.\n\nObject.Identity (object: var): var[]..[]"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# Entradas\r\nsurfaces = IN[0]\r\nreference_point = IN[1]\r\n\r\n# Calcular el punto más cercano de cada superficie al punto de referencia\r\ndef min_distance(surface, point):\r\n    # Obtener varios puntos de la superficie para aproximar\r\n    uvs = [(0,0), (0,1), (1,0), (1,1), (0.5,0.5), (0.5,0), (0,0.5), (1,0.5), (0.5,1)]\r\n    pts = [surface.PointAtParameter(u,v) for (u,v) in uvs]\r\n    dists = [pt.DistanceTo(point) for pt in pts]\r\n    return min(dists)\r\n\r\n# Ordenar superficies por distancia mínima\r\nordered_surfaces = sorted(\r\n    surfaces, \r\n    key=lambda surf: min_distance(surf, reference_point)\r\n)\r\n\r\nOUT = ordered_surfaces\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "984769db84ea4b369d7d6a4b30dadb7f",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "a5220fbda9a94dc7bf68d2d3f537fbd2",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "0ed862b9a975459b81d1277683c77ad4",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "c2a406fcf3094cb69bb52fb149f45dbf",
          "Name": "OUT",
          "Description": "Resultado de la secuencia de comandos de Python",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Ejecuta una secuencia de comandos de Python incrustada."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# Importar Dynamo Geometry\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import Line, Point\r\n\r\n# Entradas\r\nlineas = IN[0]  # Lista de líneas únicas\r\npunto_ref = IN[1]  # Punto de referencia (Point)\r\n\r\ndef min_distancia(linea, punto):\r\n    # Calcula la menor distancia entre el punto y los extremos de la línea\r\n    return min(linea.StartPoint.DistanceTo(punto), linea.EndPoint.DistanceTo(punto))\r\n\r\n# Ordenar las líneas según la distancia mínima de sus extremos al punto de referencia\r\nlineas_ordenadas = sorted(lineas, key=lambda l: min_distancia(l, punto_ref))\r\n\r\nOUT = lineas_ordenadas",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "ff9528d90edf4cfaa9438d34220023f2",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "9e52306e25dd470fa93e8d3bc2782cf4",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "f6fd2776b3db4f169709b7c888779e0c",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "2281f9a83b254c46b5754e8c7be64400",
          "Name": "OUT",
          "Description": "Resultado de la secuencia de comandos de Python",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Ejecuta una secuencia de comandos de Python incrustada."
    },
