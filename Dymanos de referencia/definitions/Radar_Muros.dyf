    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "a21a18e560c444c4a785c4daf024e495",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "adcbc32b793e4f2296793c5f9a03de80",
          "Name": "list",
          "Description": "Lista que se debe aplanar.\n\nvar[]..[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "d6b4420a93874338b6becff09a5f4828",
          "Name": "amount",
          "Description": "Capas de anidamiento de lista que se van a eliminar (-1 eliminará todos los anidamientos de lista).\n\nint\nValor por defecto : -1",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "bbd498727b9844cb92681bc38acbbf5d",
          "Name": "list",
          "Description": "Lista aplanada por cantidad.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "DSCore.List.Flatten@var[]..[],int",
      "Replication": "Auto",
      "Description": "Aplana una lista anidada de listas aplicando el valor especificado.\n\nList.Flatten (list: var[]..[], amount: int = -1): var[]..[]"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Dynamo CPython3\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import Curve, Line, Arc, Point, Vector\r\n\r\n# ---------------- utilidades ----------------\r\ndef flatten(x):\r\n    if not isinstance(x, list): return [x]\r\n    out, stack = [], list(x)\r\n    while stack:\r\n        v = stack.pop(0)\r\n        if isinstance(v, list): stack = list(v) + stack\r\n        else: out.append(v)\r\n    return out\r\n\r\ndef almost(a, b, tol): return abs(a - b) <= tol\r\n\r\ndef unique_points(pts, tol):\r\n    out = []\r\n    for p in pts:\r\n        keep = True\r\n        for q in out:\r\n            if p.DistanceTo(q) <= tol:\r\n                keep = False; break\r\n        if keep: out.append(p)\r\n    return out\r\n\r\ndef add_param(unique_list, t, tol):\r\n    for u in unique_list:\r\n        if almost(u, t, tol): return\r\n    unique_list.append(t)\r\n\r\ndef round_pt(p, q):\r\n    # discretiza coordenadas usando paso q\r\n    return (round(p.X / q), round(p.Y / q), round(p.Z / q))\r\n\r\ndef line_key(ln, q):\r\n    a = ln.StartPoint; b = ln.EndPoint\r\n    pa, pb = round_pt(a, q), round_pt(b, q)\r\n    # orden independiente de dirección\r\n    return ('L',) + tuple(sorted([pa, pb]))\r\n\r\ndef arc_key(ac, q):\r\n    # clave robusta usando start, end (ordenadas) y un punto medio\r\n    s, e = ac.StartPoint, ac.EndPoint\r\n    m = ac.PointAtParameter(0.5)\r\n    ps, pe = round_pt(s, q), round_pt(e, q)\r\n    pair = tuple(sorted([ps, pe]))\r\n    pm = round_pt(m, q)\r\n    return ('A',) + pair + pm\r\n\r\ndef dedup_curves(curves, tol):\r\n    # q: paso de cuantización para claves (≥ 100*tol)\r\n    q = max(tol * 100.0, 1e-6)\r\n    seen = set()\r\n    out = []\r\n    for c in curves:\r\n        try:\r\n            if isinstance(c, Line):\r\n                k = line_key(c, q)\r\n            elif isinstance(c, Arc):\r\n                k = arc_key(c, q)\r\n            else:\r\n                # para cualquier otro Curve (por si se cuela), usa centroide + largo\r\n                bb = c.BoundingBox\r\n                centroid = Point.ByCoordinates((bb.MaxPoint.X+bb.MinPoint.X)/2.0,\r\n                                               (bb.MaxPoint.Y+bb.MinPoint.Y)/2.0,\r\n                                               (bb.MaxPoint.Z+bb.MinPoint.Z)/2.0)\r\n                k = ('C', round_pt(centroid, q), round(c.Length / (q if q>0 else 1e-6)))\r\n        except:\r\n            continue\r\n        if k in seen: \r\n            continue\r\n        seen.add(k)\r\n        out.append(c)\r\n    return out\r\n\r\n# ---------------- entrada ----------------\r\nraw = flatten(IN[0]) if isinstance(IN[0], list) else [IN[0]]\r\ncurves = [c for c in raw if isinstance(c, Curve)]\r\n\r\nif not curves:\r\n    OUT = [[], []]\r\nelse:\r\n    # tolerancias relativas\r\n    avg_len = sum(c.Length for c in curves) / float(len(curves))\r\n    TOL = max(1e-6, avg_len * 1e-8)\r\n    MIN_SEG = max(1e-6, avg_len * 1e-7)\r\n\r\n    # parámetros de corte por curva\r\n    params = [[0.0, 1.0] for _ in curves]\r\n    inter_nodes = []\r\n\r\n    n = len(curves)\r\n    for i in range(n):\r\n        ci = curves[i]\r\n        for j in range(i+1, n):\r\n            cj = curves[j]\r\n            inter = ci.Intersect(cj)\r\n            if not inter: \r\n                continue\r\n\r\n            for g in inter:\r\n                if isinstance(g, Point):\r\n                    inter_nodes.append(g)\r\n                    # intenta mapear a parámetros\r\n                    try:\r\n                        add_param(params[i], ci.ParameterAtPoint(g), TOL)\r\n                        add_param(params[j], cj.ParameterAtPoint(g), TOL)\r\n                    except:\r\n                        pass\r\n\r\n                elif isinstance(g, Curve):\r\n                    # tramo solapado -> corta en extremos\r\n                    try:\r\n                        p0, p1 = g.StartPoint, g.EndPoint\r\n                        inter_nodes.extend([p0, p1])\r\n                        add_param(params[i], ci.ParameterAtPoint(p0), TOL)\r\n                        add_param(params[i], ci.ParameterAtPoint(p1), TOL)\r\n                        add_param(params[j], cj.ParameterAtPoint(p0), TOL)\r\n                        add_param(params[j], cj.ParameterAtPoint(p1), TOL)\r\n                    except:\r\n                        pass\r\n\r\n    # dividir preservando tipo\r\n    pieces_all = []\r\n    for k, c in enumerate(curves):\r\n        # limpia y ordena parámetros internos\r\n        ps_sorted = sorted(params[k])\r\n        inner = []\r\n        for t in ps_sorted:\r\n            if t > 0.0 + TOL and t < 1.0 - TOL:\r\n                add_param(inner, t, TOL)\r\n\r\n        if not inner:\r\n            pieces = [c]\r\n        else:\r\n            pieces = c.SplitByParameter(inner)\r\n\r\n        for seg in pieces:\r\n            try:\r\n                if seg.Length > MIN_SEG:\r\n                    pieces_all.append(seg)\r\n            except:\r\n                pass\r\n\r\n    # eliminar duplicados\r\n    nodes_unique = unique_points(inter_nodes, TOL)\r\n    curves_unique = dedup_curves(pieces_all, TOL)\r\n\r\n    OUT = [curves_unique, nodes_unique]\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "6daa4fe4be82427ba73a571d5a12aec0",
      "NodeType": "PythonScriptNode",
