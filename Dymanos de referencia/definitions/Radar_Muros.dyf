    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Dynamo (CPython3) — Secuencia de arcos hasta repetir línea\r\n# IN[0]: lineas   -> Lista de Line (todas coplanares, en el mismo plano IN[3])\r\n# IN[1]: lineaRef -> Line (también está en IN[0])\r\n# IN[2]: radio    -> float\r\n# IN[3]: plano    -> Plane (se usa su XAxis/YAxis y normal; el círculo se ancla al centro correspondiente en cada paso)\r\n# IN[4]: sentido  -> int (1 = antihorario / CCW, -1 = horario / CW)\r\n#\r\n# OUT: [linea_inicial, lista_arcos, lista_lineas_intersectadas, lista_extremos_priorizados]\r\n#  - lista_arcos[i]               = arco i (Arc) en el sentido IN[4]\r\n#  - lista_lineas_intersectadas[i]= línea sobre la que termina el arco i (Line)\r\n#  - lista_extremos_priorizados[i]= extremo de esa línea, elegido:\r\n#       * inicialmente: el extremo MÁS LEJANO al punto final del arco i\r\n#       * PERO priorizando que NO quede \"dentro\" del arco i (distancia al centro del arco i >= radio - tol);\r\n#         si el más lejano queda dentro, se usa el otro extremo.\r\n#\r\n# La secuencia se DETIENE cuando un arco finaliza sobre una línea que ya apareció previamente\r\n# (incluida la línea inicial IN[1]).\r\n\r\nimport clr, math\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nlineas   = IN[0]\r\nlineaRef = IN[1]\r\nradio    = float(IN[2])\r\nplano    = IN[3]\r\nsentido  = int(IN[4])\r\n\r\nTOL = 1e-6\r\nMAX_STEPS = max(1, len(lineas) * 2)  # límite de seguridad\r\n\r\n# ---------------------- Utilidades ---------------------- #\r\ndef mismas_extremidades(l1, l2, tol=TOL):\r\n    a1, a2 = l1.StartPoint, l1.EndPoint\r\n    b1, b2 = l2.StartPoint, l2.EndPoint\r\n    return ((a1.DistanceTo(b1) <= tol and a2.DistanceTo(b2) <= tol) or\r\n            (a1.DistanceTo(b2) <= tol and a2.DistanceTo(b1) <= tol))\r\n\r\ndef hallar_linea_en_lista(lst, ref):\r\n    try:\r\n        return lst[lst.index(ref)]  # misma instancia\r\n    except:\r\n        for l in lst:               # coincidencia geométrica\r\n            if mismas_extremidades(l, ref):\r\n                return l\r\n    return None\r\n\r\ndef inters_circ_line(circ, ln):\r\n    pts = circ.Intersect(ln)\r\n    return [p for p in (pts or []) if isinstance(p, Point)]\r\n\r\ndef angulo_en_plano(center, pt, xaxis, yaxis):\r\n    v = Vector.ByTwoPoints(center, pt)\r\n    x = v.Dot(xaxis); y = v.Dot(yaxis)\r\n    a = math.atan2(y, x)  # [-pi,pi]\r\n    return a if a >= 0 else (a + 2*math.pi)\r\n\r\ndef delta_angular(a_from, a_to, dir_sign):\r\n    # Delta positivo siguiendo el sentido: 1=CCW, -1=CW\r\n    return ((a_to - a_from) % (2*math.pi)) if dir_sign >= 0 else ((a_from - a_to) % (2*math.pi))\r\n\r\ndef punto_en_circulo(center, xaxis, yaxis, r, ang):\r\n    vx = xaxis.Normalized().Scale(r * math.cos(ang))\r\n    vy = yaxis.Normalized().Scale(r * math.sin(ang))\r\n    return center.Add(vx.Add(vy))\r\n\r\ndef extremos_priorizado_fuera_circulo(ln, end_pt, centro_arco, r, tol=TOL):\r\n    \"\"\"Devuelve (extremo_priorizado, extremo_restante) priorizando que NO esté dentro del círculo del arco.\"\"\"\r\n    pA, pB = ln.StartPoint, ln.EndPoint\r\n    # Primero el más lejano respecto a end_pt\r\n    far, other = (pA, pB) if pA.DistanceTo(end_pt) >= pB.DistanceTo(end_pt) else (pB, pA)\r\n    # Prioriza que quede FUERA del círculo (distancia al centro >= r - tol)\r\n    if far.DistanceTo(centro_arco) >= (r - tol):\r\n        return far, other\r\n    else:\r\n        # si el \"far\" cae dentro, usa el otro\r\n        return other, far\r\n\r\n# ---------------------- Preparación ---------------------- #\r\nlinea_inicial = hallar_linea_en_lista(lineas, lineaRef)\r\nif linea_inicial is None:\r\n    OUT = [None, [], [], []]\r\nelse:\r\n    # Visitados por identidad de objeto (misma referencia en IN[0])\r\n    visitados = set([id(linea_inicial)])\r\n\r\n    arcos   = []\r\n    lns_end = []\r\n    extremos = []\r\n\r\n    # Paso 1: centro en StartPoint de la línea inicial\r\n    centro = linea_inicial.StartPoint\r\n    xax, yax = plano.XAxis, plano.YAxis\r\n\r\n    # Círculo 1\r\n    pln_c = Plane.ByOriginXAxisYAxis(centro, xax, yax)\r\n    circ  = Circle.ByPlaneRadius(pln_c, radio)\r\n\r\n    # Punto de inicio 1: intersección con linea_inicial, tomando el que avanza Start->End de la línea\r\n    pts0 = inters_circ_line(circ, linea_inicial)\r\n    if not pts0:\r\n        OUT = [linea_inicial, [], [], []]\r\n    else:\r\n        vdir = Vector.ByTwoPoints(linea_inicial.StartPoint, linea_inicial.EndPoint).Normalized()\r\n        start = None; best = -1e9\r\n        for p in pts0:\r\n            val = vdir.Dot(Vector.ByTwoPoints(centro, p))\r\n            if val > best + TOL:\r\n                best, start = val, p\r\n        if start is None:\r\n            OUT = [linea_inicial, [], [], []]\r\n        else:\r\n            prev_end = None  # para pasos siguientes\r\n\r\n            # ---------------------- Bucle principal ---------------------- #\r\n            steps = 0\r\n            while steps < MAX_STEPS:\r\n                # Ángulo de partida para este arco:\r\n                # - En paso 0 (primer arco), lo tomamos del propio \"start\"\r\n                # - En pasos siguientes, partimos mirando hacia el end del arco previo\r\n                if steps == 0:\r\n                    a0 = angulo_en_plano(centro, start, xax, yax)\r\n                    start_pt = start\r\n                else:\r\n                    a0 = angulo_en_plano(centro, prev_end, xax, yax)\r\n                    start_pt = punto_en_circulo(centro, xax, yax, radio, a0)\r\n\r\n                # Buscar la PRIMERA intersección (mínimo delta angular > 0) con cualquier línea\r\n                mejor_delta = None\r\n                end_pt = None\r\n                linea_hit = None\r\n\r\n                for l in lineas:\r\n                    pts = inters_circ_line(circ, l)\r\n                    if not pts:\r\n                        continue\r\n                    for p in pts:\r\n                        if p.DistanceTo(start_pt) <= TOL:\r\n                            continue  # evita arrancar y terminar en el mismo punto\r\n                        ai = angulo_en_plano(centro, p, xax, yax)\r\n                        d = delta_angular(a0, ai, sentido)\r\n                        if d <= TOL:\r\n                            continue\r\n                        if (mejor_delta is None) or (d < mejor_delta):\r\n                            mejor_delta, end_pt, linea_hit = d, p, l\r\n\r\n                if end_pt is None or linea_hit is None:\r\n                    break  # no hay más intersecciones válidas en este sentido\r\n\r\n                # Construir el arco del paso\r\n                amid = a0 + sentido * (mejor_delta / 2.0)\r\n                mid  = punto_en_circulo(centro, xax, yax, radio, amid)\r\n                arco = Arc.ByThreePoints(start_pt, mid, end_pt)\r\n\r\n                # Elegir extremo priorizado de la línea donde terminó el arco\r\n                extremo_ok, extremo_rest = extremos_priorizado_fuera_circulo(\r\n                    linea_hit, end_pt, centro, radio, TOL\r\n                )\r\n\r\n                # Guardar resultados del paso\r\n                arcos.append(arco)\r\n                lns_end.append(linea_hit)\r\n                extremos.append(extremo_ok)\r\n\r\n                # Condición de parada: si la línea_hit ya estaba en visitados, detenemos aquí\r\n                ya_vista = id(linea_hit) in visitados\r\n                visitados.add(id(linea_hit))\r\n                if ya_vista:\r\n                    break\r\n\r\n                # Preparar siguiente paso:\r\n                prev_end = end_pt\r\n                centro   = extremo_ok          # nuevo centro\r\n                pln_c    = Plane.ByOriginXAxisYAxis(centro, xax, yax)\r\n                circ     = Circle.ByPlaneRadius(pln_c, radio)\r\n\r\n                steps += 1\r\n\r\n            OUT = [linea_inicial, arcos, lns_end, extremos]\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "00737dac2e824b39ad0d0de9ae150192",
      "NodeType": "PythonScriptNode",
