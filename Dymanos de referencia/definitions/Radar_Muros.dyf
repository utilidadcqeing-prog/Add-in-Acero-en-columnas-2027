      "Description": "Permite creación directa de código de DesignScript",
      "Code": "A[0];"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\ndef vector_unitario(linea):\r\n    \"\"\"Devuelve el vector unitario de la línea.\"\"\"\r\n    v = Vector.ByTwoPoints(linea.StartPoint, linea.EndPoint)\r\n    return v.Normalized()\r\n\r\ndef son_colineales(linea1, linea2, tolerancia=1e-6):\r\n    \"\"\"Verifica si dos líneas o curvas son colineales.\"\"\"\r\n    # Obtener vectores dirección\r\n    v1 = vector_unitario(linea1)\r\n    v2 = vector_unitario(linea2)\r\n\r\n    # Comparar si son paralelas (mismo sentido o contrario)\r\n    angulo = v1.AngleWithVector(v2)\r\n    paralelas = abs(angulo) < tolerancia or abs(angulo - 180) < tolerancia\r\n\r\n    if not paralelas:\r\n        return False\r\n\r\n    # Verificar que estén sobre la misma recta (no desplazadas)\r\n    p_ref = linea2.StartPoint\r\n    p0 = linea1.StartPoint\r\n    v_linea = v1\r\n    v_p0p = Vector.ByTwoPoints(p0, p_ref)\r\n\r\n    # Si el vector que une un punto de una línea con la otra es perpendicular a la dirección → no son colineales\r\n    prod_cruz = v_linea.Cross(v_p0p)\r\n    dist = prod_cruz.Length\r\n\r\n    return dist < tolerancia\r\n\r\n# --- Entradas desde Dynamo ---\r\nlineas = IN[0]\r\nref_linea = IN[1]\r\n\r\n# Si IN[1] viene como lista\r\nif isinstance(ref_linea, list):\r\n    ref_linea = ref_linea[0]\r\n\r\nOUT = [son_colineales(l, ref_linea) for l in lineas]\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "b0b435f89a7842c2bddace54416419b7",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "16bdbb9902ad4d809c351349908f491f",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "6149c3ae4f1248b8ac6412bece2a5e83",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
