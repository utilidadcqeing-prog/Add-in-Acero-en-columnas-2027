{
  "Uuid": "8b74924b-0e97-4e92-a8b7-8e0e0a7575ba",
  "IsCustomNode": true,
  "Category": "01_Nodos_CQING",
  "Description": "Obtiene las barras de armaduras hospedadas",
  "Name": "Rebars_Hospedadas",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Cargar bibliotecas estándar de Python y CLR\r\nimport clr\r\nimport sys\r\n\r\n# Cargar las bibliotecas de Revit API\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import RebarHostData\r\n\r\n# Cargar las bibliotecas de RevitServices para acceder al documento actual\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\n# Obtener el documento actual\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Función auxiliar para asegurar que la entrada sea siempre una lista\r\ndef to_list(obj):\r\n    if hasattr(obj, '__iter__') and not isinstance(obj, str):\r\n        return obj\r\n    else:\r\n        return [obj]\r\n\r\n# Entrada: Elementos anfitriones (Vigas, Columnas, Pisos, Cimentaciones)\r\nhosts = to_list(UnwrapElement(IN[0]))\r\n\r\nresults_list = []\r\n\r\n# Iterar sobre cada elemento anfitrión\r\nfor host in hosts:\r\n    hosted_elements = []\r\n    \r\n    try:\r\n        # Verificar si el elemento es válido para alojar refuerzo\r\n        host_data = RebarHostData.GetRebarHostData(host)\r\n        \r\n        if host_data:\r\n            # 1. Obtener Rebars (Barras individuales)\r\n            # CORRECCIÓN: El método es GetRebarsInHost (plural) y devuelve los elementos directamente\r\n            rebars = host_data.GetRebarsInHost()\r\n            for r in rebars:\r\n                hosted_elements.append(r)\r\n            \r\n            # 2. Obtener Fabric Sheets (Mallas electrosoldadas)\r\n            # CORRECCIÓN: El método es GetFabricSheetsInHost (plural)\r\n            fabrics = host_data.GetFabricSheetsInHost()\r\n            for f in fabrics:\r\n                hosted_elements.append(f)\r\n                    \r\n    except Exception as e:\r\n        # Si hay un error, lo agregamos a la lista como texto para identificarlo\r\n        hosted_elements.append(\"Error: \" + str(e))\r\n        \r\n    # Añadir la sublista de refuerzos a la lista principal\r\n    results_list.append(hosted_elements)\r\n\r\n# Salida: Lista de listas con los refuerzos encontrados\r\nOUT = results_list",
      "Engine": "CPython3",
      "VariableInputPorts": true,
