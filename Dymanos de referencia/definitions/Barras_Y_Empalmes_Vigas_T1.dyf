    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "text = IN[0] if len(IN) > 0 else \"\"\r\nif text is None:\r\n    text = \"\"\r\ntext = str(text)\r\n\r\n# Ordenar de mayor a menor para priorizar el diámetro más grande encontrado\r\nrules = [\r\n    (\"#8\", 1.70),\r\n    (\"#7\", 1.35),\r\n    (\"#6\", 1.10),\r\n    (\"#5\", 0.90),\r\n    (\"#4\", 0.75),\r\n    (\"#3\", 0.55),\r\n    (\"#2\", 0.40),\r\n]\r\n\r\nT_min = None\r\nfor tag, val in rules:\r\n    if tag in text:\r\n        T_min = val\r\n        break\r\n\r\nOUT = T_min  # None si no se encontró ninguna etiqueta\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "701c8b291063476ba4999cbe28420e5b",
      "NodeType": "PythonScriptNode",
