{
  "Uuid": "ac12b076-07f2-4446-9bc5-eaceae7bc65d",
  "IsCustomNode": true,
  "Category": "01_Nodos_CQING",
  "Description": "Recibe las longitudes de las distancias las columnas, vigas y L_max. Sin voladizos. Barras con empalmes muy cerca a la cara de las columnas.",
  "Name": "Barras_Y_Empalmes_Vigas_T1",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "data = IN[0] if len(IN) > 0 else []\r\ndelta = IN[1] if len(IN) > 1 else 0\r\n\r\ntry:\r\n    delta = float(delta)\r\nexcept Exception:\r\n    delta = 0.0\r\n\r\nif data is None:\r\n    data = []\r\nelif not isinstance(data, (list, tuple)):\r\n    data = [data]\r\n\r\nn = len(data)\r\nout = []\r\nfor idx, val in enumerate(data):\r\n    # antes de cada item impar: item - delta\r\n    if idx % 2 == 1:\r\n        out.append(val - delta)\r\n\r\n    # item original\r\n    out.append(val)\r\n\r\n    # después de cada item par, excepto si es el último\r\n    if idx % 2 == 0 and idx < n - 1:\r\n        out.append(val + delta)\r\n\r\nOUT = out\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "1064e97269204180aeb6fe06c7ebf209",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "a250dd751acb464b98dd68b74dbb37ca",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "3b70c1de09d344c7951d131b02b84d21",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "73587d10dedb4ca5b99f04ac3fa666a5",
          "Name": "OUT",
          "Description": "Resultado de la secuencia de comandos de Python",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Ejecuta una secuencia de comandos de Python incrustada."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\r\n\"\"\"\r\nIN[0] = [y0, y1, y2, ...]  (posiciones sobre el eje de la viga)\r\n       0  = cara inicial de la 1ª columna (implícita)\r\n       y0 = cara final   de la 1ª columna\r\n       y1 = cara inicial de la 2ª columna\r\n       y2 = cara final   de la 2ª columna\r\n       y3 = cara inicial de la 3ª columna\r\n       y4 = cara final   de la 3ª columna\r\n       ...\r\n\r\nIN[1] = L_max  (longitud máxima TOTAL de barra comercial)\r\nIN[2] = g      (longitud de gancho en la primera y última barra)\r\n\r\nOUT[0] = h  -> longitudes horizontales de barras (múltiplos de 0.10)\r\nOUT[1] = T  -> longitudes de empalme entre barras consecutivas,\r\n               con T[i] >= T_min  y  T[i] - T_min <= 0.20\r\n\"\"\"\r\n\r\nimport math\r\n\r\nyin  = IN[0]\r\nLmax = float(IN[1])\r\ng    = float(IN[2])\r\n\r\n# Asegurar lista\r\nif not isinstance(yin, list):\r\n    yin = [yin]\r\n\r\nys_extra = sorted([float(v) for v in yin])\r\n\r\nif len(ys_extra) == 0:\r\n    OUT = [[], []]\r\n\r\nelse:\r\n    # Caras de columnas: 0 + y0,y1,y2,...\r\n    caras   = [0.0] + ys_extra\r\n    L_total = caras[-1]   # y_último\r\n\r\n    # -------------------- T_min a partir de Y ----------------------------\r\n    # Por tu definición: T_min = y1 - y0\r\n    if len(ys_extra) >= 2:\r\n        T_min = ys_extra[1] - ys_extra[0]\r\n    else:\r\n        T_min = 0.10\r\n    if T_min <= 0:\r\n        T_min = 0.10\r\n    T_max = T_min + 0.20\r\n\r\n    # -------------------- Caras cercanas y lejanas -----------------------\r\n    n_caras = len(caras)\r\n    if n_caras % 2 != 0:\r\n        caras   = caras[:-1]\r\n        n_caras = len(caras)\r\n\r\n    n_cols = n_caras // 2\r\n    if n_cols == 0:\r\n        OUT = [[], []]\r\n\r\n    else:\r\n        caras_cercanas = [caras[2*i]     for i in range(n_cols)]  # 0,y1,y3,...\r\n        caras_lejanas  = [caras[2*i + 1] for i in range(n_cols)]  # y0,y2,y4,...\r\n\r\n        fin_tramo = caras_lejanas[-1]\r\n\r\n        # ---------------------------------------------------------\r\n        # 1) BARRAS GEOMÉTRICAS con traslapo = T_min (sin redondeo)\r\n        # ---------------------------------------------------------\r\n        barras_geom = []   # lista de (inicio, fin)\r\n        start = caras_cercanas[0]  # 0\r\n        tol   = 1e-6\r\n        max_iter = 1000\r\n        it = 0\r\n\r\n        while start < fin_tramo - tol and it < max_iter:\r\n            it += 1\r\n            fin_max = start + Lmax\r\n            candidatos = []\r\n\r\n            # Caras cercanas por delante\r\n            for x in caras_cercanas[1:]:\r\n                if x > start + tol and x <= fin_max + tol:\r\n                    candidatos.append(x)\r\n\r\n            # Caras lejanas + T_min por delante\r\n            for x in caras_lejanas:\r\n                p = x + T_min\r\n                if p > start + tol and p <= fin_tramo + tol and p <= fin_max + tol:\r\n                    candidatos.append(p)\r\n\r\n            # Permitir terminar en el final si está a alcance\r\n            if fin_tramo - start <= Lmax + tol:\r\n                candidatos.append(fin_tramo)\r\n\r\n            if not candidatos:\r\n                break\r\n\r\n            end = max(candidatos)\r\n            if end - start < tol:\r\n                break\r\n\r\n            barras_geom.append((start, end))\r\n\r\n            if end >= fin_tramo - tol:\r\n                break\r\n\r\n            # Siguiente barra arranca T_min antes del final de la anterior\r\n            start = end - T_min\r\n\r\n        n = len(barras_geom)\r\n\r\n        if n == 0:\r\n            OUT = [[], []]\r\n\r\n        # ---------------------------------------------------------\r\n        # 2) CASO ESPECIAL: una sola barra → h0 = y_último (tu regla)\r\n        # ---------------------------------------------------------\r\n        elif n == 1:\r\n            h0 = L_total\r\n            OUT = [[round(h0, 3)], []]\r\n\r\n        else:\r\n            # -----------------------------------------------------\r\n            # 3) Longitudes geométricas y redondeo de h\r\n            # -----------------------------------------------------\r\n            L_geom = [fin - ini for (ini, fin) in barras_geom]\r\n\r\n            step = 0.10\r\n\r\n            def redondear_h(Li, i_bar, n_barras, Lmax_val, g_val):\r\n                \"\"\"\r\n                Barra interior: redondeo hacia arriba a múltiplo de 0.10,\r\n                                capado a Lmax.\r\n                Primera y última barra: redondeo hacia arriba,\r\n                pero limitado a (Lmax - g) para garantizar h + g <= Lmax.\r\n                \"\"\"\r\n                v = step * math.ceil((Li - 1e-9) / step)\r\n\r\n                if i_bar == 0 or i_bar == n_barras - 1:\r\n                    # límite horizontal para barras con gancho\r\n                    Hmax_ext = Lmax_val - g_val\r\n                    if Hmax_ext < 0:\r\n                        Hmax_ext = 0.0\r\n                    if v > Hmax_ext + 1e-9:\r\n                        # si nos pasamos, recortamos hacia abajo al múltiplo de 0.10\r\n                        v = step * math.floor((Hmax_ext + 1e-9) / step)\r\n                        if v < 0:\r\n                            v = 0.0\r\n                else:\r\n                    if v > Lmax_val:\r\n                        v = Lmax_val\r\n\r\n                return v\r\n\r\n            # h[i] redondeadas con límite de gancho en primera y última\r\n            h = [redondear_h(L_geom[i], i, n, Lmax, g) for i in range(n)]\r\n\r\n            # Seguridad extra: h0 + g <= Lmax y h[-1] + g <= Lmax\r\n            H_ext = Lmax - g\r\n            if H_ext < 0:\r\n                H_ext = 0.0\r\n            if h[0] > H_ext + 1e-9:\r\n                h[0] = step * math.floor((H_ext + 1e-9) / step)\r\n            if h[-1] > H_ext + 1e-9:\r\n                h[-1] = step * math.floor((H_ext + 1e-9) / step)\r\n\r\n            # Increments por redondeo respecto a la geometría\r\n            delta_h = [h[i] - L_geom[i] for i in range(n)]\r\n            sum_delta_h = sum(delta_h)\r\n\r\n            # Si sum_delta_h < 0, intentamos corregir alargando barras interiores\r\n            if sum_delta_h < 0:\r\n                falta = -sum_delta_h\r\n                for i in range(1, n-1):  # solo barras interiores\r\n                    while falta > 1e-9 and h[i] + step <= Lmax + 1e-9:\r\n                        h[i] += step\r\n                        delta_h[i] += step\r\n                        falta -= step\r\n                sum_delta_h = sum(delta_h)\r\n\r\n            if sum_delta_h < -1e-6:\r\n                # Sin solución estricta -> todos los empalmes a T_min\r\n                T = [T_min]*(n-1)\r\n            else:\r\n                # -------------------------------------------------\r\n                # 4) Empalmes T: T_i = T_min + δ_i\r\n                #    con sum(δ_i) = sum_delta_h y 0 <= δ_i <= 0.20\r\n                # -------------------------------------------------\r\n                deltas_T = [0.0]*(n-1)\r\n                remaining = sum_delta_h\r\n                max_inc   = 0.20\r\n\r\n                for i in range(n-1):\r\n                    if remaining <= 1e-9:\r\n                        break\r\n                    inc = min(max_inc, remaining)\r\n                    deltas_T[i] = inc\r\n                    remaining   -= inc\r\n\r\n                # Clamp por seguridad\r\n                for i in range(n-1):\r\n                    if deltas_T[i] < 0.0:\r\n                        deltas_T[i] = 0.0\r\n                    if deltas_T[i] > 0.20:\r\n                        deltas_T[i] = 0.20\r\n\r\n                T = [T_min + d for d in deltas_T]\r\n\r\n            # Clamp general T al rango [T_min, T_max]\r\n            for i in range(len(T)):\r\n                if T[i] < T_min:\r\n                    T[i] = T_min\r\n                if T[i] > T_max + 1e-9:\r\n                    T[i] = T_max\r\n\r\n            # -----------------------------------------------------\r\n            # 5) Ajuste ESPECÍFICO del ÚLTIMO empalme y h_última\r\n            #    para que el inicio de la última barra\r\n            #    NO quede dentro de columnas interiores.\r\n            #    (solo columnas 2..(n_cols-1))\r\n            # -----------------------------------------------------\r\n            if n >= 2 and n_cols >= 3:\r\n                # Columnas interiores (excluimos primera y última)\r\n                columnas_int = []\r\n                for j in range(1, n_cols-1):\r\n                    a = min(caras_cercanas[j], caras_lejanas[j])\r\n                    b = max(caras_cercanas[j], caras_lejanas[j])\r\n                    columnas_int.append((a, b))\r\n\r\n                def en_columna_interior(x):\r\n                    for a, b in columnas_int:\r\n                        if x > a + 1e-6 and x < b - 1e-6:\r\n                            return True\r\n                    return False\r\n\r\n                # Inicio actual de la última barra\r\n                S_last_actual = L_total - h[-1]\r\n\r\n                if en_columna_interior(S_last_actual):\r\n                    # Queremos un h_ult (múltiplo 0.10, <= Lmax - g)\r\n                    # tal que el nuevo inicio no esté en ninguna columna interior\r\n                    Hmax_ext = Lmax - g\r\n                    if Hmax_ext < 0:\r\n                        Hmax_ext = 0.0\r\n\r\n                    sum_h_sin_ult = sum(h[:-1])\r\n                    sum_T_sin_ult = sum(T[:-1])\r\n\r\n                    # h_ult no puede ser mayor que Hmax_ext ni mayor que L_total\r\n                    h_ult_sup = min(Hmax_ext, L_total)\r\n                    k_max = int(math.floor((h_ult_sup + 1e-9) / step))\r\n\r\n                    mejor_h = None\r\n                    mejor_T = None\r\n\r\n                    # Recorremos de la longitud mayor posible hacia abajo\r\n                    for k in range(k_max, -1, -1):\r\n                        h_cand = k * step\r\n                        if h_cand <= 0:\r\n                            continue\r\n\r\n                        S_last_cand = L_total - h_cand\r\n                        if en_columna_interior(S_last_cand):\r\n                            continue\r\n\r\n                        # Empalme necesario para mantener cobertura exacta\r\n                        T_last_cand = (sum_h_sin_ult + h_cand) - L_total - sum_T_sin_ult\r\n\r\n                        if T_last_cand < T_min - 1e-6 or T_last_cand > T_max + 1e-6:\r\n                            continue\r\n\r\n                        mejor_h = h_cand\r\n                        mejor_T = T_last_cand\r\n                        break  # tomamos el primero: barra más larga posible\r\n\r\n                    if mejor_h is not None:\r\n                        h[-1] = mejor_h\r\n                        T[-1] = mejor_T\r\n                    # Si no encontramos candidato válido, dejamos los valores tal como estaban\r\n\r\n            # -----------------------------------------------------\r\n            # 6) Comprobación de cierre (solo corrige errores numéricos)\r\n            # -----------------------------------------------------\r\n            cobertura = sum(h) - sum(T)\r\n            error = cobertura - L_total\r\n            if abs(error) > 1e-6 and len(T) > 0:\r\n                T[-1] += error\r\n                # volver a clamped\r\n                if T[-1] < T_min:\r\n                    T[-1] = T_min\r\n                if T[-1] > T_max:\r\n                    T[-1] = T_max\r\n\r\n            # Salida redondeada para Dynamo (solo visual)\r\n            h_out = [round(val, 3) for val in h]\r\n            T_out = [round(val, 3) for val in T]\r\n\r\n            OUT = [h_out, T_out]\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "3ee395f25c1b497fb6e74eff8103a86a",
      "NodeType": "PythonScriptNode",
      "Inputs": [
