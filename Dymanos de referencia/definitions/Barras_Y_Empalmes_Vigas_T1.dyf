    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# IN[0] = lista/número/None\r\n# IN[1] = lista/número/None\r\na_raw = IN[0] if len(IN) > 0 else None\r\nb_raw = IN[1] if len(IN) > 1 else None\r\n\r\ndef to_list(x):\r\n    if x is None:\r\n        return []\r\n    return list(x) if isinstance(x, (list, tuple)) else [x]\r\n\r\na = to_list(a_raw)\r\nb = to_list(b_raw)\r\n\r\nif len(a) >= 3:\r\n    a = a[:]\r\n    a[1] = a[1] + 0.10\r\n    if len(b) >= 2:\r\n        b = b[:]\r\n        b[1] = b[1] + 0.10\r\n\r\nOUT = [a, b]\r\n",
