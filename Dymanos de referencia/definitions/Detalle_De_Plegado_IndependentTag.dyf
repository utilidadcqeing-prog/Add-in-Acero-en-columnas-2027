{
  "Uuid": "74665fce-356e-4471-8866-27a6f3f0af32",
  "IsCustomNode": true,
  "Category": "01_Nodos_CQING",
  "Description": "Crea detalles de plegado alineado a la barra.",
  "Name": "Detalle_De_Plegado_IndependentTag",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 1. IMPORTAR LIBRERÍAS\r\nimport clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import RebarBendingDetail, RebarBendingDetailType\r\n\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n# 2. CONFIGURACIÓN INICIAL\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# --- FUNCIONES DE AYUDA (NORMALIZAR ENTRADAS) ---\r\ndef asegurar_lista(entrada, cantidad_objetivo):\r\n    \"\"\"\r\n    Si la entrada es un solo valor, lo repite 'n' veces.\r\n    Si es una lista, la devuelve tal cual.\r\n    \"\"\"\r\n    if isinstance(entrada, list):\r\n        return entrada\r\n    else:\r\n        # Si es un solo valor (ej: un número), creamos una lista repitiéndolo\r\n        return [entrada] * cantidad_objetivo\r\n\r\n# --- 3. PROCESAMIENTO DE ENTRADAS (INPUTS) ---\r\n\r\n# IN[0] -> LISTA MAESTRA DE BARRAS\r\nentrada_barras = IN[0]\r\nif not isinstance(entrada_barras, list):\r\n    entrada_barras = [entrada_barras]\r\nlista_barras = UnwrapElement(entrada_barras)\r\n\r\n# Cantidad de elementos a crear (dictada por las barras)\r\ncantidad = len(lista_barras)\r\n\r\n# IN[4] -> LISTA MAESTRA DE VISTAS (Debe coincidir con las barras)\r\nentrada_vistas = IN[4]\r\nif not isinstance(entrada_vistas, list):\r\n    entrada_vistas = [entrada_vistas]\r\nlista_vistas = UnwrapElement(entrada_vistas)\r\n\r\n# IN[1], IN[2], IN[3] -> OFFSETS (Números o Listas)\r\n# Usamos la función asegurar_lista para normalizar todo al tamaño 'cantidad'\r\nlista_x = asegurar_lista(IN[1], cantidad)\r\nlista_y = asegurar_lista(IN[2], cantidad)\r\nlista_z = asegurar_lista(IN[3], cantidad)\r\n\r\n# Factor de conversión (Metros -> Pies)\r\nfactor = 3.28084\r\n\r\n# -----------------------------------------------\r\n\r\n# 4. BUSCAR TIPO DE DETALLE (RebarBendingDetailType)\r\ntodos_los_tipos = FilteredElementCollector(doc).OfClass(RebarBendingDetailType).ToElements()\r\ntipo_final = None\r\n\r\n# Prioridad: Buscar \"esquemático\"\r\nfor tipo in todos_los_tipos:\r\n    try:\r\n        if \"esquemático\" in tipo.Name.lower() or \"schematic\" in tipo.Name.lower():\r\n            tipo_final = tipo\r\n            break\r\n    except: continue\r\n\r\nif not tipo_final and todos_los_tipos:\r\n    tipo_final = todos_los_tipos[-1]\r\n\r\n# 5. CREACIÓN MASIVA\r\nresultados = []\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nif not tipo_final:\r\n    resultados.append(\"ERROR GLOBAL: No hay familias de detalle cargadas.\")\r\nelif len(lista_vistas) != cantidad:\r\n    resultados.append(\"ERROR: La lista de Vistas (IN[4]) debe tener el mismo tamaño que la lista de Barras (IN[0]).\")\r\nelse:\r\n    # Bucle usando 'zip' para recorrer las 5 listas SIMULTÁNEAMENTE\r\n    # Si alguna lista de offsets es más corta, zip se detendrá ahí (pero ya las normalizamos arriba)\r\n    for barra, vista, off_x, off_y, off_z in zip(lista_barras, lista_vistas, lista_x, lista_y, lista_z):\r\n        try:\r\n            # 1. Convertir offsets actuales a pies\r\n            # Si off_x es None, usar 0.0\r\n            dx = (off_x if off_x else 0.0) * factor\r\n            dy = (off_y if off_y else 0.0) * factor\r\n            dz = (off_z if off_z else 0.0) * factor\r\n\r\n            # 2. Calcular BoundingBox (depende de la vista específica)\r\n            bbox = barra.get_BoundingBox(vista)\r\n\r\n            if bbox:\r\n                centro_x = (bbox.Min.X + bbox.Max.X) / 2.0\r\n                centro_y = (bbox.Min.Y + bbox.Max.Y) / 2.0\r\n                centro_z = (bbox.Min.Z + bbox.Max.Z) / 2.0\r\n                \r\n                # 3. Punto final personalizado para ESTA barra específica\r\n                punto_final = XYZ(centro_x + dx, centro_y + dy, centro_z + dz)\r\n                \r\n                # 4. Crear Detalle\r\n                nuevo = RebarBendingDetail.Create(\r\n                    doc, \r\n                    vista.Id, \r\n                    barra.Id, \r\n                    0, \r\n                    tipo_final, \r\n                    punto_final, \r\n                    0.0\r\n                )\r\n                resultados.append(nuevo)\r\n            else:\r\n                resultados.append(None) # La barra no es visible en esa vista\r\n                \r\n        except Exception as e:\r\n            resultados.append(\"Error: \" + str(e))\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = resultados",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "ce6eeb9e441043c6a23e79477f811c52",
