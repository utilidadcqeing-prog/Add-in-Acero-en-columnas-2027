    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "data = IN[0] if len(IN) > 0 else None\r\nidx   = IN[1] if len(IN) > 1 else None\r\n\r\ndef safe_get(lst, i):\r\n    if not isinstance(lst, (list, tuple)):\r\n        return []  # no es lista\r\n    try:\r\n        n = int(i)\r\n    except Exception:\r\n        return []\r\n    # admite índices negativos como en Python\r\n    if -len(lst) <= n < len(lst):\r\n        return lst[n]\r\n    return []\r\n\r\nif isinstance(idx, (list, tuple)):\r\n    OUT = [safe_get(data, i) for i in idx]\r\nelse:\r\n    OUT = safe_get(data, idx)\r\n",
