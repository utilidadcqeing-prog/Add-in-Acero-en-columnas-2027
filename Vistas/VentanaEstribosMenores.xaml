<Window x:Class="practicacq.Vistas.VentanaEstribosMenores"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurador de Estribos Menores"
        Height="620" Width="560"
        MinHeight="480" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0">

    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="Estribos menores" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" />
        <TextBlock x:Name="TextoEncabezado" DockPanel.Dock="Top" Foreground="Gray" FontSize="11" Margin="0,0,0,10" />

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4">
                <Run Text="Grapa" FontWeight="SemiBold" /><Run Text=": una casilla -- una por fila (conecta la barra intermedia izquierda con la derecha) o una por columna (conecta la de arriba con la de abajo)." />
            </TextBlock>
            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8">
                <Run Text="Caja" FontWeight="SemiBold" /><Run Text=": dos casillas -- tildá una fila y una columna (a la derecha y abajo) y el cruce entre TODAS las filas y columnas tildadas para caja es una caja cada uno." />
            </TextBlock>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="12" Height="12" Fill="White" Stroke="#374151" StrokeThickness="1.5" Margin="0,0,4,0" />
                <TextBlock Text="esquina" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center" />
                <Ellipse Width="10" Height="10" Fill="#EF4444" Margin="0,0,4,0" />
                <TextBlock Text="barra intermedia" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center" />
                <Rectangle Width="14" Height="3" Fill="#22C55E" Margin="0,0,4,0" />
                <TextBlock Text="grapa" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center" />
                <Rectangle Width="12" Height="12" Fill="#3B82F6" Margin="0,0,4,0" />
                <TextBlock Text="caja" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TextoResumen" Grid.Column="0" VerticalAlignment="Center" Foreground="Gray" FontSize="11" />
            <Button Grid.Column="1" Content="Cancelar" Width="90" Height="30" Margin="0,0,8,0" Click="BotonCancelar_Click" />
            <Button Grid.Column="2" Content="Aceptar" Width="90" Height="30" Background="#1E8449" Foreground="White"
                    BorderThickness="0" FontWeight="Bold" Click="BotonAceptar_Click" />
        </Grid>

        <Border BorderBrush="#D0D0D0" BorderThickness="1" Background="White" Padding="8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="Lienzo" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
