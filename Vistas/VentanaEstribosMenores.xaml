<Window x:Class="practicacq.Vistas.VentanaEstribosMenores"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurador de Estribos Menores"
        Height="480" Width="520"
        MinHeight="360" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0">

    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="Estribos menores" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,10"
                   Text="La rejilla sale sola de las barras por cara. Clickeá una posición para alternar: vacío → grapa → caja → vacío." />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Rectangle Width="14" Height="14" Fill="#22C55E" Margin="0,0,4,0" />
            <TextBlock Text="Grapa" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center" />
            <Rectangle Width="14" Height="14" Fill="#3B82F6" Margin="0,0,4,0" />
            <TextBlock Text="Caja" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TextoResumen" Grid.Column="0" VerticalAlignment="Center" Foreground="Gray" FontSize="11" />
            <Button Grid.Column="1" Content="Cancelar" Width="90" Height="30" Margin="0,0,8,0" Click="BotonCancelar_Click" />
            <Button Grid.Column="2" Content="Aceptar" Width="90" Height="30" Background="#1E8449" Foreground="White"
                    BorderThickness="0" FontWeight="Bold" Click="BotonAceptar_Click" />
        </Grid>

        <Border BorderBrush="#D0D0D0" BorderThickness="1" Background="White" Padding="16">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                <Grid x:Name="GridRejilla" />
            </Viewbox>
        </Border>
    </DockPanel>
</Window>
