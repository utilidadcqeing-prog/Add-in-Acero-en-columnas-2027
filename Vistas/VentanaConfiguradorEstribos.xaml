<Window x:Class="practicacq.Vistas.VentanaConfiguradorEstribos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:practicacq.Vistas"
        Title="Configurador de Estribos"
        Height="780" Width="1320"
        MinHeight="680" MinWidth="1180"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Etiqueta">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>
        <Style TargetType="Border" x:Key="Panel">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <!-- Compartida entre las dos pestañas (columnas principales / columnetas, issue #33) -->
        <DataTemplate x:Key="PlantillaNodo">
            <!-- La sangría de los tramos es un margen, no espacios en el texto:
                 el mismo nodo se muestra en la lista de la izquierda (donde la
                 sangría marca el árbol) y en el panel de tramos, más angosto,
                 donde esos espacios solo hacían que la etiqueta no entrara. -->
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EsColumna}" Value="False">
                                <Setter Property="Margin" Value="14,1,0,1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <CheckBox IsChecked="{Binding Marcado, Mode=TwoWay}"
                          Checked="CheckBoxNodo_Changed" Unchecked="CheckBoxNodo_Changed"
                          VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="{Binding Etiqueta}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Etiqueta}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsColumna}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Banner de modo simulado (se oculta cuando corre contra Revit real) -->
        <Border x:Name="BannerSimulado" Grid.Row="0" Background="#FEF3C7" BorderBrush="#F59E0B"
                BorderThickness="1" Padding="8,4" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock Text="MODO DE PRUEBA — datos simulados, no hay conexión a Revit." FontWeight="Bold" Foreground="#92400E" />
        </Border>

        <!-- Barra superior -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Tilda columnas o tramos para decidir QUÉ se genera en Revit. Para cargarles una misma configuración, resáltalos en la lista (Ctrl o Shift para varios) y usa &quot;Aplicar a selección&quot;."
                       TextWrapping="Wrap" Foreground="#555555" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Grid.Column="1" x:Name="BotonLimpiarSeleccion" Content="Limpiar selección"
                    Height="30" Padding="12,0" Background="#6B7280" Foreground="White"
                    BorderThickness="0" Margin="0,0,8,0" Click="BotonLimpiarSeleccion_Click" />
            <Button Grid.Column="2" x:Name="BotonAplicarSeleccion" Content="Aplicar a selección"
                    Height="30" Padding="12,0" Background="#0B63CE" Foreground="White"
                    FontWeight="Bold" BorderThickness="0" Click="BotonAplicarSeleccion_Click" />
        </Grid>

        <!-- Cuerpo: planta/lista | tramos | elevación | configuración -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="255" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Elegir la columna: la planta ya no es un modo que tapa la
                 lista (reunión 10-sep), es la primera pestaña y queda siempre
                 a mano. La lista sigue estando para buscar por nombre y para
                 las columnetas (issue #33; esa pestaña se oculta sola si el
                 modelo no tiene ninguna). -->
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Columnas" Style="{StaticResource Etiqueta}" Margin="0,0,0,4" />

                    <TabControl x:Name="PestanasSeleccion" BorderThickness="0" Background="Transparent"
                                SelectionChanged="PestanasSeleccion_SelectionChanged">
                        <TabItem Header="Planta">
                            <local:PanelPlantaColumnas x:Name="PanelPlanta" />
                        </TabItem>
                        <TabItem Header="Lista">
                            <ListBox x:Name="ListaPrincipales" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     HorizontalContentAlignment="Stretch"
                                     SelectionMode="Extended"
                                     ItemTemplate="{StaticResource PlantillaNodo}"
                                     SelectionChanged="ListaSeleccion_SelectionChanged" />
                        </TabItem>
                        <TabItem x:Name="PestanaColumnetas" Header="Columnetas">
                            <ListBox x:Name="ListaColumnetas" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     HorizontalContentAlignment="Stretch"
                                     SelectionMode="Extended"
                                     ItemTemplate="{StaticResource PlantillaNodo}"
                                     SelectionChanged="ListaSeleccion_SelectionChanged" />
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>

            <!-- Tramos de la columna elegida (reunión 10-sep): antes solo se
                 veían en modo lista, así que en planta no había forma de
                 editar un tramo puntual. -->
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="TextoColumnaDeTramos" Text="Tramos"
                                   Style="{StaticResource Etiqueta}" Margin="0" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" x:Name="BotonTildarTodosLosTramos" Content="Todos"
                                Padding="8,1" FontSize="11" Margin="4,0,0,0" Click="BotonTildarTodosLosTramos_Click" />
                        <Button Grid.Column="2" x:Name="BotonDestildarTodosLosTramos" Content="Ninguno"
                                Padding="8,1" FontSize="11" Margin="4,0,0,0" Click="BotonDestildarTodosLosTramos_Click" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Text="Tilda los que se generan. Resalta (Ctrl o Shift) los que reciben &quot;Aplicar a selección&quot;."
                               TextWrapping="Wrap" Foreground="Gray" FontSize="10" Margin="0,6,0,0" />
                    <ListBox x:Name="ListaTramos" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch"
                             SelectionMode="Extended"
                             ItemTemplate="{StaticResource PlantillaNodo}"
                             SelectionChanged="ListaSeleccion_SelectionChanged" />
                </DockPanel>
            </Border>

            <!-- Elevación de detalle -->
            <Border Grid.Column="4" Style="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Elevación (detalle)" Style="{StaticResource Etiqueta}" Margin="0,0,0,4" />

                    <!-- Lo que LectorContexto no pudo determinar solo, o dejó como
                         constancia (zapata, sin vigas que la toquen, sección que
                         cambia entre elementos). Vacío la mayoría de las veces. -->
                    <Border x:Name="PanelAvisos" DockPanel.Dock="Top" Background="#FEF3C7" BorderBrush="#F59E0B"
                            BorderThickness="1" Padding="6,4" Margin="0,0,0,8" Visibility="Collapsed">
                        <TextBlock x:Name="TextoAvisos" TextWrapping="Wrap" FontSize="11" Foreground="#92400E" />
                    </Border>

                    <!-- Leyenda -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Rectangle Width="12" Height="12" Fill="#3B82F6" Margin="0,0,4,0" />
                        <TextBlock Text="nudo" FontSize="10" Foreground="Gray" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Rectangle Width="12" Height="12" Fill="#B45309" Margin="0,0,4,0" />
                        <TextBlock Text="contra zapata" FontSize="10" Foreground="Gray" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Rectangle Width="12" Height="12" Fill="#DCFCE7" Stroke="#22C55E" StrokeThickness="2" Margin="0,0,4,0" />
                        <TextBlock Text="tramo activo" FontSize="10" Foreground="Gray" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Rectangle Width="12" Height="12" Fill="#0B63CE" Margin="0,0,4,0" />
                        <TextBlock Text="resaltado" FontSize="10" Foreground="Gray" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Rectangle Width="12" Height="12" Margin="0,0,4,0">
                            <Rectangle.Fill>
                                <VisualBrush TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute">
                                    <VisualBrush.Visual>
                                        <Canvas Width="6" Height="6" Background="White">
                                            <Line X1="0" Y1="6" X2="6" Y2="0" Stroke="#94A3B8" StrokeThickness="1" />
                                        </Canvas>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <TextBlock Text="configurado" FontSize="10" Foreground="Gray" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Flechas verticales y pegadas entre sí, no horizontales a los costados
                         del texto: la elevación de abajo también es vertical (de piso a
                         techo), así que "siguiente" sube (▲) y "anterior" baja (▼). -->
                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="TextoTramoActivo" Text="—" HorizontalAlignment="Left"
                                   VerticalAlignment="Center" FontSize="11" />
                        <StackPanel Grid.Column="1">
                            <Button x:Name="BotonSiguiente" Content="▲" Width="26" Height="17" Padding="0"
                                    FontSize="9" Click="BotonSiguiente_Click" />
                            <Button x:Name="BotonAnterior" Content="▼" Width="26" Height="17" Padding="0"
                                    FontSize="9" Margin="0,1,0,0" Click="BotonAnterior_Click" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Canvas x:Name="CanvasElevacion" Width="310" Height="460" Background="Transparent" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Panel del tramo activo -->
            <Border Grid.Column="6" Style="{StaticResource Panel}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Configuraciones guardadas (pedido de Luciano, 10-sep):
                         elegir una CARGA el panel; de ahí sale hacia los tramos
                         con "Aplicar a selección". Se guardan dentro del modelo
                         de Revit, así que viajan con el proyecto. -->
                    <TextBlock Text="Configuración guardada:" Style="{StaticResource Etiqueta}" Margin="0,0,0,3" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" x:Name="ComboConfiguraciones" Height="24"
                                  SelectionChanged="ComboConfiguraciones_SelectionChanged" />
                        <Button Grid.Column="1" x:Name="BotonBorrarConfiguracion" Content="Borrar"
                                Height="24" Padding="8,0" Margin="6,0,0,0" Click="BotonBorrarConfiguracion_Click" />
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="CampoNombreConfiguracion" Height="24"
                                 VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" x:Name="BotonGuardarConfiguracion" Content="Guardar"
                                Height="24" Padding="8,0" Margin="6,0,0,0" Click="BotonGuardarConfiguracion_Click" />
                    </Grid>
                    <TextBlock Text="Guarda el panel entero (tramo + acero longitudinal) con un nombre."
                               TextWrapping="Wrap" Foreground="Gray" FontSize="10" Margin="0,3,0,0" />

                    <Border Height="1" Background="#E5E5E5" Margin="0,12,0,4" />

                    <TextBlock Text="Configuración del tramo activo" Style="{StaticResource Etiqueta}" Margin="0,0,0,4" />

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                        <RadioButton x:Name="RadioUniforme" Content="Uniforme" GroupName="Modo" IsChecked="True" Margin="0,0,20,0" />
                        <RadioButton x:Name="RadioConfinado" Content="Confinado" GroupName="Modo" />
                    </StackPanel>

                    <TextBlock Text="Tipo de barra:" Style="{StaticResource Etiqueta}" />
                    <ComboBox x:Name="ComboTipoBarra" Height="24" />

                    <!-- Oculto a propósito (reunión 10-sep): el gancho del
                         estribo es siempre el de 135° de estilo estribo/tirante,
                         así que se fija por defecto y no se pregunta. El combo
                         se queda en el árbol, con su valor puesto, porque es de
                         donde lo lee LeerConfigDelPanel. -->
                    <TextBlock x:Name="EtiquetaTipoGancho" Text="Tipo de gancho:" Style="{StaticResource Etiqueta}" Visibility="Collapsed" />
                    <ComboBox x:Name="ComboTipoGancho" Height="24" Visibility="Collapsed" />

                    <!-- Modo Uniforme -->
                    <StackPanel x:Name="PanelUniforme">
                        <TextBlock Text="Espaciado (m):" Style="{StaticResource Etiqueta}" />
                        <TextBox x:Name="CampoEspaciadoUniforme" Height="22" Text="0.20" />
                    </StackPanel>

                    <!-- Modo Confinado -->
                    <StackPanel x:Name="PanelConfinado" Visibility="Collapsed">
                        <TextBlock Text="Longitud de confinamiento L1 (m):" Style="{StaticResource Etiqueta}" />
                        <TextBox x:Name="CampoL1" Height="22" Text="0.50" />

                        <TextBlock Text="Espaciado confinado (m):" Style="{StaticResource Etiqueta}" />
                        <TextBox x:Name="CampoEspaciadoConfinado" Height="22" Text="0.07" />

                        <TextBlock Text="Espaciado no confinado (m):" Style="{StaticResource Etiqueta}" />
                        <TextBox x:Name="CampoEspaciadoNoConfinado" Height="22" Text="0.14" />
                        <TextBlock Text="Sugerido al doble del confinado. Si lo editas a mano, deja de recalcularse hasta que cambies de tramo."
                                   TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="TextoValidacion" TextWrapping="Wrap" Foreground="#B91C1C"
                               FontSize="11" Margin="0,10,0,0" />

                    <Border Height="1" Background="#E5E5E5" Margin="0,16,0,12" />

                    <!-- L4: acero longitudinal, es por columna entera; no cambia con el tramo activo -->
                    <TextBlock Text="Acero longitudinal (toda la columna)" Style="{StaticResource Etiqueta}" Margin="0,0,0,4" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="N. barras X:" Style="{StaticResource Etiqueta}" />
                            <ComboBox x:Name="ComboBarrasX" Height="24" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="N. barras Y:" Style="{StaticResource Etiqueta}" />
                            <ComboBox x:Name="ComboBarrasY" Height="24" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Tipo barra cara X:" Style="{StaticResource Etiqueta}" />
                    <ComboBox x:Name="ComboBarraCaraX" Height="24" />

                    <TextBlock Text="Tipo barra cara Y:" Style="{StaticResource Etiqueta}" />
                    <ComboBox x:Name="ComboBarraCaraY" Height="24" />

                    <TextBlock Text="Tipo barra esquinas:" Style="{StaticResource Etiqueta}" />
                    <ComboBox x:Name="ComboBarraEsquinas" Height="24" />

                    <TextBlock Text="Longitud de barra comercial (traslapos, Fase 5):" Style="{StaticResource Etiqueta}" />
                    <ComboBox x:Name="ComboLongitudBarra" Height="24" />

                    <!-- Igual que el del estribo: el anclaje en la zapata es
                         siempre el de 90° de estilo estándar. -->
                    <TextBlock x:Name="EtiquetaGanchoLongitudinal" Text="Gancho de anclaje en zapata:" Style="{StaticResource Etiqueta}" Visibility="Collapsed" />
                    <ComboBox x:Name="ComboGanchoLongitudinal" Height="24" Visibility="Collapsed" />

                    <Button x:Name="BotonEstribosMenores" Content="Editar estribos menores…" Height="28" Margin="0,12,0,0"
                            Click="BotonEstribosMenores_Click" />
                    <TextBlock x:Name="TextoEstribosMenores" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
              </ScrollViewer>
            </Border>
        </Grid>

        <!-- Pie -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="TextoEstado" Foreground="Gray" VerticalAlignment="Center" TextWrapping="Wrap" />
            <CheckBox Grid.Column="1" x:Name="CheckBorrarAnteriores" Content="Borrar TODO el armado existente en estas columnas (incluido el que no generó el addin)"
                      VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Grid.Column="2" x:Name="BotonGenerar" Content="Generar armado en Revit"
                    Height="32" Padding="12,0" Background="#B45309" Foreground="White"
                    FontWeight="Bold" BorderThickness="0" Click="BotonGenerar_Click" />
        </Grid>
    </Grid>
</Window>
