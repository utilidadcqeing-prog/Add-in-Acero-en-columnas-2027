<Window x:Class="practicacq.Vistas.VentanaConfiguradorEstribos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurador de Estribos"
        Height="640" Width="1040"
        MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Etiqueta">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>
        <Style TargetType="Border" x:Key="Panel">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Banner de modo simulado (se oculta cuando corre contra Revit real) -->
        <Border x:Name="BannerSimulado" Grid.Row="0" Background="#FEF3C7" BorderBrush="#F59E0B"
                BorderThickness="1" Padding="8,4" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock Text="MODO DE PRUEBA — datos simulados, no hay conexión a Revit." FontWeight="Bold" Foreground="#92400E" />
        </Border>

        <!-- Barra superior -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Tildá columnas o tramos sueltos en la lista y usá &quot;Aplicar a selección&quot; para cargarles la misma configuración."
                       TextWrapping="Wrap" Foreground="#555555" VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="BotonAplicarSeleccion" Content="Aplicar a selección"
                    Height="30" Padding="12,0" Background="#0B63CE" Foreground="White"
                    FontWeight="Bold" BorderThickness="0" Click="BotonAplicarSeleccion_Click" />
        </Grid>

        <!-- Cuerpo: lista | elevación | panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Selección: columnas y tramos -->
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Columnas y tramos" Style="{StaticResource Etiqueta}" Margin="0,0,0,4" />
                    <ListBox x:Name="ListaSeleccion" BorderThickness="0"
                             SelectionChanged="ListaSeleccion_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <CheckBox IsChecked="{Binding Marcado, Mode=TwoWay}"
                                              Checked="CheckBoxNodo_Changed" Unchecked="CheckBoxNodo_Changed"
                                              VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding Etiqueta}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EsColumna}" Value="True">
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Elevación de detalle -->
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Elevación (detalle)" Style="{StaticResource Etiqueta}" Margin="0,0,0,4" />

                    <!-- Leyenda -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Rectangle Width="12" Height="12" Fill="#3B82F6" Margin="0,0,4,0" />
                        <TextBlock Text="nudo" FontSize="10" Foreground="Gray" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Rectangle Width="12" Height="12" Fill="#B45309" Margin="0,0,4,0" />
                        <TextBlock Text="contra zapata" FontSize="10" Foreground="Gray" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Rectangle Width="12" Height="12" Fill="#DCFCE7" Stroke="#22C55E" StrokeThickness="2" Margin="0,0,4,0" />
                        <TextBlock Text="tramo activo" FontSize="10" Foreground="Gray" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Rectangle Width="12" Height="12" Margin="0,0,4,0">
                            <Rectangle.Fill>
                                <VisualBrush TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute">
                                    <VisualBrush.Visual>
                                        <Canvas Width="6" Height="6" Background="White">
                                            <Line X1="0" Y1="6" X2="6" Y2="0" Stroke="#94A3B8" StrokeThickness="1" />
                                        </Canvas>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <TextBlock Text="configurado" FontSize="10" Foreground="Gray" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="BotonAnterior" Content="◀" Width="28" Click="BotonAnterior_Click" />
                        <TextBlock Grid.Column="1" x:Name="TextoTramoActivo" Text="—" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="11" />
                        <Button Grid.Column="2" x:Name="BotonSiguiente" Content="▶" Width="28" Click="BotonSiguiente_Click" />
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Canvas x:Name="CanvasElevacion" Width="310" Height="460" Background="Transparent" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Panel del tramo activo -->
            <Border Grid.Column="4" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Configuración del tramo activo" Style="{StaticResource Etiqueta}" Margin="0,0,0,4" />

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                        <RadioButton x:Name="RadioUniforme" Content="Uniforme" GroupName="Modo" IsChecked="True" Margin="0,0,20,0" />
                        <RadioButton x:Name="RadioConfinado" Content="Confinado" GroupName="Modo" />
                    </StackPanel>

                    <TextBlock Text="Tipo de barra:" Style="{StaticResource Etiqueta}" />
                    <ComboBox x:Name="ComboTipoBarra" Height="24" />

                    <TextBlock Text="Tipo de gancho:" Style="{StaticResource Etiqueta}" />
                    <ComboBox x:Name="ComboTipoGancho" Height="24" />

                    <!-- Modo Uniforme -->
                    <StackPanel x:Name="PanelUniforme">
                        <TextBlock Text="Espaciado (m):" Style="{StaticResource Etiqueta}" />
                        <TextBox x:Name="CampoEspaciadoUniforme" Height="22" Text="0.20" />
                    </StackPanel>

                    <!-- Modo Confinado -->
                    <StackPanel x:Name="PanelConfinado" Visibility="Collapsed">
                        <TextBlock Text="Longitud de confinamiento L1 (m):" Style="{StaticResource Etiqueta}" />
                        <TextBox x:Name="CampoL1" Height="22" Text="0.50" />

                        <TextBlock Text="Espaciado confinado (m):" Style="{StaticResource Etiqueta}" />
                        <TextBox x:Name="CampoEspaciadoConfinado" Height="22" Text="0.07" />

                        <TextBlock Text="Espaciado no confinado (m):" Style="{StaticResource Etiqueta}" />
                        <TextBox x:Name="CampoEspaciadoNoConfinado" Height="22" Text="0.14" />
                        <TextBlock Text="Sugerido al doble del confinado — se puede editar."
                                   TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="TextoValidacion" TextWrapping="Wrap" Foreground="#B91C1C"
                               FontSize="11" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Pie -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="TextoEstado" Foreground="Gray" VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="BotonExportar" Content="Exportar PlanArmado (JSON)"
                    Height="32" Padding="12,0" Background="#1E8449" Foreground="White"
                    FontWeight="Bold" BorderThickness="0" Click="BotonExportar_Click" />
        </Grid>
    </Grid>
</Window>
