<Window x:Class="CQEING.Gestor.VentanaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CQEING.Gestor"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:VistaGestor}"
        Title="Gestor de add-ins CQEING" Width="620" Height="720" MinWidth="480" MinHeight="460"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Fondo}"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Texto}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding BuscarNovedades}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- Encabezado -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borde}" BorderThickness="0,0,0,1"
                Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Add-ins de CQEING" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TextoRevision}" Foreground="{StaticResource TextoSuave}" FontSize="12" Margin="0,2,0,0"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource BotonSecundario}" Command="{Binding BuscarNovedades}"
                        ToolTip="Consultar las versiones publicadas (F5)" AutomationProperties.Name="Buscar novedades">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Iconos}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Buscar novedades" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="2" BorderThickness="0" Background="Transparent"
                     Foreground="{StaticResource Acento}" Visibility="{Binding Buscando, Converter={StaticResource BoolAVisible}}"
                     AutomationProperties.Name="Buscando novedades"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="24,16,24,16">

                <!-- Aviso del gestor nuevo (franja azul) -->
                <Border Background="{StaticResource AcentoClaro}" BorderBrush="{StaticResource AcentoBorde}" BorderThickness="1" CornerRadius="8"
                        Padding="14,10" Margin="0,0,0,12" Visibility="{Binding MostrarAvisoGestor, Converter={StaticResource BoolAVisible}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource Iconos}" FontSize="16" Foreground="{StaticResource Acento}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding TextoAvisoGestor}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <Button Grid.Column="2" Style="{StaticResource BotonPrincipal}" Content="Actualizar y reiniciar" Margin="12,0,4,0"
                                Command="{Binding ActualizarGestor}"/>
                        <Button Grid.Column="3" Style="{StaticResource BotonPlano}" Command="{Binding CerrarAvisoGestor}"
                                ToolTip="Ahora no" AutomationProperties.Name="Cerrar el aviso del gestor nuevo">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource Iconos}" FontSize="11"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Aviso general: gris (lista guardada) o rojo (error) -->
                <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,12" BorderThickness="1"
                        Visibility="{Binding HayAviso, Converter={StaticResource BoolAVisible}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource GrisFondo}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AvisoEsError}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ErrorFondo}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource ErrorBorde}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontFamily="{StaticResource Iconos}" FontSize="16" Margin="0,1,10,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE946;"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AvisoEsError}" Value="True">
                                            <Setter Property="Text" Value="&#xE783;"/>
                                            <Setter Property="Foreground" Value="{StaticResource ErrorTexto}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding Aviso}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                    </Grid>
                </Border>

                <!-- Año de Revit y resumen -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding Anios}" SelectedItem="{Binding AnioElegido}" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource PastillaAnio}" AutomationProperties.Name="Año de Revit"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding HayVariosAnios, Converter={StaticResource BoolAVisible}}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Etiqueta}" FontWeight="SemiBold"/>
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Acento}" Margin="7,1,0,0" VerticalAlignment="Center"
                                             ToolTip="Hay novedades" Visibility="{Binding TieneNovedades, Converter={StaticResource BoolAVisible}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding AnioElegido.Etiqueta}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                               Visibility="{Binding HayUnAnio, Converter={StaticResource BoolAVisible}}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TextoResumen}" Foreground="{StaticResource TextoSuave}" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <Button Style="{StaticResource BotonPlano}" Foreground="{StaticResource Acento}" Content="Actualizar todas" Margin="8,0,0,0"
                                Command="{Binding ActualizarTodas}" Visibility="{Binding PuedeActualizarTodas, Converter={StaticResource BoolAVisible}}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding TextoVacio}" Foreground="{StaticResource TextoSuave}" FontSize="14" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,48,0,0"
                           Visibility="{Binding HayTextoVacio, Converter={StaticResource BoolAVisible}}"/>

                <!-- Una tarjeta por add-in -->
                <ItemsControl ItemsSource="{Binding Tarjetas}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:TarjetaAddin}">
                            <Border Style="{StaticResource Tarjeta}" AutomationProperties.Name="{Binding Nombre}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="44" Height="44" CornerRadius="10" Background="{Binding ColorIcono}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Iniciales}" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                        <WrapPanel>
                                            <TextBlock Text="{Binding Nombre}" FontSize="15" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource Insignia}" Visibility="{Binding HayNuevaVersion, Converter={StaticResource BoolAVisible}}">
                                                <TextBlock Text="{Binding Estado.NuevaVersion}" Foreground="{StaticResource Acento}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Descripcion}" Foreground="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding Estado.TextoInstalada}" FontSize="12" Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding Estado.Nota}" ToolTip="{Binding Estado.Nota}" FontSize="12" Foreground="{StaticResource TextoSuave}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                   Visibility="{Binding HayNota, Converter={StaticResource BoolAVisible}}"/>

                                        <Grid Margin="0,10,0,0" Visibility="{Binding Descargando, Converter={StaticResource BoolAVisible}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Style="{StaticResource BarraProgreso}" Value="{Binding Progreso, Mode=OneWay}" Maximum="100"
                                                         VerticalAlignment="Center" AutomationProperties.Name="Progreso de la descarga"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TextoProgreso}" FontSize="12" Foreground="{StaticResource TextoSuave}"
                                                       Margin="10,0,0,0" MinWidth="36" TextAlignment="Right"/>
                                        </Grid>

                                        <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"
                                                   AutomationProperties.LiveSetting="Assertive"
                                                   Visibility="{Binding HayMensaje, Converter={StaticResource BoolAVisible}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Exito}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MensajeEsError}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorTexto}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Style="{StaticResource BotonPrincipal}" Content="{Binding Estado.TextoBoton}" Command="{Binding Principal}"
                                                AutomationProperties.Name="{Binding NombreAccesibleBoton}"
                                                Visibility="{Binding MostrarBoton, Converter={StaticResource BoolAVisible}}"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0"
                                                    Visibility="{Binding EsAlDia, Converter={StaticResource BoolAVisible}}">
                                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Iconos}" Foreground="{StaticResource Exito}" FontSize="13"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Al día" Foreground="{StaticResource Exito}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Style="{StaticResource BotonPlano}" Margin="4,0,0,0" Click="AbrirVersiones_Click" MinWidth="34"
                                                ToolTip="Versiones publicadas" AutomationProperties.Name="{Binding NombreAccesibleVersiones}">
                                            <TextBlock Text="&#xE712;" FontFamily="{StaticResource Iconos}" FontSize="14"/>
                                            <Button.ContextMenu>
                                                <ContextMenu ItemsSource="{Binding Versiones}">
                                                    <ContextMenu.ItemContainerStyle>
                                                        <Style TargetType="MenuItem">
                                                            <Setter Property="Command" Value="{Binding Usar}"/>
                                                            <Setter Property="Padding" Value="6,6"/>
                                                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                                            <Setter Property="AutomationProperties.Name" Value="{Binding NombreAccesible}"/>
                                                        </Style>
                                                    </ContextMenu.ItemContainerStyle>
                                                    <ContextMenu.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type local:OpcionVersion}">
                                                            <Grid MinWidth="300">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Version, StringFormat=Versión {0}}" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="  ·  En este equipo" Foreground="{StaticResource TextoSuave}"
                                                                                   Visibility="{Binding EnEsteEquipo, Converter={StaticResource BoolAVisible}}"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Fecha, StringFormat=Publicada el {0}}" FontSize="11"
                                                                               Foreground="{StaticResource TextoSuave}"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding TextoAccion}" Margin="24,0,0,0" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource Acento}" FontWeight="SemiBold"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ContextMenu.ItemTemplate>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
